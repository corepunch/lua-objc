<VStack id="task/<%= id %>" key="task<%= id %>" spacing="0" maxWidth="infinity" alignment="leading">
	<HStack paddingVertical="9" spacing="12" maxWidth="infinity" alignment="center">
		<Button title="" systemImage="<%= done and 'checkmark.circle.fill' or 'circle' %>" symbolSize="21" style="plain" tint="<%= done and color or 'tertiary' %>" action="toggle_<%= id %>" accessibilityLabel="<%= done and 'Mark as not done' or 'Mark as done' %>" />
		<VStack spacing="2" alignment="leading" flexGrow="1">
			<Label text="<%= title %>" size="15" color="<%= done and 'secondary' or 'label' %>" />
			<HStack spacing="5" alignment="center">
				<SystemImage name="<%= symbol %>" size="10" color="<%= color %>" />
				<Label text="<%= project %><%= due and ('  ·  ' .. due) or '' %>" size="12" color="secondary" />
			</HStack>
		</VStack>
		<% if flagged then -%>
		<SystemImage name="flag.fill" size="13" color="systemOrange" label="Flagged" />
		<% end -%>
	</HStack>
	<Divider />
</VStack>
