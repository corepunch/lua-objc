<Window title="Tasks" width="1040" height="700" minWidth="720" minHeight="520" sidebarWidth="230">
	<Toolbar>
		<ToolbarItem id="toggleSidebar" />
		<ToolbarSpacer />
		<ToolbarItem id="newTask" label="New Task" icon="plus" tooltip="Add a task" />
	</Toolbar>
	<VStack id="content" maxWidth="infinity" maxHeight="infinity" />
</Window>
