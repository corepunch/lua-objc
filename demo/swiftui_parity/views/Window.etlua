<Window title="SwiftUI parity" width="480" height="160" minWidth="320" minHeight="120">
	<% if caseId == "text.single.default" then %>
	<VStack padding="24" spacing="12" maxWidth="infinity">
	<Label text="<%= body %>" size="24" id="text.node" />
	</VStack>
	<% elseif caseId == "stack.h.spacing.default-text-spacer" then %>
	<HStack padding="24" spacing="12" maxWidth="infinity" alignment="center">
		<Label text="<%= left %>" id="left" />
		<Spacer />
		<Label text="<%= right %>" id="right" />
	</HStack>
	<% elseif caseId == "button.standard.action-counter" then %>
	<VStack padding="24" spacing="12" alignment="center">
		<Button title="<%= buttonTitle %>" action="activate" id="button" />
		<Label text="Count: 0" id="counter" />
	</VStack>
	<% elseif caseId == "surface.background-rounded" then %>
	<VStack padding="24" spacing="12" maxWidth="infinity" background="systemGreen" cornerRadius="16" clipsToBounds="true">
		<Label text="<%= body %>" size="20" id="surface" />
	</VStack>
	<% elseif caseId == "grid.two-by-two" then %>
	<Grid padding="24" spacing="12" alignment="center" maxWidth="infinity">
		<GridRow spacing="24"><Label text="<%= cells[1] %>" id="A1" /><Label text="<%= cells[2] %>" id="B1" /></GridRow>
		<GridRow spacing="24"><Label text="<%= cells[3] %>" id="A2" /><Label text="<%= cells[4] %>" id="B2" /></GridRow>
	</Grid>
	<% elseif caseId == "text.long-ellipsis-italic" then %>
	<VStack padding="24" maxWidth="infinity" alignment="center">
		<Label text="<%= body %>" size="18" italic="true" alignment="center" lines="1" truncation="tail" id="styled" />
	</VStack>
	<% elseif caseId == "image.system-icon" then %>
	<VStack padding="24" spacing="12" maxWidth="infinity" alignment="center">
		<SystemImage name="<%= name %>" size="32" color="accent" label="<%= label %>" id="icon" />
		<Label text="<%= label %>" />
	</VStack>
	<% elseif caseId == "padding.vertical-edges" then %>
	<VStack paddingTop="8" paddingBottom="40" maxWidth="infinity" alignment="center" background="systemGreen" cornerRadius="12">
		<Label text="<%= body %>" id="padded" />
	</VStack>
	<% elseif caseId == "container.section-groupbox" then %>
	<VStack padding="16" spacing="12" maxWidth="infinity">
		<Section header="Overview" id="section">
			<Label text="<%= body %>" />
		</Section>
		<GroupBox header="Details" background="systemGreen" cornerRadius="12" id="groupbox">
			<Label text="Grouped native content" />
		</GroupBox>
	</VStack>
	<% elseif caseId == "container.disclosure-expanded" then %>
	<VStack padding="16" maxWidth="infinity">
		<DisclosureGroup label="Advanced" expanded="true">
			<Label text="<%= body %>" id="content" />
		</DisclosureGroup>
	</VStack>
	<% elseif caseId == "container.form-labeled-control-group" then %>
	<Form padding="16" spacing="12" maxWidth="infinity">
		<LabeledContent label="Name" spacing="12">
			<Label text="<%= body %>" />
		</LabeledContent>
		<ControlGroup spacing="8">
			<Button title="Cancel" />
			<Button title="Save" />
		</ControlGroup>
	</Form>
	<% elseif caseId == "input.native-editor-picker-search" then %>
	<VStack padding="16" spacing="10" maxWidth="infinity" alignment="leading">
		<SearchField value="<%= search %>" placeholder="Search" />
		<Picker value="1">
			<Option title="<%= options[1] %>" />
			<Option title="<%= options[2] %>" />
			<Option title="<%= options[3] %>" />
		</Picker>
		<TextEditor text="<%= text %>" height="72" />
	</VStack>
	<% elseif caseId == "input.date-and-color-pickers" then %>
	<VStack padding="16" spacing="12" maxWidth="infinity" alignment="leading">
		<DatePicker timestamp="<%= timestamp %>" />
		<ColorPicker color="<%= color %>" />
	</VStack>
	<% else %>
	<Label text="Unknown parity case" />
	<% end %>
</Window>
