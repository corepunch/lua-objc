<VStack spacing="@pageSpacing" padding="@pagePadding" alignment="leading" maxWidth="infinity">
	<Toggle label="Keep cleanup history" value="<%= history %>" onChange="setHistory" />
	<TextField placeholder="Device name" value="<%= deviceName %>" width="@meterWidth" onChange="setDeviceName" />
	<Picker value="<%= threshold %>" onChange="setThreshold">
	<% for _, title in ipairs(thresholds) do %>
		<Option title="<%= title %>" />
	<% end %>
	</Picker>
	<Label text="<%= note %>" color="secondary" />
	<% if errors then %>
	<Label id="error" text="<%= errors[1] %>" color="systemRed" />
	<% end %>
</VStack>
