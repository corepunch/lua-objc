<VStack spacing="@pageSpacing" padding="@pagePadding" alignment="leading" maxWidth="infinity" maxHeight="infinity">
	<HStack alignment="center" spacing="@pageSpacing">
		<Label text="<%= summary %>" color="secondary" />
		<Spacer />
		<Button title="Scan Again" action="rescan" />
	</HStack>
	<List id="folders" style="fullWidth" header="false" rowHeight="@rowHeight" maxWidth="infinity" height="@listHeight">
		<Column id="name" title="Name" minWidth="120" imageKey="icon" />
		<Column id="share" title="Size" width="@meterWidth" levelKey="relative" valueKey="size" loadingKey="calculating" imageKey="sizeIcon" imageColorKey="sizeColor" />
	</List>
</VStack>
