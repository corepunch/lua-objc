<% --[[
  The window every manifest app gets: a Go menu with one item per page (the
  keys come from the manifest), a sidebar toggle, the manifest's toolbar
  items and the content area the generic page controller mounts pages into.
  `--isolated`, and an app of one page, leave out the menu, the sidebar and
  the page title. The sidebar itself is Sidebar.etlua. On iPhone there is
  no sidebar or menu: the page sits in a navigation stack titled by it, as a
  SwiftUI page sits in NavigationStack, with the toolbar items in its bar;
  an untitled page without items hides the bar. A page's
  `navigationTitle` and `navigationSubtitle` go to the title bar: the
  window's title and subtitle on macOS, the navigation bar on iPhone. The
  manifest's `background` fills behind the iPhone keyboard, where the page
  ends; the page itself keeps the system background. A page
  view never makes its own stack (a navigation controller cannot be placed
  inside a stack). ]] %>
<% local heading = page.attrs.navigationTitle or (isolated and "" or page.title) %>
<% local subheading = page.attrs.navigationSubtitle or "" %>
<% local function items() %>
  <% for _, item in ipairs(app.toolbar) do %>
  <ToolbarItem id="<%= item.id %>" label="<%= item.label or "" %>" icon="<%= item.icon or "" %>" tooltip="<%= item.label or "" %>" placement="<%= item.placement or "automatic" %>" action="tool_<%= item.action %>" validate="canTool_<%= item.action %>" />
  <% end %>
<% end %>
<Window title="<%= page.attrs.navigationTitle or app.name %>" subtitle="<%= subheading %>"<% if page.attrs.navigationTitle then %> hideTitle="false"<% end %> width="1100" height="720" minWidth="700" minHeight="440" sidebarWidth="226">
  <% if not isolated and platform ~= "UIKit" then %>
  <Commands appName="<%= app.name %>">
    <CommandMenu title="Go">
      <% for index, section in ipairs(app.sections) do %>
      <% if index > 1 then %><Separator /><% end %>
      <% for _, page in ipairs(section.pages) do %>
      <MenuItem title="<%= page.title %>" systemImage="<%= page.icon or "" %>" keyEquivalent="<%= page.key or "" %>" action="page_<%= page.id %>" validate="isPage_<%= page.id %>" />
      <% end %>
      <% end %>
    </CommandMenu>
  </Commands>
  <% end %>
  <% if platform ~= "UIKit" and (not isolated or #app.toolbar > 0) then %>
  <Toolbar>
    <% if not isolated then %>
    <ToolbarItem id="toggleSidebar" />
    <% end %>
    <% if #app.toolbar > 0 then %>
    <ToolbarSpacer />
    <% items() %>
    <% end %>
  </Toolbar>
  <% end %>
  <% if platform == "UIKit" then %>
  <NavigationStack title="<%= heading %>" subtitle="<%= subheading %>"<% if app.background then %> background="<%= app.background %>"<% end %> largeTitle="<%= not isolated %>" hidesNavigationBar="<%= heading == "" and #app.toolbar == 0 %>">
    <% if #app.toolbar > 0 then %>
    <Toolbar>
      <% items() %>
    </Toolbar>
    <% end %>
    <VStack id="content" maxWidth="infinity" maxHeight="infinity"<% if app.background then %> background="background"<% end %> />
  </NavigationStack>
  <% else %>
  <VStack id="content" maxWidth="infinity" maxHeight="infinity" />
  <% end %>
</Window>
