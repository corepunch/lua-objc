<!-- Coin Quest's coin prefab, unchanged, in a reel SceneView. -->
<Reel width="64" height="48" fps="30" duration="2" background="#000000" subframes="1">
  <SceneView>
    <Camera position="0 0.4 2" lookAt="0 0.4 0" fieldOfView="40" />
    <Light type="ambient" intensity="1200" />
    <%- partial(root .. "apps/coin-quest/views/prefabs/Coin.etlua", {id = "coin", x = 0, z = 0, assets = root .. "apps/coin-quest/assets/models/"}) %>
  </SceneView>
</Reel>
