<VStack spacing="8">
  <ActivityRings id="rings" width="100" height="100">
    <% for _, value in ipairs(rings) do -%>
    <ActivityRing value="<%= value %>" goal="10" color="systemRed" />
    <% end -%>
  </ActivityRings>
  <CapacityBar id="bar" total="<%= total %>" accessibilityLabel="<%= used %> of <%= total %>">
    <CapacitySegment value="<%= used %>" color="systemBlue" />
  </CapacityBar>
</VStack>
