<NavigationStack title="<%= title %>" enablePrivateNavigationPalettes="true">
  <VStack padding="16" spacing="12">
    <Label text="<%= message %>" />
    <Label text="Private palettes are enabled for this example." />
  </VStack>
  <TopPalette>
    <HStack spacing="12" alignment="center" fillWidth="true" paddingHorizontal="16">
      <Label text="Top palette" />
      <Label text="Featured" />
    </HStack>
  </TopPalette>
  <BottomPalette>
    <HStack spacing="12" alignment="center" fillWidth="true" paddingHorizontal="16">
      <Label text="For You" />
      <Label text="Following" />
    </HStack>
  </BottomPalette>
</NavigationStack>
