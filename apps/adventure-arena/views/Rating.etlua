<HStack spacing="20" alignment="center">
  <VStack spacing="4" alignment="center">
    <Label text="<%= string.format('%.1f', game.rating) %>" size="52" weight="bold" />
    <Label text="out of 5" size="12" color="secondary" />
  </VStack>
  <VStack maxWidth="infinity" spacing="4" alignment="leading">
    <% for star = 5, 1, -1 do %>
    <% local fill = math.max(0, math.min(1, 1 - math.abs(star - game.rating) / 4)) %>
    <HStack spacing="6" alignment="center">
      <Label text="<%= star %>" size="11" color="secondary" width="10" />
      <ProgressView value="<%= fill %>" tint="primary" height="4" flexGrow="1" />
    </HStack>
    <% end %>
    <Label text="<%= game.reviewCount %> Ratings" size="12" color="secondary" />
  </VStack>
</HStack>
