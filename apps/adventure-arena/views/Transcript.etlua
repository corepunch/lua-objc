<%
  -- A storybook page. Each new room opens a chapter whose first letter is an
  -- illuminated initial in the typeface and colour of the game; the player
  -- commands sit on the right like sent messages, and the story answers as
  -- ordinary prose. `reading` carries the font, size and colours chosen by the reader.
  local size = reading.fontSize
  local PAGE = { side = 20, top = 20, bottom = 16, spacing = 18,
    initialScale = 3.4, initialSpacing = 4, bubbleRadius = 18 }
%>
<VStack paddingHorizontal="<%= PAGE.side %>" paddingTop="<%= PAGE.top %>" paddingBottom="<%= PAGE.bottom %>" spacing="<%= PAGE.spacing %>" alignment="leading" maxWidth="infinity">
  <% if earlierEntries == 0 then %>
  <VStack id="titlePage" spacing="8" alignment="center" maxWidth="infinity" paddingBottom="8">
    <Label id="gameTitle" text="<%= gameTitle %>" size="<%= size + 13 %>" fontName="<%= initialFont or '' %>" design="serif" weight="bold" color="<%= tint %>" alignment="center" lines="0" />
    <% if gameAuthor ~= "" then %>
    <Label text="<%= gameAuthor %><%= gameYear ~= '' and (' · ' .. gameYear) or '' %>" size="<%= size - 3 %>" design="<%= reading.font %>" color="<%= reading.secondary %>" alignment="center" />
    <% end %>
    <% if gameDescription ~= "" then %>
    <Label id="gameDescription" text="<%= gameDescription %>" size="<%= size - 1 %>" design="<%= reading.font %>" italic="true" color="<%= reading.secondary %>" alignment="center" lines="0" />
    <% end %>
  </VStack>
  <% end %>
  <% for index, entry in ipairs(entries) do %>
  <% if entry.kind == "banner" then %>
  <VStack id="entry_<%= index %>" spacing="2" alignment="center" maxWidth="infinity">
    <% if entry.title:lower() ~= gameTitle:lower() then %>
    <Label text="<%= entry.title %>" size="<%= size - 2 %>" weight="semibold" design="serif" color="<%= reading.secondary %>" alignment="center" lines="0" />
    <% end %>
    <% for _, line in ipairs(entry.lines) do %>
    <Label text="<%= line %>" size="<%= size - 6 %>" design="serif" color="<%= reading.secondary %>" alignment="center" lines="0" />
    <% end %>
  </VStack>
  <% elseif entry.kind == "scene" then %>
  <VStack id="entry_<%= index %>" spacing="10" alignment="leading" maxWidth="infinity" paddingTop="10">
    <Label text="<%= entry.chapterLabel:upper() %>" size="12" weight="semibold" color="<%= tint %>" />
    <Label id="sceneTitle_<%= index %>" text="<%= entry.title %>" size="<%= size + 5 %>" weight="bold" design="serif" color="<%= reading.primary %>" lines="0" />
    <% if entry.initial then %>
    <HStack spacing="<%= PAGE.initialSpacing %>" alignment="top" maxWidth="infinity">
      <Label id="initial_<%= index %>" text="<%= entry.initial %>" size="<%= math.floor(size * PAGE.initialScale) %>" fontName="<%= initialFont or '' %>" design="serif" weight="bold" color="<%= tint %>" accessibilityLabel="<%= entry.initial %>" />
      <Label id="lead_<%= index %>" text="<%= entry.lead %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lines="0" flexGrow="1" />
    </HStack>
    <% end %>
    <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
    <Label id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lines="0" />
    <% end %>
  </VStack>
  <% elseif entry.kind == "command" then %>
  <HStack id="entry_<%= index %>" maxWidth="infinity">
    <Spacer />
    <HStack paddingHorizontal="14" paddingVertical="8" background="<%= tint %>" cornerRadius="<%= PAGE.bubbleRadius %>" clipsToBounds="true">
      <Label id="command_<%= index %>" text="<%= entry.text %>" size="<%= size %>" design="<%= reading.font %>" color="white" lines="0" accessibilityLabel="You: <%= entry.text %>" />
    </HStack>
  </HStack>
  <% else %>
  <VStack id="entry_<%= index %>" spacing="10" alignment="leading" maxWidth="infinity">
    <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
    <Label id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lines="0" />
    <% end %>
  </VStack>
  <% end %>
  <% end %>
</VStack>
