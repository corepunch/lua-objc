<%
  -- The story as a printed book, not a conversation.
  --  · A title page: the author in small capitals, the title in the story’s
  --    own face and colour, a fleuron, and the tagline as an epigraph.
  --  · The Infocom banner becomes the colophon, small and centred.
  --  · Each new room opens a scene: the room as its title and, when the
  --    story gives the room an ICON, its picture beside the first lines, as
  --    Zork Zero set one beside each room description.
  --  · What the reader does is set in small capitals in the story’s colour,
  --    like a stage direction; the story answers in ordinary prose. Nothing
  --    is a bubble: the page is one continuous column of type.
  --  · Words the reader can act on carry a thicker dotted rule in the story’s colour
  --    and open a menu of what can be done with them. `linkMenus` holds the
  --    live links of each paragraph, keyed like `reveal`.
  -- `reading` carries the reader’s face, size, leading, alignment and inks.
  -- `reveal` holds the characters shown of paragraphs still typing, keyed
  -- "entry_paragraph"; they, and entries in `reveal.waiting`, wait hidden
  -- until typing reaches them.
  local size, lead = reading.fontSize, reading.lineSpacing
  local PAGE = {
    side = 24, top = 28, bottom = 24,
    paragraph = math.floor(size * 0.75), scene = math.floor(size * 1.3),
    command = math.floor(size * 1.3), afterCommand = math.floor(size * 0.45),
    iconLines = 3,
  }
  local hyphenate = reading.alignment == "justified" and "true" or "false"
  reveal = reveal or { waiting = {} }
  linkMenus = linkMenus or {}
  local function revealed(index, paragraphIndex)
    local shown = reveal[index .. "_" .. paragraphIndex]
    return string.format('revealedCharacters="%d" hidden="%s"', shown or -1, shown == 0 and "true" or "false")
  end
  local function waiting(index)
    return string.format('hidden="%s"', reveal.waiting[tostring(index)] and "true" or "false")
  end
%>
<VStack paddingHorizontal="<%= PAGE.side %>" paddingTop="<%= PAGE.top %>" paddingBottom="<%= PAGE.bottom %>" spacing="0" alignment="leading" maxWidth="infinity">
  <% if earlierEntries == 0 then %>
  <VStack id="titlePage" spacing="10" alignment="center" maxWidth="infinity" paddingTop="12" paddingBottom="<%= PAGE.scene - PAGE.paragraph %>">
    <% if gameAuthor ~= "" then %>
    <Label id="gameAuthor" text="<%= gameAuthor %>" size="<%= size - 3 %>" design="serif" smallCaps="true" color="<%= reading.secondary %>" alignment="center" />
    <% end %>
    <Label id="gameTitle" text="<%= gameTitle %>" size="<%= size + 18 %>" fontName="<%= titleFont or '' %>" design="serif" weight="bold" color="<%= ink %>" alignment="center" lines="0" />
    <Label id="fleuron" text="❦" size="<%= size + 2 %>" design="serif" color="<%= ink %>" alignment="center" accessibilityLabel="" />
    <% if gameDescription ~= "" then %>
    <Paragraph id="gameDescription" text="<%= gameDescription %>" size="<%= size - 1 %>" design="serif" italic="true" color="<%= reading.secondary %>" alignment="center" lineSpacing="<%= lead %>" />
    <% end %>
  </VStack>
  <% end %>
  <% for index, entry in ipairs(entries) do %>
  <% if entry.kind == "banner" then %>
  <VStack id="entry_<%= index %>" spacing="2" alignment="center" maxWidth="infinity" paddingTop="<%= PAGE.paragraph %>" paddingBottom="<%= PAGE.paragraph %>">
    <% if entry.title:lower() ~= gameTitle:lower() then %>
    <Label text="<%= entry.title %>" size="<%= size - 3 %>" design="serif" smallCaps="true" color="<%= reading.secondary %>" alignment="center" lines="0" />
    <% end %>
    <% for _, line in ipairs(entry.lines) do %>
    <Label text="<%= line %>" size="<%= size - 6 %>" design="serif" color="<%= reading.secondary %>" alignment="center" lines="0" />
    <% end %>
  </VStack>
  <% elseif entry.kind == "scene" then %>
  <VStack id="entry_<%= index %>" spacing="0" alignment="leading" maxWidth="infinity" paddingTop="<%= (index == 1 and earlierEntries == 0) and 0 or PAGE.scene %>" <%- waiting(index) %>>
    <VStack paddingBottom="<%= PAGE.paragraph + 2 %>" alignment="leading" maxWidth="infinity">
      <Label id="sceneTitle_<%= index %>" text="<%= entry.title %>" size="<%= size + 9 %>" design="serif" weight="semibold" color="<%= reading.primary %>" lines="0" />
    </VStack>
    <VStack spacing="<%= PAGE.paragraph %>" alignment="leading" maxWidth="infinity">
      <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
      <Paragraph id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lineSpacing="<%= lead %>" alignment="<%= reading.alignment %>" hyphenation="<%= hyphenate %>"<% if entry.icon and paragraphIndex == 1 then %> figure="<%= entry.icon %>" figureLines="<%= PAGE.iconLines %>"<% end %> linkColor="<%= ink %>" <%- revealed(index, paragraphIndex) %>>
        <%- partial("ProseLinks.etlua", { links = linkMenus[index .. "_" .. paragraphIndex] }) %>
      </Paragraph>
      <% end %>
    </VStack>
  </VStack>
  <% elseif entry.kind == "command" then %>
  <VStack id="entry_<%= index %>" paddingTop="<%= PAGE.command %>" alignment="leading" maxWidth="infinity">
    <Label id="command_<%= index %>" text="<%= entry.text %>" size="<%= size - 1 %>" design="serif" weight="semibold" smallCaps="true" color="<%= ink %>" lines="0" accessibilityLabel="You: <%= entry.text %>" />
  </VStack>
  <% else %>
  <VStack id="entry_<%= index %>" spacing="<%= PAGE.paragraph %>" alignment="leading" maxWidth="infinity" paddingTop="<%= (entries[index - 1] and entries[index - 1].kind == 'command') and PAGE.afterCommand or PAGE.paragraph %>" <%- waiting(index) %>>
    <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
    <Paragraph id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lineSpacing="<%= lead %>" alignment="<%= reading.alignment %>" hyphenation="<%= hyphenate %>" linkColor="<%= ink %>" <%- revealed(index, paragraphIndex) %>>
      <%- partial("ProseLinks.etlua", { links = linkMenus[index .. "_" .. paragraphIndex] }) %>
    </Paragraph>
    <% end %>
  </VStack>
  <% end %>
  <% end %>
</VStack>
