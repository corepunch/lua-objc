<GlassEffect id="compassControl" style="regular" cornerRadius="36" width="72" height="72" onDrag="compassDrag">
  <ZStack maxWidth="infinity" maxHeight="infinity" alignment="center">
    <Image id="compassImage" path="apps/adventure-arena/assets/compass.png" resizable="true" contentMode="fit" width="42" height="42" />
  </ZStack>
</GlassEffect>
