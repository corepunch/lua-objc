<%
  -- Two tiles per row on iPhone; FlowStack adds more columns on wider screens.
  local TILE = { width = 168, height = 76, cornerRadius = 14 }
%>
<FlowStack spacing="12" maxWidth="infinity">
  <% for index, genre in ipairs(genres) do %>
  <Button id="genre_<%= index %>" action="genre_<%= index %>" style="plain" accessibilityLabel="<%= genre.title %>, <%= genre.count %> adventures">
    <VStack width="<%= TILE.width %>" height="<%= TILE.height %>" padding="12" spacing="2" alignment="leading" background="<%= genre.tint or 'accent' %>" cornerRadius="<%= TILE.cornerRadius %>" clipsToBounds="true">
      <Spacer />
      <Label text="<%= genre.title %>" size="16" weight="bold" color="white" lines="2" />
    </VStack>
  </Button>
  <% end %>
</FlowStack>
