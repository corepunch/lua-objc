<Sheet width="660" height="600">
  <NavigationStack hidesNavigationBar="true">
    <VStack padding="20" spacing="14" alignment="leading" maxWidth="infinity" maxHeight="infinity">
      <HStack spacing="8" maxWidth="infinity">
        <Label text="@chooseHero" size="23" weight="bold" maxWidth="infinity" />
        <Button id="cancelSetup" title="@cancelHeroSetup" action="cancel" keyboardShortcut="cancelAction" style="glass" />
      </HStack>
      <ScrollView maxWidth="infinity" maxHeight="infinity">
        <VStack id="characterSetup" alignment="leading" maxWidth="infinity" />
      </ScrollView>
      <Divider />
      <Button id="confirmHero" title="@heroContinue" action="confirm" keyboardShortcut="defaultAction" style="glassProminent" tint="accent" height="46" maxWidth="infinity" />
    </VStack>
  </NavigationStack>
</Sheet>
