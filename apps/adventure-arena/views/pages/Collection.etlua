<Page title="<%= title %>">
<ScrollView id="collectionScroll">
  <VStack padding="16" alignment="center" maxWidth="infinity">
    <FlowStack spacing="16">
      <% for index, game in ipairs(games) do %>
      <%- partial("../components/CoverCard.etlua", { game = game, action = game.id, id = "collectionCover_" .. index }) %>
      <% end %>
    </FlowStack>
  </VStack>
</ScrollView>
</Page>
