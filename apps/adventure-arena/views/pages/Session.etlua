<%
  -- The reader. A page of the book fills the screen; the navigation bar is a
  -- running head (the room, then the score). The page itself, the running
  -- head are retained sections drawn
  -- from the session state (sections/Reader, sections/SessionTitle):
  -- a command, a keystroke or a reading setting
  -- changes the state and they are drawn again.
%>
<Page title="<%= roomTitle %>" titleDisplayMode="inline" backButtonDisplayMode="minimal" onDisappear="disappear">
<Toolbar>
  <ToolbarItem id="sessionHeading" placement="principal" label="<%= roomTitle %>">
    <VStack id="heading" width="230" />
  </ToolbarItem>
  <% if phone then %>
  <ToolbarItem placement="keyboard" label="@commandSuggestions">
    <VStack id="completions" maxWidth="infinity" />
  </ToolbarItem>
  <% end %>
  <ToolbarItem id="readingSettings" placement="primaryAction" icon="textformat.size" label="@themesAndSettingsButton" action="readingSettings" />
</Toolbar>
<VStack id="reader" ignoresSafeArea="top" maxWidth="infinity" maxHeight="infinity" />
</Page>
