<%
  -- The reader. A page of the book fills the screen; the navigation bar is a
  -- running head (the story, then the room). The page itself, the running
  -- head and the completions above the keyboard are retained sections drawn
  -- from the session state (sections/Reader, sections/SessionTitle,
  -- sections/Suggestions): a command, a keystroke or a reading setting
  -- changes the state and they are drawn again.
%>
<Page title="<%= gameTitle %>" hidesTabBar="true" titleDisplayMode="inline" backButtonDisplayMode="minimal" onDisappear="disappear">
<Toolbar>
  <ToolbarItem id="sessionHeading" placement="principal" label="<%= gameTitle %>">
    <VStack id="heading" width="230" />
  </ToolbarItem>
  <ToolbarItem id="readingSettings" placement="primaryAction" icon="textformat.size" label="Themes and settings" action="readingSettings" />
  <ToolbarItem id="suggestionBar" placement="keyboard" label="Suggestions">
    <VStack id="suggestions" maxWidth="infinity" />
  </ToolbarItem>
</Toolbar>
<VStack id="reader" maxWidth="infinity" maxHeight="infinity" />
</Page>
