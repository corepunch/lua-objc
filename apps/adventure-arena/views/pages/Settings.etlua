<ScrollView id="settingsScroll">
  <VStack paddingHorizontal="20" paddingTop="4" paddingBottom="32" spacing="20" alignment="leading" maxWidth="infinity">
    <VStack spacing="10" alignment="leading" maxWidth="infinity">
      <Label text="@language" size="13" weight="semibold" color="secondary" smallCaps="true" />
      <Picker id="language" value="<%= languageIndex %>" style="segmented" onChange="changeLanguage" accessibilityLabel="@language" maxWidth="infinity">
        <Option title="@languageAutomatic" />
        <% for _, language in ipairs(languages) do %>
        <Option title="<%= language.title %>" />
        <% end %>
      </Picker>
    </VStack>
    <%- partial("../sections/GamesInProgress.etlua", { entries = entries, resources = resources }) %>
    <Label text="@readingOptionsDetail" size="15" color="secondary" lines="0" />
    <VStack id="readingOptions" maxWidth="infinity" />
    <VStack spacing="10" alignment="leading" maxWidth="infinity">
      <Label text="@help" size="13" weight="semibold" color="secondary" smallCaps="true" />
      <Label text="@helpDetail" size="15" color="secondary" lines="0" />
      <Button id="howToPlay" title="@howToPlay" systemImage="questionmark.circle" action="howToPlay" style="glass" size="16" weight="semibold" />
    </VStack>
  </VStack>
</ScrollView>
