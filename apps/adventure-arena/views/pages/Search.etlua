<Page title="@search" onDisappear="closeCatalogPage">
  <VStack spacing="0" maxWidth="infinity" maxHeight="infinity">
    <SearchField id="searchField" text="<%= query %>" placeholder="@searchPlaceholder" accessibilityLabel="@searchLabel" onChange="search" paddingHorizontal="16" paddingBottom="8" />
    <VStack id="catalogContent" maxWidth="infinity" maxHeight="infinity" />
  </VStack>
</Page>
