<%
  -- Featured stories, category shelves and the chart share the same side insets.
  local PAGE = { side = 16, band = 30, heading = 10 }
%>
<% if #games == 0 then %>
<ContentUnavailable id="emptyCatalog" title="No Adventures" systemImage="books.vertical" description="The shelf is empty. Write a ZIL story, or come back when the catalog has landed.">
  <Button id="openCreate" title="Write an Adventure" action="openCreate" style="borderedProminent" />
</ContentUnavailable>
<% else %>
<ScrollView id="libraryScroll">
  <VStack spacing="0" paddingBottom="32">
    <% if #featured > 0 then %>
    <ScrollView id="featuredCarousel" horizontal="true" vertical="false" scrollTargetBehavior="viewAligned">
      <HStack spacing="12" paddingHorizontal="<%= PAGE.side %>" paddingTop="4" alignment="top">
        <% for index, game in ipairs(featured) do %>
        <%- partial("../components/FeaturedCard.etlua", { game = game, index = index }) %>
        <% end %>
      </HStack>
    </ScrollView>
    <% end %>
    <% for index, shelf in ipairs(shelves) do %>
    <%- partial("../sections/Shelf.etlua", { shelf = shelf, index = index, sideInset = PAGE.side }) %>
    <% end %>
    <% if #topRated > 0 then %>
    <VStack paddingTop="<%= PAGE.band %>" paddingHorizontal="<%= PAGE.side %>" spacing="2" alignment="leading" maxWidth="infinity">
      <Label text="Top Rated" size="22" weight="bold" />
      <Label text="The adventures players love most" size="15" color="secondary" />
      <VStack paddingTop="<%= PAGE.heading %>" spacing="0" maxWidth="infinity">
        <% for index, entry in ipairs(topRated) do %>
        <%- partial("../components/GameRow.etlua", { game = entry.game, rank = entry.rank, action = "chart_" .. index, id = "chartRow_" .. index, divider = index < #topRated }) %>
        <% end %>
      </VStack>
    </VStack>
    <% end %>
  </VStack>
</ScrollView>
<% end %>
