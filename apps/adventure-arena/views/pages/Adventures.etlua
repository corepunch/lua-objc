<%
  -- The reading shelf, category shelves and chart share the same side insets.
  local PAGE = { side = 16, band = 30, heading = 10 }
%>
<% if #games == 0 then %>
<ContentUnavailable id="emptyCatalog" title="@noAdventures" systemImage="books.vertical" description="@emptyCatalog">
  <Button id="openCreate" title="@writeAdventure" action="openCreate" style="borderedProminent" />
</ContentUnavailable>
<% else %>
<ScrollView id="libraryScroll" topEdgeEffectStyle="soft">
  <VStack spacing="0" paddingBottom="32">
    <% if #inProgress > 0 then %>
    <%- partial("../sections/ContinueReading.etlua", { entries = inProgress, sideInset = PAGE.side, resources = resources }) %>
    <% end %>
    <% for index, shelf in ipairs(shelves) do %>
    <%- partial("../sections/Shelf.etlua", { shelf = shelf, index = index, sideInset = PAGE.side, resources = resources }) %>
    <% end %>
    <% if #topRated > 0 then %>
    <VStack paddingTop="<%= PAGE.band %>" paddingHorizontal="<%= PAGE.side %>" spacing="2" alignment="leading" maxWidth="infinity">
      <Label text="@topRated" size="22" weight="bold" />
      <Label text="@topRatedDetail" size="15" color="secondary" />
      <VStack paddingTop="<%= PAGE.heading %>" spacing="0" maxWidth="infinity">
        <% for index, entry in ipairs(topRated) do %>
        <%- partial("../components/GameRow.etlua", { game = entry.game, rank = entry.rank, resources = resources, action = "chart_" .. index, id = "chartRow_" .. index, divider = index < #topRated }) %>
        <% end %>
      </VStack>
    </VStack>
    <% end %>
  </VStack>
</ScrollView>
<% end %>
