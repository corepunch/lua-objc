<%
  -- One column of the App Store’s information strip: a caption in small
  -- capitals, the fact itself, and a line of detail. A long value (a German
  -- compound such as Superhelden-Rollenspiel) shrinks to fit rather than cut.
  local FACT = { width = 148, rule = 36 }
%>
<HStack spacing="0" alignment="center">
  <VStack width="<%= FACT.width %>" spacing="3" alignment="center">
    <Label text="<%= caption %>" size="11" weight="semibold" color="secondary" smallCaps="true" lines="1" />
    <Label text="<%= value %>" size="20" weight="bold" design="rounded" lines="1" minimumScaleFactor="0.55" truncation="tail" alignment="center" />
    <Label text="<%= detail %>" size="12" color="secondary" lines="2" truncation="tail" alignment="center" />
  </VStack>
  <% if divider then %>
  <Divider orientation="vertical" height="<%= FACT.rule %>" />
  <% end %>
</HStack>
