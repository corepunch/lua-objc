<% if #games == 0 then %>
<ContentUnavailable ref="emptyCatalog" title="No Adventures" systemImage="gamecontroller" description="No adventures are available." />
<% else %>
<ScrollView ignoresSafeArea="top">
  <VStack spacing="0">
    <% if featured then %>
    <Button action="featured" style="plain" accessibilityLabel="Open <%= featured.title %>" ref="featuredCoverButton">
      <ZStack ref="hero" height="500" maxWidth="infinity" alignment="bottomLeading" clipsToBounds="true">
        <Image path="<%= featured.cover %>" resizable="true" contentMode="fill" />
        <LinearGradient ref="heroGradient" />
        <VStack paddingHorizontal="20" paddingBottom="56" spacing="6" alignment="leading">
          <Label text="<%= featured.genre:upper() %>" size="12" color="white" />
          <Label text="<%= featured.title %>" size="28" weight="bold" color="white" lines="2" />
          <Label text="<%= featured.shortDescription %>" size="16" color="white" lines="2" />
          <HStack spacing="6">
            <%- partial("Stars.etlua", { rating = featured.rating, size = 13 }) %>
            <Label text="<%= string.format('%.1f · Play', featured.rating) %>" size="13" weight="bold" color="white" />
          </HStack>
        </VStack>
      </ZStack>
    </Button>
    <% end %>
    <VStack paddingBottom="24" spacing="0" alignment="leading">
      <VStack paddingTop="24" paddingBottom="8" paddingHorizontal="16" spacing="0" alignment="leading">
        <Label text="All Adventures" size="23" weight="bold" color="primary" />
      </VStack>
      <ScrollView horizontal="true" vertical="false">
        <HStack spacing="12" paddingHorizontal="16" alignment="top">
          <% for index, game in ipairs(games) do %>
          <Button action="<%= game.id %>" accessibilityLabel="Open <%= game.title %>" ref="coverButton_<%= index %>" style="plain">
            <VStack width="142" spacing="8" alignment="leading">
              <Image ref="cover_<%= index %>" path="<%= game.cover %>" resizable="true" contentMode="fill" cornerRadius="10" width="130" height="176" />
              <Label text="<%= game.title %>" size="13" weight="bold" color="primary" lines="1" truncation="tail" height="16" />
              <HStack spacing="4">
                <%- partial("Stars.etlua", { rating = game.rating, size = 9 }) %>
                <Label text="<%= string.format('%.1f', game.rating) %>" size="12" color="secondary" />
              </HStack>
            </VStack>
          </Button>
          <% end %>
        </HStack>
      </ScrollView>
    </VStack>
  </VStack>
</ScrollView>
<% end %>
