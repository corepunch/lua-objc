<%
  -- Discover: an editorial storefront in the manner of the App Store and
  -- Apple Books. A carousel of featured cards, the stories in progress, short
  -- labelled shelves, a chart and genre tiles; every band stays short, so 30
  -- titles remain browsable without an endless grid.
  local PAGE = { side = 16, band = 30, heading = 10 }
%>
<% if #games == 0 then %>
<ContentUnavailable id="emptyCatalog" title="No Adventures" systemImage="books.vertical" description="No adventures are available." />
<% else %>
<ScrollView id="libraryScroll">
  <VStack spacing="0" paddingBottom="32">
    <% if #featured > 0 then %>
    <ScrollView id="featuredCarousel" horizontal="true" vertical="false" scrollTargetBehavior="viewAligned">
      <HStack spacing="12" paddingHorizontal="<%= PAGE.side %>" paddingTop="4" alignment="top">
        <% for index, game in ipairs(featured) do %>
        <%- partial("FeaturedCard.etlua", { game = game, index = index }) %>
        <% end %>
      </HStack>
    </ScrollView>
    <% end %>
    <VStack id="continueShelf" maxWidth="infinity" />
    <% for index, shelf in ipairs(shelves) do %>
    <%- partial("Shelf.etlua", { shelf = shelf, index = index }) %>
    <% end %>
    <% if #topRated > 0 then %>
    <VStack paddingTop="<%= PAGE.band %>" paddingHorizontal="<%= PAGE.side %>" spacing="2" alignment="leading" maxWidth="infinity">
      <Label text="Top Rated" size="22" weight="bold" />
      <Label text="The adventures players love most" size="15" color="secondary" />
      <VStack paddingTop="<%= PAGE.heading %>" spacing="0" maxWidth="infinity">
        <% for index, entry in ipairs(topRated) do %>
        <%- partial("GameRow.etlua", { game = entry.game, rank = entry.rank, action = "chart_" .. index, id = "chartRow_" .. index, divider = index < #topRated }) %>
        <% end %>
      </VStack>
    </VStack>
    <% end %>
    <% if #genres > 0 then %>
    <VStack paddingTop="<%= PAGE.band %>" paddingHorizontal="<%= PAGE.side %>" spacing="<%= PAGE.heading + 2 %>" alignment="leading" maxWidth="infinity">
      <Label text="Browse by Genre" size="22" weight="bold" />
      <%- partial("GenreGrid.etlua", { genres = genres }) %>
    </VStack>
    <% end %>
  </VStack>
</ScrollView>
<% end %>
