<Page title="<%= gameTitle %>" hidesTabBar="true" titleDisplayMode="inline" backButtonDisplayMode="minimal" onDisappear="disappear">
<Toolbar>
  <ToolbarItem id="sessionTitle" placement="principal" label="<%= gameTitle %>">
    <%- partial("SessionTitle.etlua", { gameTitle = gameTitle, progress = progress }) %>
  </ToolbarItem>
  <ToolbarItem id="readingSettings" placement="primaryAction" icon="textformat.size" label="Reading settings" action="readingSettings" />
</Toolbar>
<ZStack id="session" maxWidth="infinity" maxHeight="infinity">
  <%
    -- The "Cover" reading theme: the cover art of the game, blurred by the system
    -- material, becomes the page — the way Music lays album art behind lyrics.
  %>
  <ZStack id="backdrop" maxWidth="infinity" maxHeight="infinity" hidden="<%= backdrop and 'false' or 'true' %>" clipsToBounds="true">
    <% if cover then %>
    <Image id="backdropImage" path="<%= cover %>" resizable="true" contentMode="fill" />
    <% end %>
    <MaterialView material="thick" maxWidth="infinity" maxHeight="infinity">
      <Spacer />
    </MaterialView>
  </ZStack>
  <ZStack id="sessionOverlay" alignment="bottomTrailing" maxWidth="infinity" maxHeight="infinity">
  <SafeAreaInset id="sessionContent" edge="bottom" minimumBottomInset="24" keyboardBottomInset="12" horizontalInset="12" matchBottomHorizontalInset="true" maxWidth="infinity" maxHeight="infinity">
    <ScrollView id="transcriptScroll" flexGrow="1" scrollOnKeyboard="true">
      <VStack id="transcript" maxWidth="infinity" />
    </ScrollView>

      <VStack spacing="0" maxWidth="infinity">
        <Label id="dictationStatus" text="" size="13" color="secondary" paddingHorizontal="20" lines="2" />
        <ScrollView id="suggestionScroll" horizontal="true" vertical="false" maxWidth="infinity">
          <HStack id="suggestions" paddingBottom="8" />
        </ScrollView>
        <GlassEffectContainer spacing="14">
          <HStack spacing="8" alignment="bottom">
            <Menu id="quickActions" title="" systemImage="plus" symbolSize="31" style="glass" accessibilityLabel="More commands" width="52" height="52">
              <MenuItem title="Look" systemImage="eye" action="look" />
              <MenuItem title="Inventory" systemImage="shippingbox" action="inventory" />
              <MenuItem title="End session" systemImage="xmark.circle" action="close" />
            </Menu>
            <GlassEffect style="regular" cornerRadius="26" maxWidth="infinity">
              <HStack paddingLeading="16" paddingTrailing="5" spacing="8" minHeight="52">
                <TextField id="input" placeholder="What do you want to do?" accessibilityLabel="Command" style="plain" maxWidth="infinity" onChange="inputChanged" onCommand="inputCommand" onFocus="inputFocused" />
                <% if speechAvailable then %>
                <Button id="dictate" title="" systemImage="mic" symbolSize="22" accessibilityLabel="Dictate command" action="dictate" style="plain" width="38" height="44" />
                <% end %>
                <Button id="send" title="" systemImage="arrow.up.circle.fill" symbolSize="31" weight="semibold" foregroundStyle="accent" accessibilityLabel="Send command" action="submit" style="plain" width="38" height="44" hidden="<%= speechAvailable and 'true' or 'false' %>" disabled="true" />
              </HStack>
            </GlassEffect>
          </HStack>
        </GlassEffectContainer>
      </VStack>
  </SafeAreaInset>
  <VStack paddingBottom="148" paddingTrailing="12">
    <%- partial("Compass.etlua", { actions = actions, availableDirections = availableDirections, compassSegments = compassSegments }) %>
  </VStack>
  </ZStack>
</ZStack>
</Page>
