<VStack spacing="8">
  <ScrollView>
    <VStack padding="20" spacing="14" alignment="leading">
      <Label ref="output" text="<%= transcript %>" size="16" lines="0" />
    </VStack>
  </ScrollView>
  <Label ref="dictationStatus" text="" size="13" color="secondary" paddingHorizontal="20" lines="2" />
  <HStack paddingHorizontal="16" spacing="10">
    <GlassEffect style="regular" cornerRadius="28" maxWidth="infinity">
      <HStack paddingHorizontal="14" spacing="8" minHeight="56">
        <TextField ref="input" placeholder="What do you want to do?" maxWidth="infinity" />
        <% if speechAvailable then %>
        <Button ref="dictate" title="" systemImage="mic" accessibilityLabel="Dictate command" action="dictate" style="plain" />
        <% end %>
      </HStack>
    </GlassEffect>
    <Button ref="send" title="Send" action="submit" style="plain" />
  </HStack>
  <HStack paddingHorizontal="16" paddingBottom="8">
    <Button ref="look" title="look" action="look" />
    <Button ref="inventory" title="inventory" action="inventory" />
    <Spacer />
    <Button ref="close" title="End session" action="close" />
  </HStack>
</VStack>
