<% if query == "" then %>
<VStack maxWidth="infinity" />
<% elseif #results == 0 then %>
<ContentUnavailable id="noResults" title="@noResults" systemImage="magnifyingglass" description="<%= string.format(resources.noResultsFor, query) %>" />
<% else %>
<ScrollView>
  <VStack paddingHorizontal="16" spacing="0" maxWidth="infinity">
    <% for index, game in ipairs(results) do %>
    <%- partial("../components/GameRow.etlua", { game = game, resources = resources, action = "result_" .. index, id = "result_" .. index, divider = index < #results }) %>
    <% end %>
  </VStack>
</ScrollView>
<% end %>
