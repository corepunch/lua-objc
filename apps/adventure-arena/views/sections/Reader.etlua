<%
  -- Every story keeps the command composer beside the latest response.
  local BAR = { height = 52, radius = 26, minSize = 15, maxSize = 20 }
  local fieldSize = math.max(BAR.minSize, math.min(reading.fontSize, BAR.maxSize))
%>
<ZStack id="session" maxWidth="infinity" maxHeight="infinity" alignment="top" tint="accent" background="<%= reading.page %>" colorScheme="<%= reading.colorScheme %>">
  <SafeAreaInset id="sessionContent" edge="bottom" overlay="true" minimumBottomInset="24" keyboardBottomInset="4" horizontalInset="12" matchBottomHorizontalInset="true" maxWidth="infinity" maxHeight="infinity">
    <ScrollView id="transcriptScroll" topEdgeEffectStyle="soft" flexGrow="1" maxWidth="infinity" scrollOnKeyboard="true" scrollDismissesKeyboard="interactively">
      <VStack id="transcript" maxWidth="infinity" />
    </ScrollView>
    <VStack spacing="8" maxWidth="infinity">
      <Label id="dictationStatus" text="<%= dictation.status %>" size="13" color="<%= reading.secondary %>" paddingHorizontal="20" lines="2" hidden="<%= tostring(dictation.status == "") %>" />
      <GlassEffect id="commandBar" style="regular" cornerRadius="<%= BAR.radius %>" maxWidth="infinity">
        <HStack paddingLeading="18" paddingTrailing="5" spacing="4" minHeight="<%= BAR.height %>">
          <TextField id="input" verbatim="<%= tostring(composer.verbatim == true) %>" text="<%= draft %>" placeholder="@placeholder" accessibilityLabel="@command" style="plain" size="<%= fieldSize %>" design="<%= reading.font %>" color="<%= reading.primary %>" maxWidth="infinity" onChange="inputChanged" onCommand="inputCommand" onFocus="inputFocused" />
          <% if composer.dictate then %>
          <Button id="dictate" title="" systemImage="mic" symbolSize="20" accessibilityLabel="@dictate" action="dictate" style="plain" width="40" height="44" />
          <% else %>
          <Button id="send" title="" systemImage="arrow.up.circle.fill" symbolSize="30" weight="semibold" foregroundStyle="accent" tint="accent" accessibilityLabel="@send" action="submit" style="plain" width="40" height="44" disabled="<%= tostring(not composer.canSend) %>" />
          <% end %>
        </HStack>
      </GlassEffect>
    </VStack>
  </SafeAreaInset>

  <VStack id="toastLayer" safeAreaPadding="top" paddingTop="8" allowsHitTesting="false" maxWidth="infinity" alignment="center">
    <GlassEffect id="scoreToast" style="regular" hidden="<%= tostring(toast == nil) %>" accessibilityLabel="@score">
      <HStack paddingHorizontal="16" paddingVertical="10" spacing="8" alignment="center">
        <SystemImage name="sparkles" size="15" color="accent" label="@points" />
        <Label id="scoreToastText" text="<%= toast or "" %>" size="15" weight="semibold" monospacedDigit="true" />
      </HStack>
    </GlassEffect>
  </VStack>
</ZStack>
