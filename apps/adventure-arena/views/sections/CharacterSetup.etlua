<VStack spacing="16" alignment="leading" maxWidth="infinity">
  <ScrollView id="heroCards" horizontal="true" vertical="false" scrollTargetBehavior="viewAligned" maxWidth="infinity">
    <HStack spacing="12" alignment="top">
      <% for index, profile in ipairs(profiles) do %>
      <%- partial("../components/CharacterCard.etlua", { profile = profile, index = index, selected = hero == profile, resources = resources }) %>
      <% end %>
    </HStack>
  </ScrollView>
  <TextField id="heroName" text="<%= name %>" placeholder="@heroNameOptional" accessibilityLabel="@heroNameOptional" onChange="nameChanged" verbatim="true" size="17" maxWidth="infinity" />
  <% if nameError then %><Label text="<%= nameError %>" color="secondary" lines="0" /><% end %>
</VStack>
