<%
  -- The opening starts with the title and credits when the story prints them.
  -- Each new room opens a scene with its name as the title.
  -- Reader commands use a chevron and secondary ink. The story answers in prose.
  -- `reading` carries the reader’s face, size, leading, alignment and inks.
  -- `reveal` holds the characters shown of paragraphs still typing, keyed
  -- "entry_paragraph". A paragraph that has not started is set in full and
  -- drawn clear, and the title of a scene in `reveal.waiting` is transparent:
  -- the page is as tall as the whole answer from the moment it arrives, so
  -- it scrolls to the answer once and typing moves nothing.
  local size, lead = reading.fontSize, reading.lineSpacing
  local PAGE = {
    side = 24, top = 28, bottom = 36,
    titleExtra = 12, creditReduction = 4, creditGap = 2,
    commandMarker = math.floor(size * 0.65),
  }
  local hyphenate = reading.alignment == "justified" and "true" or "false"
  reveal = reveal or { waiting = {} }
  local function revealed(index, paragraphIndex)
    local shown = reveal[index .. "_" .. paragraphIndex]
    return string.format('revealedCharacters="%d"', shown or -1)
  end
  local function waiting(index)
    return string.format('opacity="%d"', reveal.waiting[tostring(index)] and 0 or 1)
  end
%>
<VStack paddingHorizontal="<%= PAGE.side %>" paddingTop="<%= PAGE.top %>" paddingBottom="<%= PAGE.bottom %>" spacing="0" alignment="leading" maxWidth="infinity">
  <Resources>
    <Number id="textGap" value="12" />
    <Number id="turnGap" value="24" />
  </Resources>
  <% for index, entry in ipairs(entries) do
       local entryTop = index == 1 and earlierEntries == 0 and 0 or "@textGap"
  %>
  <% if entry.kind == "banner" then %>
  <VStack id="entry_<%= index %>" spacing="<%= PAGE.creditGap %>" alignment="leading" maxWidth="infinity" paddingTop="<%= entryTop %>">
    <Label id="bannerTitle_<%= index %>" text="<%= entry.title %>" size="<%= size + PAGE.titleExtra %>" weight="bold" design="<%= reading.font %>" color="<%= reading.primary %>" alignment="leading" lines="0" />
    <% for lineIndex, line in ipairs(entry.lines) do %>
    <Label id="bannerLine_<%= index %>_<%= lineIndex %>" text="<%= line %>" size="<%= size - PAGE.creditReduction %>" design="<%= reading.font %>" color="<%= reading.secondary %>" alignment="leading" lines="0" />
    <% end %>
  </VStack>
  <% elseif entry.kind == "scene" then %>
  <VStack id="entry_<%= index %>" spacing="@textGap" alignment="leading" maxWidth="infinity" paddingTop="<%= entryTop %>">
    <Label id="sceneTitle_<%= index %>" text="<%= entry.title %>" size="<%= size + 9 %>" design="<%= reading.font %>" weight="semibold" color="<%= reading.primary %>" lines="0" <%- waiting(index) %> />
    <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
    <Paragraph id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lineSpacing="<%= lead %>" alignment="<%= reading.alignment %>" hyphenation="<%= hyphenate %>" <%- revealed(index, paragraphIndex) %>>
      <%- partial("ProseQuotes.etlua", { paragraph = paragraph, quoteRanges = quoteRanges }) %>
    </Paragraph>
    <% end %>
  </VStack>
  <% elseif entry.kind == "command" then %>
  <VStack id="entry_<%= index %>" paddingTop="@turnGap" alignment="leading" maxWidth="infinity">
    <HStack spacing="6" alignment="center">
      <SystemImage name="chevron.right" size="<%= PAGE.commandMarker %>" weight="semibold" color="<%= reading.secondary %>" label="" />
      <Label id="command_<%= index %>" text="<%= entry.text %>" size="<%= size - 1 %>" design="<%= reading.font %>" weight="medium" color="<%= reading.secondary %>" lines="0" accessibilityLabel="<%= string.format(resources.youSaid, entry.text) %>" />
    </HStack>
  </VStack>
  <% else %>
  <VStack id="entry_<%= index %>" spacing="@textGap" alignment="leading" maxWidth="infinity" paddingTop="<%= entryTop %>">
    <% for paragraphIndex, paragraph in ipairs(entry.paragraphs) do %>
    <Paragraph id="paragraph_<%= index %>_<%= paragraphIndex %>" text="<%= paragraph %>" size="<%= size %>" design="<%= reading.font %>" color="<%= reading.primary %>" lineSpacing="<%= lead %>" alignment="<%= reading.alignment %>" hyphenation="<%= hyphenate %>" <%- revealed(index, paragraphIndex) %>>
      <%- partial("ProseQuotes.etlua", { paragraph = paragraph, quoteRanges = quoteRanges }) %>
    </Paragraph>
    <% end %>
  </VStack>
  <% end %>
  <% end %>
</VStack>
