<VStack paddingTop="28" spacing="10" alignment="leading" maxWidth="infinity">
  <Button id="shelfHeading_<%= index %>" style="plain" action="shelf_<%= index %>" paddingHorizontal="<%= sideInset %>" accessibilityLabel="<%= string.format(resources.seeAll, shelf.title) %>">
    <HStack spacing="6" alignment="center">
      <Label text="<%= shelf.title %>" size="22" weight="bold" design="serif" lines="1" truncation="tail" />
      <SystemImage name="chevron.right" size="12" weight="semibold" color="secondary" label="" />
    </HStack>
  </Button>
  <ScrollView id="shelfScroll_<%= index %>" horizontal="true" vertical="false" scrollTargetBehavior="viewAligned">
    <HStack id="shelfBooks_<%= index %>" spacing="14" paddingHorizontal="<%= sideInset %>" alignment="top">
      <% for gameIndex, game in ipairs(shelf.games) do %>
      <%- partial("../components/CoverCard.etlua", { game = game, action = game.id, id = "cover_" .. index .. "_" .. gameIndex }) %>
      <% end %>
    </HStack>
  </ScrollView>
</VStack>
