<HStack spacing="8" paddingHorizontal="4">
  <% for index, suggestion in ipairs(suggestions) do %>
  <Button id="suggestion_<%= index %>" title="<%= suggestion.title %>" action="suggest_<%= index %>" style="glass" size="15" accessibilityLabel="<%= suggestion.submit and ('Do: ' .. suggestion.title) or ('Complete: ' .. suggestion.title) %>" />
  <% end %>
</HStack>
