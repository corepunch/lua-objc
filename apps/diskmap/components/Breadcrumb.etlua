<HStack spacing="6" alignment="center">
  <% for index, crumb in ipairs(records) do %>
  <% if index > 1 then %><SystemImage name="chevron.right" size="10" color="tertiary" /><% end %>
  <% if crumb.current then %>
  <Label text="<%= crumb.name %>" size="13" weight="semibold" lines="1" />
  <% else %>
  <% -- An earlier step is a label that goes back to its level; the underline under the pointer shows it can be clicked. %>
  <Label text="<%= crumb.name %>" size="13" color="secondary" lines="1" underlinesOnHover="true" onClick="<%= crumb.action %>" accessibilityLabel="Show <%= crumb.name %>" help="Show <%= crumb.name %>" />
  <% end %>
  <% end %>
  <ContentPresenter />
</HStack>
