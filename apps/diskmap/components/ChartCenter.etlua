<VStack spacing="0" alignment="center">
  <Label id="<%= titleId or "" %>" text="<%= total %>" size="<%= totalSize %>" minimumScaleFactor="<%= totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
  <Label id="<%= detailId or "" %>" text="<%= caption %>" size="<%= captionSize %>" minimumScaleFactor="<%= captionScale %>" lines="1" color="secondary" />
</VStack>
