<% --[[ The frame of every page: its margin and one readable column, centered
  in a wider window, as UIKit's readable content guide and a grouped
  SwiftUI Form are. A page that scrolls keeps the scroller at the window
  edge; a page that fills the height (Storage Map, Folder Map) does not
  scroll. The page's own content stack is the content. ]] %>
<% if scrolls then %>
<ScrollView vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack padding="<%= frame.margin %>" alignment="center">
    <VStack maxWidth="<%= frame.width %>" alignment="leading">
      <ContentPresenter />
    </VStack>
  </VStack>
</ScrollView>
<% else %>
<VStack flexGrow="1" maxHeight="infinity" padding="<%= frame.margin %>" alignment="center">
  <VStack flexGrow="1" maxWidth="<%= frame.width %>" maxHeight="infinity" alignment="leading">
    <ContentPresenter />
  </VStack>
</VStack>
<% end %>
