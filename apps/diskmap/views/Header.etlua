<% --[[ A page's header: its icon, color and title come from its page in app.xml
  (`page`), the line under the title is the bound `summary`, and `buttons` are
  {id, title, systemImage, command, style, help}: each binds a command of the
  page model. ]] %>
<HStack id="pageHeader" spacing="@spacing" alignment="center">
  <Resources>
    <Number id="spacing" value="14" />
    <Number id="symbol" value="36" />
    <Number id="textSpacing" value="2" />
  </Resources>
  <SystemImage name="<%= page.icon %>" size="@symbol" badgeColor="<%= page.color %>" />
  <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="@textSpacing" alignment="leading">
    <Label id="pageTitle" text="<%= page.attrs.header or page.title %>" size="22" weight="semibold" lines="1" />
    <Label id="summary" text="$summary" size="13" color="secondary" monospacedDigit="true" maxWidth="infinity" lines="0" />
  </VStack>
  <% for _, button in ipairs(buttons or {}) do %>
  <Button id="<%= button.id %>" title="<%= button.title %>"<% if button.systemImage then %> systemImage="<%= button.systemImage %>"<% end %><% if button.style then %> style="<%= button.style %>"<% end %> action="$<%= button.command %>"<% if button.help then %> help="<%= button.help %>"<% end %> />
  <% end %>
</HStack>
