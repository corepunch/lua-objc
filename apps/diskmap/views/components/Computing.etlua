<% --[[ The state of a page whose data is still being computed (a read of the
  system, a long scan, a folder being measured): one native spinner and a
  short status line, in place of lists that would fill row by row. The
  populated page is drawn once the data is there. Like ContentUnavailable
  ("Nothing Flagged"), a spacer above and below centers it in the page.

    status       what is being computed, or how far it is
    stopAction   optional: a Stop button under the status ]]
  local COMPUTING = { spacing = 10 }
%>
<VStack id="computing" spacing="<%= COMPUTING.spacing %>" alignment="center" maxWidth="infinity">
  <Spacer />
  <ProgressView id="computingSpinner" />
  <Label id="computingStatus" text="<%= status %>" size="13" color="secondary" lines="1" truncation="middle" />
  <% if stopAction then %><Button id="computingStop" title="Stop" action="<%= stopAction %>" /><% end %>
  <Spacer />
</VStack>
