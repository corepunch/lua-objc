<VStack flexShrink="1"<% if grow then %> flexGrow="1" flexBasis="0"<% end %> spacing="2" alignment="leading">
  <Label <% if titleId then %>id="<%= titleId %>" <% end %>text="<%= title %>" size="15" weight="semibold" />
  <Label <% if detailId then %>id="<%= detailId %>" <% end %>text="<%= detail %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
</VStack>
