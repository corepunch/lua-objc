<% -- The result of the last removal, at the top of the page: one symbol and the sentences. %>
<HStack <% if id then %>id="<%= id %>" <% end %>maxWidth="infinity" spacing="8" alignment="center">
  <SystemImage name="checkmark.circle.fill" size="13" color="systemGreen" />
  <Label <% if id then %>id="<%= id %>Text" <% end %>text="<%= text %>" size="12" color="secondary" flexGrow="1" flexBasis="0" flexShrink="1" lines="0" />
</HStack>
