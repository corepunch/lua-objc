<% -- A warning about the whole page, at its top: one symbol and one sentence. %>
<HStack <% if id then %>id="<%= id %>" <% end %>maxWidth="infinity" spacing="8" alignment="center">
  <SystemImage name="exclamationmark.triangle.fill" size="13" color="systemOrange" />
  <Label <% if id then %>id="<%= id %>Text" <% end %>text="<%= text %>" size="13" color="systemOrange" flexGrow="1" flexBasis="0" flexShrink="1" lines="0" />
</HStack>
