<ScrollView vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity">
<VStack maxWidth="infinity" padding="24" spacing="14" alignment="leading">
  <Label maxWidth="infinity" text="Settings" size="23" weight="bold" />
  <GroupBox header="Background checks" maxWidth="infinity">
    <VStack maxWidth="infinity" padding="12" spacing="8" alignment="leading">
      <Label maxWidth="infinity" text="When enabled, Diskmap refreshes storage every 15 minutes while it is open. Scanning runs in the background; files are never deleted automatically." size="13" lines="0" />
      <Button title="<%= monitoring and 'Pause background checks' or 'Enable background checks' %>" action="monitor" />
    </VStack>
  </GroupBox>
  <GroupBox header="Media libraries" maxWidth="infinity">
    <VStack maxWidth="infinity" padding="12" spacing="8" alignment="leading">
      <Label maxWidth="infinity" text="Photos, Music and Movies stay excluded by default. To measure them, Diskmap must enumerate their files; macOS may ask for access." size="13" lines="0" />
      <Button title="<%= mediaEnabled and 'Exclude media libraries' or 'Include media libraries for this session…' %>" action="media" />
      <Label maxWidth="infinity" text="The choice resets when Diskmap quits. System Settings can show media totals without granting Diskmap access." size="12" color="secondary" lines="0" />
    </VStack>
  </GroupBox>
  <GroupBox header="Scan access" maxWidth="infinity">
    <VStack maxWidth="infinity" padding="12" spacing="8" alignment="leading">
      <Label maxWidth="infinity" text="Scans cover personal folders, app containers, backups, Trash and unclassified files. Full Disk Access is optional and may improve coverage; protected or unavailable files can still be omitted." size="13" lines="0" />
      <Button title="Open Privacy &amp; Security…" action="privacy" />
    </VStack>
  </GroupBox>
  <DisclosureGroup label="Measurement limits" expanded="false" maxWidth="infinity">
    <VStack maxWidth="infinity" padding="12" spacing="8" alignment="leading">
      <Label maxWidth="infinity" text="Sizes measure allocated file blocks. APFS clones, compression, snapshots and concurrent changes can make actual reclaimed space differ. Cloud-only files are not downloaded. Scans skip symbolic links and other mounted volumes." size="13" lines="0" />
      <Label maxWidth="infinity" text="Not attributed is the difference between measured categories and macOS disk usage. It can include unreadable files, snapshots and filesystem accounting; it is not a cleanup estimate." size="13" lines="0" />
    </VStack>
  </DisclosureGroup>
  <DisclosureGroup label="Recommendations and safety" expanded="false" maxWidth="infinity">
    <VStack maxWidth="infinity" padding="12" spacing="8" alignment="leading">
      <Label maxWidth="infinity" text="Diskmap names data only when its owner or project markers are recognized. A review suggestion crossed a size threshold; it does not mean the data is unnecessary or promise recovered space. Every cleanup action needs separate confirmation." size="13" lines="0" />
      <Label maxWidth="infinity" text="macOS manages local Time Machine snapshots and removes them as needed. They are restore points, not junk. Manage backups in Time Machine settings; Diskmap never deletes snapshots or protected system assets." size="13" lines="0" />
    </VStack>
  </DisclosureGroup>
  <Button title="Open Storage Settings" action="storage" />
</VStack>

</ScrollView>
