<Sheet width="460" height="448">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="20" spacing="16" alignment="leading">
    <Label text="Settings" size="15" weight="semibold" />
    <VStack maxWidth="infinity" spacing="6" alignment="leading">
      <Label text="Scanning" size="11" weight="semibold" color="secondary" />
      <GroupBox maxWidth="infinity">
        <VStack maxWidth="infinity" padding="12" spacing="10" alignment="leading">
          <HStack maxWidth="infinity" spacing="12" alignment="center">
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
              <Label text="Refresh while Diskmap is open" size="13" maxWidth="infinity" />
              <Label text="Every 15 minutes. Files are never deleted." size="11" color="secondary" maxWidth="infinity" lines="2" />
            </VStack>
            <Toggle id="monitor" style="switch" label="Refresh while Diskmap is open" value="<%= monitoring and "true" or "false" %>" action="monitor" />
          </HStack>
          <Divider />
          <HStack maxWidth="infinity" spacing="12" alignment="center">
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
              <Label text="Include media libraries" size="13" maxWidth="infinity" />
              <Label text="Photos, Music and TV libraries for this session." size="11" color="secondary" maxWidth="infinity" lines="2" />
            </VStack>
            <Toggle id="media" style="switch" label="Include media libraries" value="<%= mediaEnabled and "true" or "false" %>" action="media" />
          </HStack>
        </VStack>
      </GroupBox>
    </VStack>
    <VStack maxWidth="infinity" spacing="6" alignment="leading">
      <Label text="System" size="11" weight="semibold" color="secondary" />
      <GroupBox maxWidth="infinity">
        <VStack maxWidth="infinity" padding="12" spacing="10" alignment="leading">
          <HStack maxWidth="infinity" spacing="12" alignment="center">
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
              <Label text="Full Disk Access" size="13" maxWidth="infinity" />
              <Label text="Optional. Protected files can still be omitted." size="11" color="secondary" maxWidth="infinity" lines="2" />
            </VStack>
            <Button title="Open…" action="privacy" />
          </HStack>
          <Divider />
          <HStack maxWidth="infinity" spacing="12" alignment="center">
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
              <Label text="Storage" size="13" maxWidth="infinity" />
              <Label text="macOS storage settings." size="11" color="secondary" maxWidth="infinity" lines="2" />
            </VStack>
            <Button title="Open…" action="storage" />
          </HStack>
        </VStack>
      </GroupBox>
    </VStack>
    <HStack maxWidth="infinity">
      <Spacer />
      <Button id="done" title="Done" action="done" keyboardShortcut="defaultAction" />
    </HStack>
  </VStack>
</Sheet>
