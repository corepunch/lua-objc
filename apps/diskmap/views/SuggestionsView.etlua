<VStack fillWidth="true" spacing="6" alignment="leading">
  <Text size="12" weight="bold" color="secondary">Recommendations</Text>
  <VStack fillWidth="true" spacing="0" alignment="leading" cornerRadius="10" background="controlBackground" clipsToBounds="true">
    <% for i, suggestion in ipairs(suggestions) do %>
      <HStack fillWidth="true" fixedHeight="56" paddingHorizontal="14" spacing="12" alignment="center">
        <ZStack fixedWidth="30" fixedHeight="30" cornerRadius="7" background="systemOrange">
          <SystemImage name="<%= suggestion.icon %>" size="14" weight="medium" color="white" />
        </ZStack>
        <VStack spacing="1" alignment="leading">
          <Text size="13" weight="medium"><%= suggestion.name %> <%= suggestion.size %></Text>
          <Text size="11" color="secondary"><%= suggestion.hint %></Text>
        </VStack>
        <Spacer />
        <Button title="Reveal" style="plain" />
      </HStack>
      <% if i < #suggestions then %>
        <HStack fillWidth="true" fixedHeight="1">
          <VStack fixedWidth="56" fixedHeight="1" />
          <VStack flexGrow="1" fixedHeight="1" background="separator" />
        </HStack>
      <% end %>
    <% end %>
  </VStack>
</VStack>
