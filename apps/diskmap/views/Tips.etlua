<VStack maxWidth="infinity" spacing="12" alignment="leading">
  <% for _, tip in ipairs(tips) do %>
  <GroupBox maxWidth="infinity">
    <VStack padding="12" spacing="8" maxWidth="infinity" alignment="leading">
      <SystemImage name="<%= tip.icon %>" size="24" color="accent" />
      <Label text="<%= tip.title %>" size="12" weight="semibold" maxWidth="infinity" lines="0" />
      <Label text="<%= tip.text %>" size="12" maxWidth="infinity" lines="0" />
      <% if tip.actionTitle then %>
      <Button title="<%= tip.actionTitle %>" style="link" action="tip_<%= tip.id %>" />
      <% end %>
    </VStack>
  </GroupBox>
  <% end %>
</VStack>
