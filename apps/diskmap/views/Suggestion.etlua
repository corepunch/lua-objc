<GroupBox fillWidth="true">
<VStack fillWidth="true" padding="10" spacing="6" alignment="leading">
  <HStack fillWidth="true" spacing="8" alignment="center">
    <SystemImage name="<%= suggestion.icon %>" size="24" badgeColor="<%= suggestion.color %>" appIcon="<%= suggestion.appIcon or "" %>" />
    <Label text="<%= suggestion.name %>" size="12" weight="semibold" flexGrow="1" flexBasis="0" flexShrink="1" fillWidth="true" lines="2" />
    <Label text="<%= suggestion.size %>" size="12" weight="semibold" />
  </HStack>
  <Label text="<%= suggestion.subtitle %>" size="11" color="secondary" fillWidth="true" lines="2" />
  <Button title="Review…" action="review_<%= suggestion.id %>" />
</VStack>
</GroupBox>
