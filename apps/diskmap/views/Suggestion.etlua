<HStack fillWidth="true" spacing="10" alignment="center">
  <SystemImage name="<%= suggestion.icon %>" size="32" badgeColor="<%= suggestion.color %>" appIcon="<%= suggestion.appIcon or "" %>" />
  <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="4" alignment="leading">
    <Label text="<%= suggestion.name %>" size="13" weight="semibold" fillWidth="true" lines="1" truncation="tail" />
    <Label text="<%= suggestion.subtitle %>" size="11" color="secondary" fillWidth="true" lines="3" />
    <Label text="<%= suggestion.size %>" size="12" weight="semibold" />
  </VStack>
  <Button title="Review" action="review<%= index %>" />
</HStack>
