<% --[[
  One size meter, like Spectrum's Meter or SwiftUI's Gauge: the size leads
  and its share trails on one line above a full-width capacity bar, as a
  title sits over its subtitle in the name column. A size that is a state
  rather than a number ("Calculating…", "No access") carries a leading
  accessory in one square: the spinner while measuring, otherwise the row's
  symbol, which tints the word beside it. The bar is a capsule half the
  height of AppKit's capacity cell, so the size reads first. The share keeps its width; the size
  truncates first. The bar is always drawn, empty and disabled for a row
  without a fraction, so a size never floats in an empty cell.

  Row fields: `size`, `shareText`, `relative` (0–1), `calculating`,
  `sizeIcon`, `sizeColor`. `value`, `share` and `tint` name other fields for
  the size, its share and the bar's colour. `title` is the column's title:
  the column names what the meter measures, as it names any other cell, so
  VoiceOver reads the bar as the title, then the size and the share labels
  beside it. Bindings are `$field`; a condition is a field with `visible`,
  `hidden`, `enabled` or `disabled`. ]]
  local value, share, tint, title = value or "size", share or "shareText", tint or "color", title or "Size"
%>
<VStack spacing="@lineSpacing" alignment="leading">
  <Resources>
    <Number id="lineSpacing" value="4" />
    <Number id="accessory" value="16" />
    <Number id="symbol" value="13" />
    <Number id="accessoryGap" value="4" />
    <Number id="shareGap" value="8" />
    <Number id="bar" value="9" />
  </Resources>
  <HStack spacing="@shareGap" alignment="center">
    <HStack spacing="@accessoryGap" alignment="center" flexShrink="1">
      <ProgressView controlSize="small" width="@accessory" height="@accessory" visible="$calculating" />
      <SystemImage name="$sizeIcon" color="$sizeColor" size="@symbol" width="@accessory" height="@accessory" visible="$sizeIcon" />
      <Label text="$<%= value %>" color="secondary" truncation="tail" visible="$calculating" />
      <Label text="$<%= value %>" color="$sizeColor" truncation="tail" hidden="$calculating" />
    </HStack>
    <Spacer />
    <Label text="$<%= share %>" color="secondary" fixedSize="horizontal" visible="$<%= share %>" />
  </HStack>
  <Gauge value="$relative" tint="$<%= tint %>" thickness="@bar" enabled="$relative" accessibilityLabel="<%= title %>" />
</VStack>
