<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="12" padding="16" alignment="leading">
    <VStack id="storageBar" maxWidth="infinity" spacing="0" />
    <HStack id="coveragePanel" maxWidth="infinity" spacing="12" alignment="center">
      <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
        <Label id="coverage" text="<%= coverage %>" size="12" maxWidth="infinity" lines="2" />
        <Label id="status" text="<%= status %>" size="11" color="secondary" maxWidth="infinity" lines="2" />
      </VStack>
      <Button id="access" title="Scan access…" style="link" action="access" />
    </HStack>
    <GroupBox id="categoriesPanel" maxWidth="infinity">
      <List id="results" onSelect="select" onActivate="open" onColumnButton="open" drawsBackground="false" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="44" maxWidth="infinity">
        <Column id="name" title="Category" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon" fileIconKey="fileIcon" imageSize="28" minWidth="210" />
        <Column id="size" title="On disk" width="120" minWidth="110" alignment="trailing" loadingKey="calculating" />
        <Column id="info" title="" width="44" minWidth="44" buttonSymbol="info.circle" />
      </List>
    </GroupBox>
  </VStack>
</ScrollView>
