<VStack flexGrow="1" flexBasis="0" flexShrink="1" fillWidth="true" fillHeight="true" spacing="0" alignment="leading">
  <VStack fillWidth="true" padding="20" spacing="8" alignment="leading">
    <Label fillWidth="true" text="<%= title %>" size="22" weight="bold" />
    <Label fillWidth="true" text="<%= subtitle %>" size="12" color="secondary" lines="2" />
  </VStack>
  <% if segments and #segments > 0 then %>
  <VStack fillWidth="true" spacing="10" paddingHorizontal="20" paddingBottom="20">
    <HStack fillWidth="true" fixedHeight="20" spacing="0">
      <% for _, segment in ipairs(segments) do %><HStack flexBasis="0" flexGrow="<%= segment.weight %>" fixedHeight="20" background="<%= segment.color %>" /><% end %>
    </HStack>
    <HStack fillWidth="true" spacing="12">
      <% for _, segment in ipairs(segments) do %>
      <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="4" alignment="leading">
        <Label fillWidth="true" text="<%= segment.name %>" size="11" color="<%= segment.color %>" lines="1" truncation="tail" />
        <Label text="<%= segment.size %>" size="11" color="secondary" />
      </VStack>
      <% end %>
    </HStack>
  </VStack>
  <% end %>
  <List ref="results" style="fullWidth" alternatingRows="false" rowHeight="36" flexGrow="1" flexBasis="0" flexShrink="1" fillWidth="true">
    <Column id="name" title="Name" imageKey="icon" imageColorKey="iconColor" minWidth="160" />
    <Column id="size" title="On disk" width="110" minWidth="110" alignment="right" />
    <% if section == 'Disk Map' then %>
    <Column id="percentage" title="% of folder" width="150" minWidth="140" alignment="right" levelKey="share" levelColorKey="shareColor" />
    <% else %>
    <Column id="status" title="<%= section == 'Suggestions' and 'Consideration' or 'Kind' %>" width="160" minWidth="140" />
    <% end %>
  </List>
  <HStack fillWidth="true" padding="12" spacing="8">
    <Label ref="status" text="<%= status %>" size="11" color="secondary" lines="2" flexGrow="1" flexBasis="0" flexShrink="1" />
    <Button title="<%= hasScan == false and 'Scan Folder…' or 'Rescan' %>" systemImage="<%= hasScan == false and 'folder.badge.plus' or 'arrow.clockwise' %>" action="refresh" />
  </HStack>
</VStack>
