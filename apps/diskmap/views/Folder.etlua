<%
  local FOLDER = { minChart = 220, chartUnits = 300, minimumHole = 0.3, ring = 0.7 / 3, center = { total = 24, caption = 12, totalScale = 12 / 24, captionScale = 0.77 }, gap = 5, depth = 14, list = 420, minList = 260, minPane = 320, meter = 130, legendSize = 84, legendShare = 34 }
  -- Every ring keeps the thickness it has among three, so one ring of
  -- files is a slim ring like the Overview donut, not a thick disc.
  local rings = 1
  for _, node in ipairs(nodes) do rings = math.max(rings, node.ring or 1) end
  local hole = math.max(FOLDER.minimumHole, 1 - rings * FOLDER.ring)
  -- The Map page's ring fades: raised rings are told apart by their gaps and
  -- shading, and smaller items keep their folder's hue, faded further.
  local ringOpacity = { 1, 0.84, 0.68 }
  local otherFade = 0.55
%>
<VStack id="page" transition="opacity" flexGrow="1" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("PageHeader.etlua", {header = header, summary = summary, summaryId = "folderSummary", buttons = buttons}) %>
  <% if state == "empty" then %>
  <ContentUnavailable id="folderEmpty" descriptionAlignment="leading" title="Drop a Folder Here" systemImage="folder.badge.plus" description="Drag a folder or a disk from the Finder onto this window or onto Diskmap in the Dock, or choose File › Open Folder…, to see everything in it by size." />
  <% elseif state == "scanning" then %>
  <VStack id="folderScanning" flexGrow="1" maxHeight="infinity" spacing="10" alignment="center">
    <Spacer />
    <ProgressView id="folderSpinner" />
    <Label id="folderProgress" text="<%= progress %>" size="13" color="secondary" monospacedDigit="true" lines="1" truncation="middle" />
    <Spacer />
  </VStack>
  <% elseif state == "failed" then %>
  <ContentUnavailable id="folderFailed" title="Could Not Measure This Folder" systemImage="exclamationmark.triangle" description="<%= failure %>" />
  <% else %>
  <HStack id="folderBar" spacing="6" alignment="center">
    <% for index, step in ipairs(trail) do %>
    <% if index > 1 then %><SystemImage name="chevron.right" size="10" color="tertiary" /><% end %>
    <% if index < #trail then %>
    <Button title="<%= step.name %>" style="link" size="13" action="focus_<%= index %>" help="Show <%= step.name %>" />
    <% else %>
    <Label id="folderFocus" text="<%= step.name %>" size="13" weight="semibold" lines="1" truncation="middle" />
    <% end %>
    <% end %>
    <% if loadingDeeper then %><ProgressView id="folderDeeper" /><Label id="folderProgress" text="<%= progress %>" size="12" color="secondary" lines="1" truncation="middle" /><% end %>
    <Spacer />
    <Picker id="folderColoring" style="segmented" value="<%= colorIndex %>" onChange="coloring" help="Color the map by folder, by kind of file or by when files were last used">
      <% for _, coloring in ipairs(colorings) do %>
      <Option title="<%= coloring.title %>" />
      <% end %>
    </Picker>
    <Picker id="folderStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="style">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </HStack>
  <% --[[ Rings: the list and the chart share a native split view, so the divider
    moves and the wheel follows. Rectangles already name every item, so the
    treemap takes the whole body and there is no list. ]] %>
  <% if style ~= "rectangles" then %>
  <HSplit id="folderBody" flexGrow="1" maxHeight="infinity" maxWidth="infinity">
    <GroupBox width="<%= FOLDER.list %>" minWidth="<%= FOLDER.minList %>" maxHeight="infinity">
      <List id="folderList" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxHeight="infinity">
        <Column id="name" title="Item" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
        <Column id="size" title="Size" width="<%= FOLDER.meter %>" minWidth="<%= FOLDER.meter %>">
          <%- partial("cells/Meter.etlua") %>
        </Column>
      </List>
    </GroupBox>
  <% else %>
  <HStack id="folderBody" flexGrow="1" maxHeight="infinity" maxWidth="infinity" spacing="16" alignment="top">
  <% end %>
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" minWidth="<%= FOLDER.minPane %>" maxWidth="infinity" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="folderNothing" title="Nothing Here Takes Space" systemImage="folder" description="This folder is empty, or everything in it is smaller than the map can show." />
      <% elseif style == "rectangles" then %>
      <Treemap id="folderTreemap" transition="opacity" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="false" />
        <% end %>
      </Treemap>
      <% else %>
      <% -- Looking inside a group, or back out, moves the rings to the new level. %>
      <VStack id="folderChartHost" flexGrow="1" flexBasis="0" flexShrink="1" minHeight="<%= FOLDER.minChart %>" maxWidth="infinity" maxHeight="infinity" alignment="center">
      <SectorChart id="folderSunburst" transition="opacity" animation="smooth" animationValue="<%= trail[#trail].id %>" scalable="true" diameter="<%= FOLDER.chartUnits %>" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" innerRadius="<%= hole %>" angularInset="<%= FOLDER.gap %>" depth="<%= FOLDER.depth %>" shadow="false" onSelect="chartSelect" onHover="chartHover" onCenter="up" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <SectorMark id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" opacity="<%= (ringOpacity[node.ring] or 0.5) * (node.other and node.parent and otherFade or 1) %>" label="<%= node.label %>" />
        <% end %>
        <VStack spacing="0" alignment="center">
          <Label text="<%= total %>" size="<%= FOLDER.center.total %>" minimumScaleFactor="<%= FOLDER.center.totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
          <Label text="<%= #trail > 1 and "Click to go up" or "Measured" %>" size="<%= FOLDER.center.caption %>" minimumScaleFactor="<%= FOLDER.center.captionScale %>" lines="1" color="secondary" />
        </VStack>
      </SectorChart>
      </VStack>
      <% end %>
      <Label id="folderHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="1" truncation="middle" />
      <% if #legend > 0 then %>
      <GroupBox id="folderLegend">
        <VStack padding="10" spacing="6" alignment="leading">
          <% for _, item in ipairs(legend) do %>
          <HStack key="legend-<%= item.id %>" spacing="6" alignment="center">
            <SystemImage name="circle.fill" size="9" color="<%= item.color %>" />
            <Label text="<%= item.name %>" size="12" lines="1" />
            <Spacer />
            <Label text="<%= item.size %>" size="12" monospacedDigit="true" width="<%= FOLDER.legendSize %>" alignment="trailing" lines="1" />
            <Label text="<%= item.share %>" size="11" color="secondary" monospacedDigit="true" width="<%= FOLDER.legendShare %>" alignment="trailing" />
          </HStack>
          <% end %>
        </VStack>
      </GroupBox>
      <% end %>
      <% if incomplete then %>
      <%- partial("Footnote.etlua", {text = "Some folders could not be read, so sizes are a lower bound. Full Disk Access lets Diskmap measure folders macOS protects."}) %>
      <% end %>
      <% if hidden then %>
      <%- partial("Footnote.etlua", {text = hidden}) %>
      <% end %>
    </VStack>
  <% if style ~= "rectangles" then %></HSplit><% else %></HStack><% end %>
  <% end %>
</VStack>
