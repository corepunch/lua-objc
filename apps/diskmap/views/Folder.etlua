<%
  local FOLDER = { chart = 360, hole = 0.3, gap = 5, depth = 14, list = 300, treemapHeight = 420, legendSize = 84, legendShare = 34 }
  -- The Map page's ring fades: raised rings are told apart by their gaps and
  -- shading, and smaller items keep their folder's hue, faded further.
  local ringOpacity = { 1, 0.84, 0.68 }
  local otherFade = 0.55
%>
<VStack id="page" transition="opacity" flexGrow="1" maxWidth="infinity" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("PageHeader.etlua", {icon = "folder.fill", color = "systemBlue", title = title, summary = summary, summaryId = "folderSummary", buttons = buttons}) %>
  <% if state == "empty" then %>
  <ContentUnavailable id="folderEmpty" title="Drop a Folder Here" systemImage="folder.badge.plus" description="Drag a folder or a disk from the Finder onto this window or onto Diskmap in the Dock, or choose File › Open Folder…, to see everything in it by size." maxWidth="infinity" flexGrow="1" />
  <% elseif state == "scanning" then %>
  <VStack id="folderScanning" flexGrow="1" maxWidth="infinity" maxHeight="infinity" spacing="10" alignment="center">
    <Spacer />
    <ProgressView id="folderSpinner" />
    <Label id="folderProgress" text="<%= progress %>" size="13" color="secondary" monospacedDigit="true" lines="1" truncation="middle" />
    <Spacer />
  </VStack>
  <% elseif state == "failed" then %>
  <ContentUnavailable id="folderFailed" title="Could Not Measure This Folder" systemImage="exclamationmark.triangle" description="<%= failure %>" maxWidth="infinity" flexGrow="1" />
  <% else %>
  <HStack id="folderBar" maxWidth="infinity" spacing="6" alignment="center">
    <% for index, step in ipairs(trail) do %>
    <% if index > 1 then %><SystemImage name="chevron.right" size="10" color="tertiary" /><% end %>
    <% if index < #trail then %>
    <Button title="<%= step.name %>" style="link" size="13" action="focus_<%= index %>" help="Show <%= step.name %>" />
    <% else %>
    <Label id="folderFocus" text="<%= step.name %>" size="13" weight="semibold" lines="1" truncation="middle" />
    <% end %>
    <% end %>
    <% if loadingDeeper then %><ProgressView id="folderDeeper" /><Label id="folderProgress" text="<%= progress %>" size="12" color="secondary" lines="1" truncation="middle" /><% end %>
    <Spacer />
    <Picker id="folderColoring" style="segmented" value="<%= colorIndex %>" onChange="coloring" help="Color the map by folder, by kind of file or by when files were last used">
      <% for _, coloring in ipairs(colorings) do %>
      <Option title="<%= coloring.title %>" />
      <% end %>
    </Picker>
    <Picker id="folderStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="style">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </HStack>
  <HStack id="folderBody" flexGrow="1" maxWidth="infinity" maxHeight="infinity" spacing="16" alignment="top">
    <GroupBox width="<%= FOLDER.list %>" maxHeight="infinity">
      <List id="folderList" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxWidth="infinity" maxHeight="infinity">
        <Column id="name" title="Item" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
        <Column id="size" title="Size" width="92" minWidth="80" levelKey="relative" levelColorKey="color" />
      </List>
    </GroupBox>
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="folderNothing" title="Nothing Here Takes Space" systemImage="folder" description="This folder is empty, or everything in it is smaller than the map can show." maxWidth="infinity" flexGrow="1" />
      <% elseif style == "rectangles" then %>
      <Treemap id="folderTreemap" transition="opacity" maxWidth="infinity" height="<%= FOLDER.treemapHeight %>" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="false" />
        <% end %>
      </Treemap>
      <% else %>
      <SectorChart id="folderSunburst" transition="opacity" width="<%= FOLDER.chart %>" height="<%= FOLDER.chart %>" innerRadius="<%= FOLDER.hole %>" angularInset="<%= FOLDER.gap %>" depth="<%= FOLDER.depth %>" shadow="false" onSelect="chartSelect" onHover="chartHover" onCenter="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <SectorMark id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" opacity="<%= (ringOpacity[node.ring] or 0.5) * (node.other and node.parent and otherFade or 1) %>" label="<%= node.label %>" />
        <% end %>
        <VStack spacing="0" alignment="center">
          <Label text="<%= total %>" size="17" weight="semibold" design="rounded" monospacedDigit="true" />
          <Label text="<%= #trail > 1 and "Click to go up" or "Measured" %>" size="10" color="secondary" />
        </VStack>
      </SectorChart>
      <% end %>
      <Label id="folderHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="1" truncation="middle" />
      <% if #legend > 0 then %>
      <GroupBox id="folderLegend" maxWidth="infinity">
        <VStack maxWidth="infinity" padding="10" spacing="6" alignment="leading">
          <% for _, item in ipairs(legend) do %>
          <HStack key="legend-<%= item.id %>" maxWidth="infinity" spacing="6" alignment="center">
            <SystemImage name="circle.fill" size="9" color="<%= item.color %>" />
            <Label text="<%= item.name %>" size="12" lines="1" />
            <Spacer />
            <Label text="<%= item.size %>" size="12" monospacedDigit="true" width="<%= FOLDER.legendSize %>" alignment="trailing" lines="1" />
            <Label text="<%= item.share %>" size="11" color="secondary" monospacedDigit="true" width="<%= FOLDER.legendShare %>" alignment="trailing" />
          </HStack>
          <% end %>
        </VStack>
      </GroupBox>
      <% end %>
      <% if incomplete then %>
      <%- partial("Footnote.etlua", {text = "Some folders could not be read, so sizes are a lower bound. Full Disk Access lets Diskmap measure folders macOS protects."}) %>
      <% end %>
      <% if hidden then %>
      <%- partial("Footnote.etlua", {text = hidden}) %>
      <% end %>
    </VStack>
  </HStack>
  <% end %>
</VStack>
