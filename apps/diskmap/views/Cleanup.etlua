<%
  --[[ Every section is always present; the controller hides empty ones. ]]
  local SECTIONS = {
    {id = "rebuildable", title = "Rebuildable", detail = "Caches and build data their owners regenerate. Review, then clear."},
    {id = "review", title = "Needs review", detail = "Large enough to look at. Size alone never makes data disposable."},
    {id = "elsewhere", title = "More places to look", detail = "Individual files and apps, from Large Files and Applications."},
    {id = "checked", title = "Checked and within limits", detail = "Known space hogs measured below their review threshold, or kept."},
  }
%>
<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = "sparkles", color = "systemIndigo", title = "Clean Up", summary = ""}) %>
    <HStack id="stats" maxWidth="infinity" spacing="12" alignment="top">
      <%- partial("StatTile.etlua", {id = "rebuildableTile", icon = "arrow.triangle.2.circlepath", color = "systemGreen", title = "Rebuildable", value = "—", detail = "Regenerated by their owners"}) %>
      <%- partial("StatTile.etlua", {id = "reviewTile", icon = "eye.fill", color = "systemOrange", title = "To review", value = "—", detail = "Large, but may hold your work"}) %>
      <%- partial("StatTile.etlua", {id = "checkedTile", icon = "checklist", color = "systemBlue", title = "Checked", value = "—", detail = "Known space hogs on this Mac"}) %>
    </HStack>
    <% for _, section in ipairs(SECTIONS) do %>
    <VStack id="section_<%= section.id %>" maxWidth="infinity" spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = section.title, detail = section.detail, detailId = "detail_" .. section.id}) %>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "list_" .. section.id, menu = "menu_" .. section.id, activate = "open_" .. section.id, header = false, detailTitle = "Status"}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <VStack id="tips" maxWidth="infinity" spacing="0" />
  </VStack>
</ScrollView>
