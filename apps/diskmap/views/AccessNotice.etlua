<% --[[ Shown on the Overview when the last scan could not read some folders
  and Full Disk Access is off (#52): which folders, and the way to fix it. ]] %>
<% if #unreadable.paths > 0 then %>
<GroupBox id="accessCard" maxWidth="infinity">
  <HStack maxWidth="infinity" padding="14" spacing="12" alignment="top">
    <SystemImage name="lock.fill" size="20" color="systemOrange" />
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="4" alignment="leading">
      <Label text="Diskmap could not read some folders" size="13" weight="semibold" maxWidth="infinity" lines="0" />
      <% for _, path in ipairs(unreadable.paths) do %>
      <Label text="<%= path %>" size="11" color="secondary" maxWidth="infinity" lines="1" truncation="middle" />
      <% end %>
      <% if unreadable.more > 0 then %>
      <Label id="accessMore" text="and <%= unreadable.moreText %> more" size="11" color="secondary" />
      <% end %>
      <Label text="Their sizes are missing from the totals. Full Disk Access lets Diskmap measure them." size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
    <Button id="grantAccess" title="Open Full Disk Access Settings…" action="grantAccess" />
  </HStack>
</GroupBox>
<% else %>
<VStack id="accessEmpty" hidden="true" />
<% end %>
