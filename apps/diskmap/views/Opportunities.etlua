<VStack fillWidth="true" spacing="14" alignment="leading">
          <% for i, suggestion in ipairs(suggestions) do %>
          <%- partial("Suggestion.etlua", {suggestion = suggestion, index = i}) %>
          <Divider />
          <% end %>
          <% if #suggestions == 0 then %>
          <Label text="No measured cleanup candidates yet. Measurements update after each complete scan." size="12" color="secondary" fillWidth="true" lines="3" />
          <% end %>

</VStack>
