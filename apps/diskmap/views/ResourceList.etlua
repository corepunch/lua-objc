<% --[[ One list presentation for every page that ranks storage: icon, name
  and where it lives, an optional detail column, a share bar, the size, and a
  "More" button that opens the row's actions. Like SwiftUI's List it has no
  column headers: section titles say what the rows are, and detail values
  name themselves ("Used 3 days ago", "4 copies"). The list never scrolls on
  its own; the page scrolls as one surface. `status = true` turns the detail
  column into one colour-coded symbol per row (models/Status.lua); the status
  word remains its tooltip and accessibility label. The size column fits
  "≥ 999.9 MB", and a spinner with "Calculating…". The share
  bar keeps most of the Overview's width. Fixed columns total at most 415 points so
  the name keeps 180 points in the narrowest window's 595-point list. ]]
  local COLUMNS = { name = 180, detail = 130, status = 48, share = 135, size = 110, more = 40, statusSymbol = 20 }
%>
<List id="<%= id %>" rowMenu="<%= menu %>" dragKey="path"<% if activate then %> onActivate="<%= activate %>"<% end %> scrollDisabled="true" drawsBackground="false" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="44" maxWidth="infinity">
  <Column id="name" title="Name" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon"<% if fileIcons then %> fileIconKey="fileIcon"<% end %> imageSize="28" minWidth="<%= COLUMNS.name %>" />
  <% if status then %>
  <Column id="detail" title="Status" width="<%= COLUMNS.status %>" minWidth="<%= COLUMNS.status %>" imageKey="statusIcon" imageColorKey="statusColor" imageSize="<%= COLUMNS.statusSymbol %>" labelStyle="iconOnly" />
  <% elseif detailColumn then %>
  <Column id="detail" title="Detail" width="<%= COLUMNS.detail %>" minWidth="<%= COLUMNS.detail %>" />
  <% end %>
  <Column id="shareText" title="Share" width="<%= COLUMNS.share %>" minWidth="<%= COLUMNS.share %>" levelKey="relative" levelColorKey="color" />
  <Column id="size" title="On disk" width="<%= COLUMNS.size %>" minWidth="<%= COLUMNS.size %>" alignment="trailing" loadingKey="calculating" />
  <Column id="more" title="" width="<%= COLUMNS.more %>" minWidth="<%= COLUMNS.more %>" buttonSymbol="ellipsis.circle" buttonMenu="true" />
</List>
