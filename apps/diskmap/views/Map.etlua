<%
  local MAP = { minChart = 200, minPane = 300, chartUnits = 360, minimumHole = 0.3, ring = 0.7 / 3, center = { total = 24, caption = 12, totalScale = 12 / 24, captionScale = 0.77 }, gap = 3, corner = 6, list = { minimum = 300, maximum = 330 }, meter = 130 }
  -- Every ring keeps the thickness it has among three, so one ring of
  -- files is a slim ring like the Overview donut, not a thick disc.
  local rings = 1
  for _, node in ipairs(nodes) do rings = math.max(rings, node.ring or 1) end
  local hole = math.max(MAP.minimumHole, 1 - rings * MAP.ring)
  -- Outer rings fade so the contents of a sector read as part of it, not as
  -- separate items in the same hue.
  local ringOpacity = { 1, 0.72, 0.5 }
  -- Smaller items folded under a parent take its hue, faded further.
  local otherFade = 0.55
%>
<% --[[ "Worth a look" sits under the list beside the rings, so the rings
  keep the pane's height, and under the rectangles when there is no list. ]]
  local function worthBox()
    if #worth == 0 then return end
%>
      <GroupBox maxWidth="infinity">
        <VStack padding="10" spacing="6" alignment="leading">
          <Label text="Worth a look" systemImage="sparkle.magnifyingglass" size="12" weight="semibold" color="secondary" />
          <% for index, item in ipairs(worth) do %>
          <HStack spacing="8" alignment="center">
            <Label text="<%= item.name %>" size="12" flexGrow="1" flexShrink="1" lines="1" />
            <Label text="<%= item.size %>" size="12" color="secondary" monospacedDigit="true" />
            <Button id="worthMark_<%= index %>" title="<%= item.included and "Included · Review…" or item.marked and "Marked" or "Mark" %>" systemImage="<%= item.included and "folder.badge.checkmark" or item.marked and "checkmark.circle.fill" or "plus.circle" %>" style="plain" action="worth_<%= index %>" help="<%= item.included and "Included through a marked folder; review its cleanup plan" or "Mark " .. item.name .. " for cleanup" %>" disabled="<%= item.markable and "false" or "true" %>" />
          </HStack>
          <% end %>
        </VStack>
      </GroupBox>
<% end %>
<VStack id="page" transition="opacity" flexGrow="1" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("PageHeader.etlua", {header = header, summary = subtitle, summaryId = "mapSummary"}) %>
  <HStack id="mapBar" spacing="6" alignment="center">
    <% for index, step in ipairs(trail) do %>
    <% if index > 1 then %><SystemImage name="chevron.right" size="10" color="tertiary" /><% end %>
    <% if index < #trail then %>
    <Button title="<%= step.name %>" style="link" size="13" action="focus_<%= index %>" help="Show <%= step.name %>" />
    <% else %>
    <Label id="mapFocus" text="<%= step.name %>" size="13" weight="semibold" lines="1" />
    <% end %>
    <% end %>
    <Spacer />
    <Picker id="mapStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="style">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </HStack>
  <HStack id="mapBody" flexGrow="1" maxHeight="infinity" spacing="16" alignment="top">
    <% --[[ Rectangles already name every item, so the list serves the rings
      only. It gives way before the chart does: in the narrowest window it
      keeps its name and share columns, and the chart its size. ]] %>
    <% if style ~= "rectangles" then %>
    <VStack minWidth="<%= MAP.list.minimum %>" maxWidth="<%= MAP.list.maximum %>" flexGrow="1" flexShrink="1" maxHeight="infinity" spacing="12">
    <GroupBox maxWidth="infinity" maxHeight="infinity">
      <VStack maxHeight="infinity" spacing="0">
        <% if #rows == 0 and query ~= "" then %>
        <ContentUnavailable id="mapNoResults" title="No Results" systemImage="magnifyingglass" description="Nothing at this level of the map matches “<%= query %>”." />
        <% end %>
        <List id="mapList" hidden="<%= #rows == 0 and query ~= "" and "true" or "false" %>" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxHeight="infinity">
          <Column id="name" title="Item" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
          <Column id="size" title="Size" width="<%= MAP.meter %>" minWidth="<%= MAP.meter %>">
            <%- partial("cells/Meter.etlua") %>
          </Column>
        </List>
      </VStack>
    </GroupBox>
    <% worthBox() %>
    </VStack>
    <% end %>
    <% --[[ The rings scale to the pane, as on the Folder Map, so a small
      window shrinks them instead of scrolling them out of view. ]] %>
    <VStack id="mapChartPane" flexGrow="1" flexBasis="0" flexShrink="1" minWidth="<%= MAP.minPane %>" maxWidth="infinity" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="mapEmpty" title="Nothing Measured Here Yet" systemImage="chart.pie" description="Sizes appear as Diskmap measures this part of your storage." />
      <% elseif style == "rectangles" then %>
      <Treemap id="treemap" transition="opacity" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="<%= node.hatched and "true" or "false" %>" />
        <% end %>
      </Treemap>
      <% else %>
      <% -- Looking inside a group, or back out, turns the rings to the new level. %>
      <VStack id="mapChartHost" flexGrow="1" flexBasis="0" flexShrink="1" minHeight="<%= MAP.minChart %>" maxWidth="infinity" maxHeight="infinity" alignment="center">
      <SectorChart id="sunburst" transition="opacity" animation="smooth" animationValue="<%= trail[#trail].id %>" scalable="true" diameter="<%= MAP.chartUnits %>" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" innerRadius="<%= hole %>" angularInset="<%= MAP.gap %>" onSelect="chartSelect" onHover="chartHover" onCenter="up" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <SectorMark cornerRadius="<%= MAP.corner %>" id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" opacity="<%= (ringOpacity[node.ring] or 0.5) * (node.other and node.parent and otherFade or 1) %>" label="<%= node.label %>" />
        <% end %>
        <VStack spacing="0" alignment="center">
          <Label text="<%= total %>" size="<%= MAP.center.total %>" minimumScaleFactor="<%= MAP.center.totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
          <Label text="<%= #trail > 1 and "Click to go up" or "Measured" %>" size="<%= MAP.center.caption %>" minimumScaleFactor="<%= MAP.center.captionScale %>" lines="1" color="secondary" />
        </VStack>
      </SectorChart>
      </VStack>
      <% end %>
      <Label id="mapHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="0" />
      <% if style == "rectangles" then worthBox() end %>
    </VStack>
  </HStack>
</VStack>
