<%
  local MAP = { chart = 360, hole = 0.3, gap = 5, depth = 14, list = 300, treemapHeight = 420 }
  -- Raised rings are already told apart by their gaps and shading, so outer
  -- rings fade only a little.
  local ringOpacity = { 1, 0.84, 0.68 }
  -- Smaller items folded under a parent take its hue, faded further.
  local otherFade = 0.55
%>
<VStack id="page" transition="opacity" flexGrow="1" maxWidth="infinity" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("PageHeader.etlua", {icon = "circle.circle.fill", color = "systemIndigo", title = "Map", summary = subtitle, summaryId = "mapSummary"}) %>
  <HStack id="mapBar" maxWidth="infinity" spacing="6" alignment="center">
    <% for index, step in ipairs(trail) do %>
    <% if index > 1 then %><SystemImage name="chevron.right" size="10" color="tertiary" /><% end %>
    <% if index < #trail then %>
    <Button title="<%= step.name %>" style="link" size="13" action="focus_<%= index %>" help="Show <%= step.name %>" />
    <% else %>
    <Label id="mapFocus" text="<%= step.name %>" size="13" weight="semibold" lines="1" />
    <% end %>
    <% end %>
    <Spacer />
    <Picker id="mapStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="style">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </HStack>
  <HStack id="mapBody" flexGrow="1" maxWidth="infinity" maxHeight="infinity" spacing="16" alignment="top">
    <GroupBox width="<%= MAP.list %>" maxHeight="infinity">
      <List id="mapList" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxWidth="infinity" maxHeight="infinity">
        <Column id="name" title="Item" subtitleKey="size" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
        <Column id="shareText" title="Share" width="92" minWidth="80" levelKey="relative" levelColorKey="color" />
      </List>
    </GroupBox>
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="mapEmpty" title="Nothing Measured Here Yet" systemImage="chart.pie" description="Sizes appear as Diskmap measures this part of your storage." maxWidth="infinity" flexGrow="1" />
      <% elseif style == "rectangles" then %>
      <Treemap id="treemap" transition="opacity" maxWidth="infinity" height="<%= MAP.treemapHeight %>" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="<%= node.hatched and "true" or "false" %>" />
        <% end %>
      </Treemap>
      <% else %>
      <SectorChart id="sunburst" transition="opacity" width="<%= MAP.chart %>" height="<%= MAP.chart %>" innerRadius="<%= MAP.hole %>" angularInset="<%= MAP.gap %>" depth="<%= MAP.depth %>" shadow="false" onSelect="chartSelect" onHover="chartHover" onCenter="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <SectorMark id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" opacity="<%= (ringOpacity[node.ring] or 0.5) * (node.other and node.parent and otherFade or 1) %>" label="<%= node.label %>" />
        <% end %>
        <VStack spacing="0" alignment="center">
          <Label text="<%= total %>" size="17" weight="semibold" design="rounded" monospacedDigit="true" />
          <Label text="<%= #trail > 1 and "Click to go up" or "Measured" %>" size="10" color="secondary" />
        </VStack>
      </SectorChart>
      <% end %>
      <Label id="mapHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="1" truncation="middle" />
      <% if #worth > 0 then %>
      <GroupBox maxWidth="infinity">
        <VStack maxWidth="infinity" padding="10" spacing="6" alignment="leading">
          <Label text="Worth a look" systemImage="sparkle.magnifyingglass" size="12" weight="semibold" color="secondary" />
          <% for index, item in ipairs(worth) do %>
          <HStack maxWidth="infinity" spacing="8" alignment="center">
            <Label text="<%= item.name %>" size="12" flexGrow="1" flexShrink="1" lines="1" />
            <Label text="<%= item.size %>" size="12" color="secondary" monospacedDigit="true" />
            <Button id="worthMark_<%= index %>" title="<%= item.marked and "Marked" or "Mark" %>" systemImage="<%= item.marked and "checkmark.circle.fill" or "plus.circle" %>" style="plain" action="worth_<%= index %>" help="Mark <%= item.name %> for cleanup" disabled="<%= item.markable and "false" or "true" %>" />
          </HStack>
          <% end %>
        </VStack>
      </GroupBox>
      <% end %>
    </VStack>
  </HStack>
</VStack>
