<Sheet width="620" height="480">
  <VStack maxHeight="infinity" padding="16" spacing="8">
    <Label text="<%= title %>" size="15" weight="semibold" maxWidth="infinity" />
    <SearchField id="search" placeholder="Search" accessibilityLabel="Search SDKs" onChange="search" defaultFocus="true" />
    <List id="rows" style="inset" header="false" alternatingRows="false" rowHeight="44" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
      <Column id="name" title="SDK" subtitleKey="platform" minWidth="180" />
      <Column id="size" title="On disk" width="120" minWidth="100" alignment="trailing" />
    </List>
    <Label id="status" text="Reading SDK folders…" size="11" color="secondary" maxWidth="infinity" lines="1" />
    <HStack spacing="10">
      <Spacer />
      <Button id="done" title="Done" action="done" keyboardShortcut="defaultAction" />
    </HStack>
  </VStack>
</Sheet>
