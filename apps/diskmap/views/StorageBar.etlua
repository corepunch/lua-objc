<GroupBox id="storageSummary" maxWidth="infinity">
<VStack maxWidth="infinity" padding="8" spacing="6" alignment="leading">
  <% if #segments > 0 then %>
  <HStack maxWidth="infinity" height="16" spacing="1" cornerRadius="5" clipsToBounds="true">
    <% for _, segment in ipairs(segments) do %>
    <% if segment.bytes > 0 then %>
    <VStack flexBasis="0" flexGrow="<%= segment.weight %>" flexShrink="1" height="16" background="<%= segment.color %>" />
    <% end %>
    <% end %>
  </HStack>
  <FlowStack id="legend" maxRows="1" maxWidth="infinity" spacing="12">
    <% for _, segment in ipairs(legend) do %>
    <HStack spacing="6" alignment="center">
      <SystemImage name="circle.fill" size="9" color="<%= segment.color %>" />
      <Button title="<%= segment.name %>" style="link" size="11" action="category_<%= segment.id %>" />
    </HStack>
    <% end %>
  </FlowStack>
  <Label text="Not attributed can include unreadable files, snapshots and filesystem accounting differences; it is not a cleanup estimate." size="11" color="secondary" maxWidth="infinity" lines="2" />
  <% else %>
  <Label text="<%= explanation %>" size="12" color="secondary" maxWidth="infinity" lines="2" />
  <% end %>
</VStack>
</GroupBox>
