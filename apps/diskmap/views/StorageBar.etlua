<VStack fillWidth="true" spacing="10" alignment="leading">
  <% if #segments > 0 then %>
  <HStack fillWidth="true" fixedHeight="16" spacing="1" cornerRadius="5" clipsToBounds="true">
    <% for _, segment in ipairs(segments) do %>
    <% if segment.bytes > 0 then %>
    <VStack flexBasis="0" flexGrow="<%= segment.weight %>" flexShrink="1" fixedHeight="16" background="<%= segment.color %>" />
    <% end %>
    <% end %>
  </HStack>
  <HStack fillWidth="true" spacing="12" alignment="center">
    <% for _, segment in ipairs(segments) do %>
    <HStack spacing="6" alignment="center">
      <SystemImage name="circle.fill" size="9" color="<%= segment.color %>" />
      <Button title="<%= segment.name %>" style="link" action="category_<%= segment.id %>" />
    </HStack>
    <% end %>
  </HStack>
  <% else %>
  <Label text="<%= explanation %>" size="12" color="secondary" fillWidth="true" lines="2" />
  <% end %>
</VStack>
