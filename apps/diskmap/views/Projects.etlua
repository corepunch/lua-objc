<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="20" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = "folder.fill.badge.gearshape", color = "systemOrange", title = "Projects", summary = summary, summaryId = "projectsSummary",
      buttons = {{id = "addFolder", title = "Add Folder…", systemImage = "plus", action = "addFolder", help = "Search another folder for projects"}}}) %>
    <VStack maxWidth="infinity" spacing="8" alignment="leading">
      <HStack maxWidth="infinity" spacing="12" alignment="center">
        <%- partial("SectionHeader.etlua", {title = "Build folders", detail = roots, detailId = "projectRoots"}) %>
        <Picker id="projectFilter" style="segmented" onChange="filter">
          <% for _, title in ipairs(filters) do %><Option title="<%= title %>" /><% end %>
        </Picker>
        <Button id="markStale" title="Mark Untouched Clean Projects" systemImage="plus.circle" action="markStale" help="Mark build data of projects with a clean git tree, untouched for three months" disabled="true" />
      </HStack>
      <ContentUnavailable id="projectsEmpty" title="No Build Folders Found" systemImage="folder.badge.gearshape" description="Projects appear here once Diskmap finds node_modules, target, .build and similar folders beside their project files." maxWidth="infinity" />
      <GroupBox id="projectsList" maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "projects", menu = "menu", activate = "reveal", header = true, nameTitle = "Project", detailTitle = "Git", sizeTitle = "Build data"}) %>
      </GroupBox>
    </VStack>
    <%- partial("Footnote.etlua", {text = "Only folders a project's tools create (node_modules, target, .build, …) are listed. Projects with uncommitted or unpushed work are never marked in bulk."}) %>
  </VStack>
</ScrollView>
