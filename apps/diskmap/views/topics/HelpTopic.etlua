<VStack id="help_<%= topic.id %>" padding="12" spacing="6" alignment="leading">
  <SymbolRow name="<%= topic.icon %>" size="18" color="accent">
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="1" alignment="leading">
      <Label text="<%= topic.title %>" size="13" weight="semibold" maxWidth="infinity" lines="1" />
      <Label text="<%= topic.summary %>" size="12" color="secondary" maxWidth="infinity" lines="2" />
    </VStack>
    <% if topic.link then %>
    <Button id="link_<%= topic.id %>" title="<%= topic.link %>" style="link" action="open_<%= topic.id %>" />
    <% end %>
  </SymbolRow>
  <% if topic.steps ~= "" or topic.note then %>
  <Disclosure id="steps_<%= topic.id %>" label="<%= topic.id == "shortcuts" and "Shortcuts" or "How to" %>" expanded="<%= expanded and "true" or "false" %>" spacing="8">
    <% if topic.steps ~= "" then %>
    <Label text="<%= topic.steps %>" size="12" maxWidth="infinity" lines="0" />
    <% end %>
    <% if topic.note then %>
    <Label text="<%= topic.note %>" systemImage="info.circle" size="12" color="secondary" maxWidth="infinity" lines="0" />
    <% end %>
  </Disclosure>
  <% end %>
</VStack>
