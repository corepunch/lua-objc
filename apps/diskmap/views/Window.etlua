<Window title="Diskmap" width="1024" height="768" minWidth="1000" minHeight="640" sidebarWidth="180">
  <Toolbar>
    <ToolbarItem id="toggleSidebar" />
    <ToolbarItem id="drive" label="Storage" bordered="false">
      <HStack ref="toolbarTitle" spacing="10" alignment="center">
        <SystemImage name="internaldrive" size="22" color="secondary" />
        <VStack spacing="2" alignment="leading">
          <Label text="Diskmap" size="15" weight="semibold" lines="1" />
          <Label ref="capacity" text="<%= capacity %>" size="11" color="secondary" fillWidth="true" lines="1" />
        </VStack>
      </HStack>
    </ToolbarItem>
    <ToolbarItem id="NSToolbarFlexibleSpaceItem" />
    <ToolbarItem id="refresh" label="Refresh" icon="arrow.clockwise" />
    <ToolbarItem id="cancel" label="Cancel" icon="xmark.circle" />
    <ToolbarItem id="search" label="Search">
      <SearchField ref="search" placeholder="Search categories, resources or paths…" fixedWidth="265" accessibilityLabel="Search categories, resources or paths" onChange="search" />
    </ToolbarItem>
  </Toolbar>
</Window>
