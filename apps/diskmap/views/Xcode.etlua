<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = "hammer.circle.fill", color = "systemBlue", title = "Xcode", summary = "Reading Xcode's device support, build data and archives…", summaryId = "xcodeSummary",
      buttons = {{id = "openOrganizer", title = "Open Xcode", action = "openXcode", help = "Manage archives in Xcode's Organizer"}}}) %>
    <% for _, section in ipairs(sections) do %>
    <VStack id="<%= section.id %>Section" maxWidth="infinity" spacing="8" alignment="leading">
      <HStack maxWidth="infinity" spacing="12" alignment="center">
        <%- partial("SectionHeader.etlua", {title = section.title, detail = section.detail}) %>
        <% if section.bulkTitle then %>
        <Button id="bulk_<%= section.id %>" title="<%= section.bulkTitle %>" systemImage="plus.circle" action="bulk_<%= section.id %>" help="<%= section.bulkHelp %>" disabled="true" />
        <% end %>
      </HStack>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "list_" .. section.id, menu = "menu_" .. section.id, activate = "reveal_" .. section.id, header = true, nameTitle = section.column, status = section.status, detailTitle = section.detailTitle}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <%- partial("Footnote.etlua", {text = "Open a row's menu to mark it for cleanup. Marked items move to the Trash only after you review them in Marked Items."}) %>
  </VStack>
</ScrollView>
