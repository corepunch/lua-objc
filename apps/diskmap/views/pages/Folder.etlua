<%
  local FOLDER = { minChart = 160, chartUnits = 300, minimumHole = 0.3, ring = 0.7 / 3, center = { total = 24, caption = 12, totalScale = 12 / 24, captionScale = 0.77 }, gap = 3, corner = 6, list = 340, minList = 260, minPane = 320, meter = 130, legendSize = 84, legendShare = 34 }
  local buttons = {{id = "openFolder", title = "Open Folder…", systemImage = "folder", action = "openFolder", help = "Choose a folder or disk to measure"}}
  if hasPath then
    table.insert(buttons, measuring and {id = "stop", title = "Stop", systemImage = "stop.circle", action = "stop", help = "Stop measuring"}
      or {id = "rescan", title = "Measure Again", systemImage = "arrow.clockwise", action = "rescan", help = "Measure this folder again"})
  end
%>
<VStack id="page" flexGrow="1" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("../components/PageHeader.etlua", {header = {icon = page.icon, color = page.color, title = title}, summary = summary, summaryId = "folderSummary", buttons = buttons}) %>
  <% if state == "empty" then %>
  <ContentUnavailable id="folderEmpty" descriptionAlignment="leading" title="Drop a Folder Here" systemImage="folder.badge.plus" description="Drag a folder or a disk from the Finder onto this window or onto Diskmap in the Dock, or choose File › Open Folder…, to see everything in it by size." />
  <% elseif state == "scanning" then %>
  <VStack id="folderScanning" flexGrow="1" maxHeight="infinity" spacing="10" alignment="center">
    <Spacer />
    <ProgressView id="folderSpinner" />
    <Label id="folderProgress" text="<%= progress %>" size="13" color="secondary" monospacedDigit="true" lines="1" truncation="middle" />
    <Spacer />
  </VStack>
  <% elseif state == "failed" then %>
  <ContentUnavailable id="folderFailed" title="Could Not Measure This Folder" systemImage="exclamationmark.triangle" description="<%= failure %>" />
  <% else %>
  <Breadcrumb id="folderBar">
    <% for index, step in ipairs(trail) do %>
    <Crumb name="<%= step.name %>" action="focus_<%= index %>" current="<%= index == #trail and "true" or "false" %>" />
    <% end %>
    <Spacer />
    <Picker id="folderColoring" style="segmented" value="<%= colorIndex %>" onChange="pickColoring" help="Color the map by folder, by kind of file or by when files were last used">
      <% for _, coloring in ipairs(colorings) do %>
      <Option title="<%= coloring.title %>" />
      <% end %>
    </Picker>
    <Picker id="folderStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="pickStyle">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </Breadcrumb>
  <% --[[ Rings: the list and the chart share a native split view, so the divider
    moves and the wheel follows. Rectangles already name every item, so the
    treemap takes the whole body and there is no list. ]] %>
  <% if style ~= "rectangles" then %>
  <HSplit id="folderBody" flexGrow="1" maxHeight="infinity" maxWidth="infinity">
    <GroupBox width="<%= FOLDER.list %>" minWidth="<%= FOLDER.minList %>" maxHeight="infinity">
      <List id="folderList" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxHeight="infinity">
        <Column id="name" title="Item" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
        <Column id="shareText" title="Size" width="<%= FOLDER.meter %>" minWidth="<%= FOLDER.meter %>" levelKey="relative" levelColorKey="color" valueKey="size" loadingKey="calculating" imageKey="sizeIcon" imageColorKey="sizeColor" />
      </List>
    </GroupBox>
  <% else %>
  <HStack id="folderBody" flexGrow="1" maxHeight="infinity" maxWidth="infinity" spacing="16" alignment="top">
  <% end %>
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" minWidth="<%= FOLDER.minPane %>" maxWidth="infinity" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="folderNothing" title="Nothing Here Takes Space" systemImage="folder" description="This folder is empty, or everything in it is smaller than the map can show." />
      <% elseif style == "rectangles" then %>
      <Treemap id="folderTreemap" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="false" />
        <% end %>
      </Treemap>
      <% else %>
      <% -- Looking inside a group, or back out, turns the rings to the new level. %>
      <VStack id="folderChartHost" flexGrow="1" flexBasis="0" flexShrink="1" minHeight="<%= FOLDER.minChart %>" maxWidth="infinity" maxHeight="infinity" alignment="center">
      <StorageRings id="folderSunburst" diameter="<%= FOLDER.chartUnits %>" onSelect="chartSelect" onHover="chartHover" onCenter="up" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <StorageSector id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" other="<%= node.other and "true" or "false" %>" label="<%= node.label %>" />
        <% end %>
        <ChartCenter total="<%= total %>" caption="<%= #trail > 1 and "Click to go up" or "Measured" %>" />
      </StorageRings>
      </VStack>
      <% end %>
      <% -- Guidance and long paths wrap in a narrow pane rather than lose their middle. %>
      <Label id="folderHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="0" />
      <% if #legend > 0 then %>
      <GroupBox id="folderLegend">
        <VStack padding="10" spacing="6" alignment="leading">
          <% for _, item in ipairs(legend) do %>
          <LegendRow key="legend-<%= item.id %>" label="<%= item.name %>" color="<%= item.color %>" sizeText="<%= item.size %>" share="<%= item.share %>" linked="false" />
          <% end %>
        </VStack>
      </GroupBox>
      <% end %>
      <% if incomplete then %>
      <%- partial("../components/Footnote.etlua", {text = "Some folders could not be read, so sizes are a lower bound. Full Disk Access lets Diskmap measure folders macOS protects."}) %>
      <% end %>
      <% if unreadable then %>
      <%- partial("../components/Footnote.etlua", {text = unreadable}) %>
      <% end %>
    </VStack>
  <% if style ~= "rectangles" then %></HSplit><% else %></HStack><% end %>
  <% end %>
</VStack>
