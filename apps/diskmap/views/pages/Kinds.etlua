<%
  -- The chart is context for the decision above it, so it stays modest, but
  -- it fills the height of the card and its center text scales with it.
  local CHART = { units = 360, minSize = 112, maxSize = 200, padding = 14, spacing = 20, hole = 0.618, inset = 1.5, corner = 5, total = 40, caption = 24, totalScale = 9 / 40, captionScale = 0.5 }
  -- The center text is set at its largest; the chart offers it the square
  -- inscribed in the hole and it shrinks to fit on one line, like the Hero.
%>
<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack padding="24" alignment="center">
  <%- partial("../components/ReadableWidth.etlua") %>
  <VStack id="pageContent" maxWidth="@readableWidth" spacing="24" alignment="leading">
    <%- partial("../components/PageHeader.etlua", {header = page, summary = summary}) %>
    <% if waiting then %>
    <ContentUnavailable id="waiting" title="<%= waiting.title %>" systemImage="<%= waiting.systemImage %>" description="<%= waiting.description %>" />
    <% else %>
    <%- partial("../sections/Decision.etlua", decision) %>
    <% if #kinds > 0 then %>
    <%- partial("../components/Footnote.etlua", {id = "scopeNote", icon = "scope", text = scope}) %>
    <GroupBox id="kindsCard">
      <HStack padding="<%= CHART.padding %>" spacing="<%= CHART.spacing %>" alignment="center">
        <SectorChart id="kindsChart" scalable="true" diameter="<%= CHART.units %>" minWidth="<%= CHART.minSize %>" maxWidth="<%= CHART.maxSize %>" minHeight="<%= CHART.minSize %>" innerRadius="<%= CHART.hole %>" angularInset="<%= CHART.inset %>" onSelect="chartSelect" onHover="chartHover" accessibilityLabel="<%= accessibilityLabel %>">
          <% for _, kind in ipairs(kinds) do %>
          <SectorMark cornerRadius="<%= CHART.corner %>" id="<%= kind.id %>" value="<%= kind.bytes %>" color="<%= kind.color %>" label="<%= kind.name %>" />
          <% end %>
          <ChartCenter id="kindsCenter" titleId="kindsTotal" detailId="kindsCaption" total="<%= center.title %>" caption="<%= center.detail %>" totalSize="<%= CHART.total %>" captionSize="<%= CHART.caption %>" totalScale="<%= CHART.totalScale %>" captionScale="<%= CHART.captionScale %>" />
        </SectorChart>
        <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="8" alignment="leading">
          <Label text="<%= headline.title %>" size="13" weight="semibold" maxWidth="infinity" lines="0" />
          <Disclosure label="What this inventory includes" expanded="false">
            <Label text="<%= inventoryNote %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
          </Disclosure>
          <Button id="showHeadline" title="Show Largest Files" style="link" action="showHeadline" />
        </VStack>
      </HStack>
    </GroupBox>
    <VStack spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Kinds", detail = "Grouped by file extension, the way Finder's Kind column groups them. Open a kind to see its largest files."}) %>
      <GroupBox>
        <%- partial("../components/ResourceList.etlua", {id = "kinds", menu = "kindMenu", selectAction = "selectKind", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <% if hasExtensions then %>
    <VStack spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Top extensions", detail = extensionsDetail}) %>
      <GroupBox>
        <%- partial("../components/ResourceList.etlua", {id = "extensions", menu = "kindMenu", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <% if #kinds > 0 then %>
    <%- partial("../components/Footnote.etlua", {text = "Totals cover every measured location, including files inside app bundles and libraries. Excluded media libraries are not counted."}) %>
    <% end %>
    <% end %>
  </VStack>
  </VStack>
</ScrollView>
