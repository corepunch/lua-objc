<% --[[ Chapters of topics to read (controllers/TopicsController.lua): the
  Storage Guide and Diskmap Help. `topic` names the template of one topic. ]] %>
<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack padding="24" alignment="center">
  <%- partial("../components/ReadableWidth.etlua") %>
  <VStack id="pageContent" maxWidth="@readableWidth" spacing="24" alignment="leading">
    <%- partial("../components/PageHeader.etlua", {header = page, summary = summary}) %>
    <% if empty then %>
    <ContentUnavailable id="noTopics" title="No Topics Found" systemImage="magnifyingglass" description="No <%= noun %> mentions “<%= query %>”." />
    <% end %>
    <% for _, chapter in ipairs(chapters) do %>
    <VStack spacing="8" alignment="leading">
      <%- partial("../components/SectionTitle.etlua", {icon = chapter.icon, title = chapter.title}) %>
      <GroupBox>
        <VStack spacing="0" alignment="leading">
          <% for index, item in ipairs(chapter.topics) do %>
          <%- partial("../" .. topic .. ".etlua", {topic = item, expanded = expandAll}) %>
          <% if index < #chapter.topics then %><Divider /><% end %>
          <% end %>
        </VStack>
      </GroupBox>
    </VStack>
    <% end %>
  </VStack>
  </VStack>
</ScrollView>
