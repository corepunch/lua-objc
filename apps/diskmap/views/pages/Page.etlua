<% --[[ The list page: every page that ranks storage in lists is this
  template and a `layout` table (pages/ListRoute.lua), so tiles, section
  titles, links and lists sit in the same places on all of them. The page
  is named by the window title, not by a heading of its own. The template carries structure only; rows, sizes and summaries are
  set in place, so scan progress does not rebuild the page under the reader.

    waiting              {title, systemImage, description}: while the scan has not
                         measured what the page lists, this empty state stands
                         in place of everything
    computing            while a request of the page's own is running: its status
                         line beside one native spinner, in place of the same
    buttons              toolbar operations: {id, title, systemImage, action, help, disabled}
    tiles                stat tiles: {id, icon, color, title, value, detail, actionTitle, action}
    empty                {id, title, systemImage, description}, in place of the sections
    sections             each {
      id                   ref of the whole section, to hide it
      collapsed            label of a disclosure that hides the list until opened
      title, detail        its heading; titleId and detailId name their refs
      sizeId               ref of a total beside the heading
      links                leading link actions above the list
      controlsId           optional ref for the links row
      buttons              section operations promoted to the window toolbar
      empties              {id, title, systemImage, description, hidden}
      panelId              ref of the box around the list
      list                 ResourceList.etlua's arguments: {id, menu, activate, …}
    }
    leads                refs for retained child templates at the top of the page:
                         the page's leading decision (Decision.etlua)
    slots                refs for retained child templates, below the sections
    contextAfterSections puts scope and statistics after the actual rows
    contextDisclosure    optional collapsed title for that accounting context
    scopeNote            initial text of the note stating what the totals cover (helpers/Scope.lua)
    footnote             {text, icon} ]] %>
<ContentPage id="page">
    <% if waiting then %>
    <ContentUnavailable id="waiting" title="<%= waiting.title %>" systemImage="<%= waiting.systemImage %>" description="<%= waiting.description %>" />
    <% elseif computing then %>
    <HStack id="computing" spacing="10" alignment="center">
      <ProgressView controlSize="small" />
      <Label id="computingStatus" text="<%= computing %>" size="13" color="secondary" lines="1" />
    </HStack>
    <% else %>
    <% for _, slot in ipairs(layout.leads or {}) do %>
    <VStack id="<%= slot %>" spacing="0" alignment="leading">
      <% if children and children[slot] then %><%- partial("../" .. childViews[slot] .. ".etlua", children[slot]) %><% end %>
    </VStack>
    <% end %>
    <% if not layout.contextAfterSections then %>
    <%- partial("../sections/PageContext.etlua", {layout = layout}) %>
    <% end %>
    <% if layout.empty then %>
    <ContentUnavailable id="<%= layout.empty.id %>" title="<%= layout.empty.title %>" systemImage="<%= layout.empty.systemImage %>" description="<%= layout.empty.description %>" />
    <% end %>
    <% for _, section in ipairs(layout.sections or {}) do %>
    <VStack <% if section.id then %>id="<%= section.id %>" <% end %> spacing="8" alignment="leading">
      <% if section.title then %>
      <HStack spacing="12" alignment="<%= section.sizeId and "bottom" or "center" %>">
        <%- partial("../components/SectionHeader.etlua", {title = section.title, titleId = section.titleId, detail = section.detail or "", detailId = section.detailId}) %>
        <% if section.sizeId then %>
        <Label id="<%= section.sizeId %>" text="" size="13" weight="semibold" monospacedDigit="true" />
        <% end %>
      </HStack>
      <% end %>
      <% if section.links then %>
      <HStack <% if section.controlsId then %>id="<%= section.controlsId %>" <% end %> spacing="12" alignment="center">
        <%- partial("../components/Buttons.etlua", {buttons = section.links}) %>
        <Spacer />
      </HStack>
      <% end %>
      <% for _, empty in ipairs(section.empties or {}) do %>
      <ContentUnavailable id="<%= empty.id %>"<% if empty.hidden then %> hidden="true"<% end %> title="<%= empty.title %>" systemImage="<%= empty.systemImage %>" description="<%= texts and texts[empty.id .. "Description"] or empty.description %>" />
      <% end %>
      <% if section.collapsed then %>
      <Disclosure id="<%= section.id %>_disclosure" label="<%= section.collapsed %>" expanded="false" spacing="8">
        <GroupBox <% if section.panelId then %>id="<%= section.panelId %>" <% end %>>
          <%- partial("../components/ResourceList.etlua", section.list) %>
        </GroupBox>
      </Disclosure>
      <% else %>
      <GroupBox <% if section.panelId then %>id="<%= section.panelId %>" <% end %>>
        <%- partial("../components/ResourceList.etlua", section.list) %>
      </GroupBox>
      <% end %>
    </VStack>
    <% end %>
    <% if layout.contextAfterSections then %>
    <%- partial("../sections/PageContext.etlua", {layout = layout}) %>
    <% end %>
    <% for _, slot in ipairs(layout.slots or {}) do %>
    <VStack id="<%= slot %>" spacing="0">
      <% if children and children[slot] then %><%- partial("../" .. childViews[slot] .. ".etlua", children[slot]) %><% end %>
    </VStack>
    <% end %>
    <% if layout.footnote then %>
    <%- partial("../components/Footnote.etlua", layout.footnote) %>
    <% end %>
    <% end %>
</ContentPage>
