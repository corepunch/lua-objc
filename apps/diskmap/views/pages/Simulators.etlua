<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack padding="24" alignment="center">
  <%- partial("../components/ReadableWidth.etlua") %>
  <VStack id="pageContent" maxWidth="@readableWidth" spacing="24" alignment="leading">
    <%- partial("../components/PageHeader.etlua", {header = page, summary = summary, summaryId = "summary",
      buttons = {{id = "retry", title = "Retry", action = "retry", help = "Read simulator state and runtime information again"}, {id = "components", title = "Xcode Components…", action = "components", help = "Manage runtimes in Xcode › Settings › Components"}}}) %>
    <% if computing then %>
    <%- partial("../components/Computing.etlua", {status = computing}) %>
    <% else %>
    <VStack id="planHost" spacing="0" alignment="leading">
      <%- partial("../sections/SimulatorPlan.etlua", plan) %>
    </VStack>
    <% --[[ The inventory explains the plan; it is not a second plan. It stays
      collapsed until opened, for erasing one device, the unavailable ones or
      a runtime. ]] %>
    <Disclosure id="inventory" label="All devices and runtimes" expanded="false" spacing="16">
    <VStack id="devicesSection" spacing="8" alignment="leading">
      <HStack spacing="12" alignment="center">
        <%- partial("../components/SectionHeader.etlua", {title = "Devices", detail = devicesDetail, detailId = "devicesDetail"}) %>
        <Picker id="filter" style="segmented" value="<%= filter %>" onChange="filter">
          <% for _, title in ipairs(filters) do %><Option title="<%= title %>" /><% end %>
        </Picker>
      </HStack>
      <GroupBox>
        <InventoryList id="devices" onSelect="select" kind="devices" />
      </GroupBox>
      <HStack spacing="8" alignment="center">
        <Button id="reveal" title="Show in Finder" action="reveal" />
        <Button id="erase" title="Erase…" action="erase" />
        <Button id="delete" title="Delete…" action="delete" />
        <Spacer />
        <Button id="deleteUnavailable" title="Delete Unavailable…" action="unavailable" help="Delete every device whose runtime is gone" />
      </HStack>
      <Label id="status" text="<%= status %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
    <VStack id="runtimesSection" spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Runtimes", detail = "Each runtime is a full operating system image. Devices on a deleted runtime become unavailable.", detailId = "runtimesDetail"}) %>
      <GroupBox>
        <InventoryList id="runtimes" onSelect="selectRuntime" kind="runtimes" />
      </GroupBox>
      <HStack spacing="8" alignment="center">
        <Button id="deleteRuntime" title="Delete Runtime…" action="deleteRuntime" />
        <Spacer />
      </HStack>
      <Label id="runtimeStatus" text="<%= runtimeStatus %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
    </Disclosure>
    <% end %>
  </VStack>
  </VStack>
</ScrollView>
