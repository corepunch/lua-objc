<VStack spacing="0" flexGrow="1" flexBasis="0" flexShrink="1">
<% --[[ Leftover Git worktrees, decision first: what Git can remove now and
  what it could recover, then the linked worktrees that need a person, then
  registrations that only need pruning. The repositories they were made from
  are never offered and stay collapsed as context. Evidence and rules live in
  pages/Worktrees.lua and helpers/Worktrees.lua; this template carries structure only. ]]
  local SELECTION = {detailMaximum = 144}
  local function list(id)
%>
        <InventoryList id="<%= id %>" onSelect="select" kind="worktrees" />
<% end %>
<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack id="pageContent" spacing="24" padding="24" alignment="leading">
    <%- partial("../components/PageHeader.etlua", {header = page, summary = summary, summaryId = "summary",
      buttons = {{id = "retry", title = "Retry", action = "retry", help = "Look for worktrees again"}}}) %>
    <% if computing then %>
    <%- partial("../components/Computing.etlua", {status = computing}) %>
    <% else %>
    <VStack id="decisionHost" spacing="0" alignment="leading">
      <%- partial("../sections/Decision.etlua", decision) %>
    </VStack>
    <ContentUnavailable id="worktreesEmpty" title="No Linked Worktrees" systemImage="arrow.triangle.branch" description="No repository in your project folders has a linked worktree, so there is nothing to clean up here." />
    <VStack id="removeSection" spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Ready to remove", detailId = "removeDetail", detail = removeDetail}) %>
      <GroupBox>
<% list("removeList") %>
      </GroupBox>
    </VStack>
    <VStack id="reviewSection" spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Needs your review", detailId = "reviewDetail",
        detail = "Local changes, commits that exist only here, submodules, a recent change, a lock or Keep. Select one to read the evidence."}) %>
      <GroupBox>
<% list("reviewList") %>
      </GroupBox>
    </VStack>
    <VStack id="missingSection" spacing="8" alignment="leading">
      <HStack spacing="12" alignment="center">
        <%- partial("../components/SectionHeader.etlua", {title = "Missing", detail = "Git still lists these, but the directory is gone. Pruning forgets the record; no checkout is deleted."}) %>
        <Button id="prune" title="Prune Missing…" action="prune" help="Forget registrations whose directory is gone; existing worktrees are not touched" />
      </HStack>
      <GroupBox>
<% list("missingList") %>
      </GroupBox>
    </VStack>
    <Disclosure id="repositories" label="Repositories these worktrees come from" expanded="false" spacing="8">
      <Label text="The checkouts these worktrees were made from. A repository's own checkout is never offered and is not measured here." size="11" color="secondary" maxWidth="infinity" lines="0" />
      <GroupBox>
<% list("repositoryList") %>
      </GroupBox>
    </Disclosure>
    <%- partial("../components/Footnote.etlua", {text = "Diskmap reads each repository with git worktree list, status and rev-list, and removes only with git worktree remove, never with force. Session activity is not visible to Diskmap: In use means a process was confirmed; a worktree changed in the last few days is Recent and waits for your review. Claude and Codex worktrees are best removed by archiving their session in the app."}) %>
    <% end %>
  </VStack>
</ScrollView>

    <VStack id="selectionSection" spacing="8" padding="14" alignment="leading">
      <ScrollView id="selectionEvidence" vertical="true" maxHeight="<%= SELECTION.detailMaximum %>">
        <VStack spacing="8" alignment="leading">
      <Label id="selectedTitle" text="<%= selection and selection.title or "" %>" help="<%= selection and selection.title or "" %>" size="13" weight="semibold" maxWidth="infinity" lines="1" truncation="middle" />
      <Label id="selectedSummary" text="<%= selection and selection.summary or "" %>" size="12" maxWidth="infinity" lines="0" />
      <Disclosure label="Path and storage details" expanded="false">
        <Label id="selectedDetail" text="<%= selection and selection.detail or "" %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
      </Disclosure>
        </VStack>
      </ScrollView>
      <HStack spacing="8" alignment="center">
        <Button id="reveal" title="Show in Finder" action="reveal" />
        <Button id="keep" title="Keep" action="keep" help="Protect this worktree from every cleanup suggestion" />
        <Button id="openOwner" title="Open Owner…" action="openOwner" help="Archive managed worktrees in the application that made them" />
        <Spacer />
      </HStack>
      <Label id="status" text="<%= status %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>

</VStack>
