<% local DETAILS = {maximumHeight = 144} %>
<ContentPage id="page" dropAction="drop">
  <%- partial("../components/PageHeader.etlua", {header = page, summaryId = "reviewSummary"}) %>
  <ContentUnavailable id="basketEmpty" title="Nothing Flagged" systemImage="flag" description="Use the flag beside an item, or drop files onto this page. Review flagged items here before taking action." />
  <VStack id="basketList" maxWidth="infinity" spacing="12" alignment="leading">
    <GroupBox>
      <List id="items" onSelect="select" style="fullWidth" header="false" alternatingRows="false" rowHeight="<%= rowHeight %>" drawsBackground="false" height="<%= listHeight %>">
        <Column id="name" title="Item" subtitleKey="subtitle" minWidth="220" />
        <Column id="result" title="" width="120" minWidth="90" />
        <Column id="size" title="On disk" width="100" minWidth="90" alignment="trailing" />
      </List>
    </GroupBox>
    <ScrollView id="selectedDetails" vertical="true" maxHeight="<%= DETAILS.maximumHeight %>">
      <VStack spacing="8" alignment="leading">
        <Label id="consequence" size="12" maxWidth="infinity" lines="0" />
        <Label id="selectedPath" size="11" color="secondary" maxWidth="infinity" lines="0" />
        <Label id="selectedResult" size="11" color="secondary" maxWidth="infinity" lines="0" />
      </VStack>
    </ScrollView>
    <Label id="revalidation" text="Each item is checked just before it moves: one whose app is open, whose project file is gone or that was replaced is skipped. Nothing is deleted until you empty the Trash." size="11" color="secondary" maxWidth="infinity" lines="0" />
  </VStack>
</ContentPage>
