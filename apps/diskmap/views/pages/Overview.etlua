<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack id="pageContent" spacing="24" padding="24" alignment="leading">
    <VStack spacing="8" alignment="leading">
      <HStack spacing="12" alignment="center">
        <Button id="findLargest" title="Find Largest Locations" systemImage="list.number" action="showLargest" />
        <Button id="inspectFolder" title="Inspect a Folder" systemImage="folder" action="inspectFolder" />
      </HStack>
      <Label text="Storage Map groups known locations by category. Folder Map measures the contents of any folder." size="12" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
    <VStack id="hero" spacing="0">
      <%- partial("../sections/Hero.etlua", hero) %>
    </VStack>
    <% if measured then %>
    <VStack id="notMeasured" spacing="0" hidden="<%= #unmeasured.items == 0 %>">
      <% if #unmeasured.items > 0 then %><%- partial("../sections/NotMeasured.etlua", unmeasured) %><% end %>
    </VStack>
    <% -- An empty section takes no place in the page, so it adds no spacing. %>
    <VStack id="changes" spacing="0" hidden="<%= changes == nil %>">
      <% if changes then %><%- partial("../sections/Changes.etlua", {changes = changes}) %><% end %>
    </VStack>
    <VStack id="categoriesSection" spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = "Categories", detail = coverage, detailId = "coverage"}) %>
      <GroupBox id="categoriesPanel">
        <List id="results" onSelect="select" onActivate="open" onColumnButton="open" scrollDisabled="true" drawsBackground="false" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="44">
          <Column id="name" title="Category" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon" fileIconKey="fileIcon" imageSize="28" minWidth="200" />
          <Column id="shareText" title="On disk" width="270" minWidth="240" levelKey="relative" levelColorKey="color" valueKey="size" loadingKey="calculating" imageKey="sizeIcon" imageColorKey="sizeColor" />
          <Column id="info" title="" width="40" minWidth="40" buttonSymbol="chevron.right.circle" />
        </List>
      </GroupBox>
    </VStack>
    <VStack id="largestSection" spacing="8" hidden="<%= largestHidden %>" alignment="leading">
      <HStack spacing="8" alignment="bottom">
        <%- partial("../components/SectionHeader.etlua", {title = "Largest items", detail = "Individual resources across every category"}) %>
        <Button id="showLargest" title="Show All" style="link" action="showLargest" />
      </HStack>
      <GroupBox id="largestPanel">
        <%- partial("../components/ResourceList.etlua", {id = "largest", menu = "largestMenu", activate = "openLargest", status = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <HStack id="statusBar" spacing="12" alignment="center">
      <SystemImage name="info.circle" size="13" color="secondary" />
      <Label id="status" text="<%= status %>" size="11" color="secondary" flexGrow="1" flexBasis="0" flexShrink="1" lines="2" />
      <Button id="access" title="<%= accessTitle %>" hidden="<%= accessHidden %>" style="link" action="access" />
    </HStack>
  </VStack>
</ScrollView>
