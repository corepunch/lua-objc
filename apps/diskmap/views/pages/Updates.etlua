<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack id="pageContent" spacing="24" padding="24" alignment="leading">
    <%- partial("../components/PageHeader.etlua", {header = page,
      summary = "Storage macOS uses to download and install updates, and the restore points Time Machine keeps on this disk."}) %>
    <% if computing then %>
    <%- partial("../components/Computing.etlua", {status = computing}) %>
    <% else %>
    <%- partial("../sections/Decision.etlua", decision) %>
    <VStack spacing="8" alignment="leading">
      <%- partial("../components/SectionTitle.etlua", {icon = "gearshape.arrow.triangle.2.circlepath", title = "Software Update"}) %>
      <GroupBox>
        <%- partial("../components/GroupedRowMetrics.etlua") %>
        <VStack spacing="0" alignment="leading">
          <HStack paddingHorizontal="@groupedRowInset" paddingVertical="12" spacing="@groupedIconGap" alignment="center">
            <SystemImage name="<%= softwareUpdate.icon %>" size="18" color="<%= softwareUpdate.color %>" width="@groupedIconColumn" />
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="1" alignment="leading">
              <Label id="updateTitle" text="<%= softwareUpdate.title %>" size="13" weight="semibold" maxWidth="infinity" lines="1" />
              <Label id="updateDetail" text="<%= softwareUpdate.detail %>" size="11" color="secondary" maxWidth="infinity" lines="2" />
            </VStack>
            <Button id="openSoftwareUpdate" title="Software Update…" action="openSoftwareUpdate" />
          </HStack>
          <% for _, stage in ipairs(stages) do %>
          <Divider />
          <%- partial("../components/InfoRow.etlua", {id = "stage_" .. stage.index, icon = stage.icon, title = stage.title, detail = stage.detail, value = stage.size}) %>
          <% end %>
          <Divider />
          <Label id="updateSpaceNote" text="<%= spaceNote %>" size="11" color="secondary" padding="12" maxWidth="infinity" lines="0" />
        </VStack>
      </GroupBox>
    </VStack>
    <VStack spacing="8" alignment="leading">
      <%- partial("../components/SectionTitle.etlua", {icon = "externaldrive.badge.plus", title = "Installers & Disk Images"}) %>
      <GroupBox>
        <VStack spacing="0" alignment="leading">
          <% if #installers == 0 then %>
          <Label id="noInstallers" text="No macOS installers, disk images or installer packages found." size="12" color="secondary" padding="12" maxWidth="infinity" />
          <% end %>
          <% if #installers > 0 then %>
          <%- partial("../components/ResourceList.etlua", {id = "installers", menu = "installerMenu", activate = "revealInstaller", detailColumn = true}) %>
          <% end %>
        </VStack>
      </GroupBox>
    </VStack>
    <VStack spacing="8" alignment="leading">
      <HStack spacing="8" alignment="center">
        <%- partial("../components/SectionTitle.etlua", {id = "snapshotTitle", icon = "clock.arrow.circlepath", title = snapshotTitle}) %>
        <Button id="openTimeMachine" title="Time Machine Settings…" action="openTimeMachine" />
      </HStack>
      <GroupBox>
        <%- partial("../components/GroupedRowMetrics.etlua") %>
        <VStack spacing="0" alignment="leading">
          <% for index, snapshot in ipairs(snapshots) do %>
          <HStack paddingHorizontal="@groupedRowInset" paddingVertical="8" spacing="@groupedIconGap" alignment="center">
            <SystemImage name="clock" size="15" color="secondary" width="@groupedIconColumn" />
            <Label text="<%= snapshot.name %>" size="13" monospacedDigit="true" flexGrow="1" flexShrink="1" lines="1" />
            <Label text="<%= snapshot.id %>" size="11" design="monospaced" color="tertiary" lines="1" truncation="middle" flexShrink="1" />
          </HStack>
          <Divider />
          <% end %>
          <Label text="Snapshots keep the blocks of files you deleted since they were taken, so deleting a file may not free space at once. macOS removes them automatically when space runs low; no file scan can measure how much each one holds." size="11" color="secondary" padding="12" maxWidth="infinity" lines="0" />
        </VStack>
      </GroupBox>
    </VStack>
    <% end %>
  </VStack>
</ScrollView>
