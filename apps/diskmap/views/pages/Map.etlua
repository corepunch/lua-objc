<%
  local MAP = { minChart = 200, minPane = 300, chartUnits = 360, minimumHole = 0.3, ring = 0.7 / 3, center = { total = 24, caption = 12, totalScale = 12 / 24, captionScale = 0.77 }, gap = 3, corner = 6, meter = 130 }
%>
<% --[[ "Worth a look" sits under the list beside the rings, so the rings
  keep the pane's height, and under the rectangles when there is no list. ]]
  local function worthBox()
    if #worth == 0 then return end
%>
      <GroupBox maxWidth="infinity">
        <VStack padding="10" spacing="6" alignment="leading">
          <Label text="Worth a look" systemImage="sparkle.magnifyingglass" size="12" weight="semibold" color="secondary" />
          <% for index, item in ipairs(worth) do %>
          <HStack spacing="8" alignment="center">
            <Label text="<%= item.name %>" size="12" flexGrow="1" flexShrink="1" lines="1" />
            <Label text="<%= item.size %>" size="12" color="secondary" monospacedDigit="true" />
            <Button id="worthMark_<%= index %>" style="plain" action="worth_<%= index %>" accessibilityLabel="<%= item.markTitle %>" help="<%= item.markHelp %>" disabled="<%= item.markable and "false" or "true" %>">
              <Label text="<%= item.markTitle %>" systemImage="<%= item.markIcon %>" size="12" color="secondary" />
            </Button>
          </HStack>
          <% end %>
        </VStack>
      </GroupBox>
<% end %>
<VStack id="page" flexGrow="1" maxHeight="infinity" spacing="16" padding="24" alignment="leading">
  <%- partial("../components/PageHeader.etlua", {header = page, summary = subtitle, summaryId = "mapSummary"}) %>
  <Breadcrumb id="mapBar">
    <Button id="mapUp" title="Up" systemImage="arrow.up" action="up" disabled="<%= not canUp %>" help="Show the parent map level; Back and Forward visit pages" />
    <% for index, step in ipairs(trail) do %>
    <Crumb name="<%= step.name %>" action="focus_<%= index %>" current="<%= index == #trail and "true" or "false" %>" />
    <% end %>
    <Spacer />
    <Picker id="mapStyle" style="segmented" value="<%= style == "rectangles" and 1 or 0 %>" onChange="pickStyle">
      <Option title="Rings" />
      <Option title="Rectangles" />
    </Picker>
  </Breadcrumb>
  <Label id="mapSearchScope" text="<%= query ~= "" and ("Map list filtered by “" .. query .. "”. The chart shows the full level. Switch to Rings to see matches. Search clears when changing pages.") or "Storage Map groups measured locations by category. Folder Map inspects everything inside one folder." %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
  <HStack id="mapBody" flexGrow="1" maxHeight="infinity" spacing="16" alignment="top">
    <% --[[ Rectangles already name every item, so the list serves the rings
      only. Equal flexible panes give long names the spare width instead of
      leaving it around a height-limited ring. ]] %>
    <% if style ~= "rectangles" then %>
    <VStack id="mapListPane" minWidth="<%= MAP.minPane %>" maxWidth="infinity" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity" spacing="12">
    <GroupBox maxWidth="infinity" maxHeight="infinity">
      <VStack maxHeight="infinity" spacing="0">
        <% if #rows == 0 and query ~= "" then %>
        <ContentUnavailable id="mapNoResults" title="No Results" systemImage="magnifyingglass" description="Nothing at this level of the map matches “<%= query %>”." />
        <% end %>
        <List id="mapList" hidden="<%= #rows == 0 and query ~= "" and "true" or "false" %>" onSelect="selectRow" onActivate="drillRow" rowMenu="rowMenu" dragKey="path" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="40" drawsBackground="false" maxHeight="infinity">
          <Column id="name" title="Item" imageKey="icon" badgeColorKey="color" imageSize="22" minWidth="140" />
          <Column id="shareText" title="Size" width="<%= MAP.meter %>" minWidth="<%= MAP.meter %>" levelKey="relative" levelColorKey="color" valueKey="size" loadingKey="calculating" imageKey="sizeIcon" imageColorKey="sizeColor" />
        </List>
      </VStack>
    </GroupBox>
    <% worthBox() %>
    </VStack>
    <% end %>
    <% --[[ The rings scale to the pane, as on the Folder Map, so a small
      window shrinks them instead of scrolling them out of view. ]] %>
    <VStack id="mapChartPane" flexGrow="1" flexBasis="0" flexShrink="1" minWidth="<%= MAP.minPane %>" maxWidth="infinity" maxHeight="infinity" spacing="12" alignment="center">
      <% if #nodes == 0 then %>
      <ContentUnavailable id="mapEmpty" title="Nothing Measured Here Yet" systemImage="chart.pie" description="Sizes appear as Diskmap measures this part of your storage." />
      <% elseif style == "rectangles" then %>
      <Treemap id="treemap" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" onSelect="chartSelect" onHover="chartHover" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <TreemapNode id="<%= node.id %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" label="<%= node.label %>" detail="<%= node.detail %>" hatched="<%= node.hatched and "true" or "false" %>" />
        <% end %>
      </Treemap>
      <% else %>
      <% -- Each level renders a fresh chart in its final shape. %>
      <VStack id="mapChartHost" flexGrow="1" flexBasis="0" flexShrink="1" minHeight="<%= MAP.minChart %>" maxWidth="infinity" maxHeight="infinity" alignment="center">
      <StorageRings id="sunburst" diameter="<%= MAP.chartUnits %>" onSelect="chartSelect" onHover="chartHover" onCenter="up" onBack="up" dragItem="dragPath" accessibilityLabel="<%= accessibilityLabel %>">
        <% for _, node in ipairs(nodes) do %>
        <StorageSector id="<%= node.id %>" ring="<%= node.ring %>" parent="<%= node.parent or "" %>" value="<%= node.value %>" color="<%= node.color %>" other="<%= node.other and "true" or "false" %>" label="<%= node.label %>" />
        <% end %>
        <ChartCenter titleId="mapCenterTitle" detailId="mapCenterDetail" total="<%= center.title %>" caption="<%= center.detail %>" />
      </StorageRings>
      </VStack>
      <% end %>
      <Label id="mapHover" text="<%= hover %>" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" alignment="center" lines="0" />
      <% if style == "rectangles" then worthBox() end %>
    </VStack>
  </HStack>
  <VStack spacing="6" alignment="leading">
    <Label id="mapSelection" text="<%= selection.detail %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
    <HStack spacing="8" alignment="center">
      <Button id="mapOpen" title="<%= selection.title %>" action="openSelection" disabled="<%= not selected %>" />
      <Button id="mapInspect" title="Inspect Folder Contents" action="inspectSelection" disabled="<%= selection.path == nil %>" />
    </HStack>
  </VStack>
</VStack>
