<% --[[ The macOS Folders page: the file system area by area, each location
  with where it is, what it holds and what it takes here. The explanation is
  the point of the page, so every row shows it in full rather than behind a
  disclosure. The page's own measurement of the folders no scan covers is
  one spinner (`computing`); the rows are drawn when it is done. ]]
  local ROW = { padding = 12, spacing = 12, stateSymbol = 13, sizeWidth = 130, actionsWidth = 52 }
%>
<ContentPage id="page">
    <% if computing then %>
    <%- partial("../components/Computing.etlua", {status = computing}) %>
    <% else %>
    <% for _, area in ipairs(areas) do %>
    <VStack id="area_<%= area.id %>" spacing="8" alignment="leading">
      <%- partial("../components/SectionHeader.etlua", {title = area.title, detail = area.summary}) %>
      <GroupBox>
        <VStack spacing="0" alignment="leading">
          <% for index, row in ipairs(area.rows) do %>
          <HStack id="location_<%= area.id %>_<%= index %>" padding="<%= ROW.padding %>" spacing="<%= ROW.spacing %>" alignment="top">
            <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
              <HStack spacing="8" alignment="firstTextBaseline">
                <Label text="<%= row.name %>" size="13" weight="semibold" lines="1" />
                <% if row.status then %>
                <Label text="<%= row.status %>" size="11" color="secondary" lines="1" />
                <% end %>
              </HStack>
              <Label text="<%= row.path %>" size="11" design="monospaced" color="secondary" maxWidth="infinity" lines="1" truncation="middle" />
              <Label text="<%= row.what %>" size="12" maxWidth="infinity" lines="0" />
            </VStack>
            <HStack width="<%= ROW.sizeWidth %>" spacing="4" alignment="center">
              <Spacer />
              <% if row.stateIcon then %>
              <SystemImage name="<%= row.stateIcon %>" size="<%= ROW.stateSymbol %>" color="<%= row.stateColor %>" />
              <% end %>
              <Label id="size_<%= area.id %>_<%= index %>" text="<%= row.size %>" size="13" monospacedDigit="true" color="<%= row.bytes and "primary" or "secondary" %>" lines="1" />
            </HStack>
            <% --[[ A fixed actions column keeps every size on one edge, with or without "Show in Diskmap". ]] %>
            <HStack width="<%= ROW.actionsWidth %>" spacing="8" alignment="center">
              <Button systemImage="folder" symbolSize="15" foregroundStyle="secondary" style="plain" accessibilityLabel="Show <%= row.name %> in Finder" help="Show in Finder" action="reveal_<%= area.id %>_<%= index %>" />
              <% if row.resource then %>
              <Button systemImage="arrow.right.circle" symbolSize="15" foregroundStyle="secondary" style="plain" accessibilityLabel="Show <%= row.name %> in Diskmap" help="Show in Diskmap" action="open_<%= area.id %>_<%= index %>" />
              <% end %>
            </HStack>
          </HStack>
          <% if index < #area.rows then %><Divider /><% end %>
          <% end %>
        </VStack>
      </GroupBox>
    </VStack>
    <% end %>
    <% end %>
</ContentPage>
