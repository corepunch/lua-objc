<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = "hammer.fill", color = "systemPurple", title = "Developer", summaryId = "developerTotal", summary = "", actionTitle = "Simulators…", actionId = "showSimulators", action = "simulators"}) %>
    <% if #sections == 0 then %>
    <ContentUnavailable title="<%= calculating and "Measuring developer storage…" or "No developer storage found" %>" systemImage="hammer" description="Xcode, package managers, containers and AI tools appear here once measured." />
    <% end %>
    <% for _, section in ipairs(sections) do %>
    <VStack id="section_<%= section.id %>" maxWidth="infinity" spacing="8" alignment="leading">
      <HStack maxWidth="infinity" spacing="12" alignment="bottom">
        <%- partial("SectionHeader.etlua", {title = section.title, detail = section.detail}) %>
        <Label id="size_<%= section.id %>" text="" size="13" weight="semibold" monospacedDigit="true" />
      </HStack>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "list_" .. section.id, menu = "rowMenu", activate = "open", header = false, detailTitle = "Status"}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <%- partial("Footnote.etlua", {text = "Diskmap never removes simulator runtimes, SDKs or archives on its own. Rebuildable data is moved to the Trash only after you review it."}) %>
  </VStack>
</ScrollView>
