<%
  -- The chart is context for the decision above it, so it stays modest, but
  -- it fills the height of the card and its center text scales with it.
  local CHART = { units = 360, minSize = 112, maxSize = 200, padding = 14, spacing = 20, hole = 0.62, gap = 3, corner = 3, total = 40, caption = 24, totalScale = 9 / 40, captionScale = 0.5 }
  -- The center text is set at its largest; the chart offers it the square
  -- inscribed in the hole and it shrinks to fit on one line, like the Hero.
%>
<ScrollView id="page" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack id="pageContent" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {header = page, summary = summary}) %>
    <% if waiting then %>
    <ContentUnavailable id="waiting" title="<%= waiting.title %>" systemImage="<%= waiting.systemImage %>" description="<%= waiting.description %>" />
    <% else %>
    <%- partial("Decision.etlua", decision) %>
    <% if #kinds > 0 then %>
    <%- partial("Footnote.etlua", {id = "scopeNote", icon = "scope", text = scope}) %>
    <GroupBox id="kindsCard">
      <HStack padding="<%= CHART.padding %>" spacing="<%= CHART.spacing %>" alignment="center">
        <SectorChart id="kindsChart" scalable="true" diameter="<%= CHART.units %>" minWidth="<%= CHART.minSize %>" maxWidth="<%= CHART.maxSize %>" minHeight="<%= CHART.minSize %>" innerRadius="<%= CHART.hole %>" angularInset="<%= CHART.gap %>" onSelect="chartSelect" onHover="chartHover" accessibilityLabel="<%= accessibilityLabel %>">
          <% for _, kind in ipairs(kinds) do %>
          <SectorMark cornerRadius="<%= CHART.corner %>" id="<%= kind.id %>" value="<%= kind.bytes %>" color="<%= kind.color %>" label="<%= kind.name %>" />
          <% end %>
          <VStack spacing="0" alignment="center">
            <Label id="kindsTotal" text="<%= total %>" size="<%= CHART.total %>" minimumScaleFactor="<%= CHART.totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
            <Label text="in files" size="<%= CHART.caption %>" minimumScaleFactor="<%= CHART.captionScale %>" lines="1" color="secondary" />
          </VStack>
        </SectorChart>
        <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="8" alignment="leading">
          <Label text="<%= headline.title %>" size="13" weight="semibold" maxWidth="infinity" lines="0" />
          <DisclosureGroup label="What this inventory includes" expanded="false" indicatorWidth="26" indicatorSpacing="10">
            <Label text="<%= inventoryNote %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
          </DisclosureGroup>
          <Button id="showHeadline" title="Show Largest Files" style="link" action="showHeadline" />
        </VStack>
      </HStack>
    </GroupBox>
    <VStack spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Kinds", detail = "Grouped by file extension, the way Finder's Kind column groups them. Open a kind to see its largest files."}) %>
      <GroupBox>
        <%- partial("ResourceList.etlua", {id = "kinds", menu = "kindMenu", selectAction = "selectKind", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <% if hasExtensions then %>
    <VStack spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Top extensions", detail = extensionsDetail}) %>
      <GroupBox>
        <%- partial("ResourceList.etlua", {id = "extensions", menu = "kindMenu", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <% if #kinds > 0 then %>
    <%- partial("Footnote.etlua", {text = "Totals cover every measured location, including files inside app bundles and libraries. Excluded media libraries are not counted."}) %>
    <% end %>
    <% end %>
  </VStack>
</ScrollView>
