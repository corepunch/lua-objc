<%
  local CHART = { size = 180, hole = 0.64, gap = 3, depth = 8, total = 22, caption = 11, totalScale = 11 / 22, captionScale = 0.77 }
  -- The center text is set at its largest; the chart offers it the square
  -- inscribed in the hole and it shrinks to fit on one line, like the Hero.
%>
<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {header = header, summary = summary}) %>
    <% if #kinds == 0 then %>
    <ContentUnavailable title="Measuring files…" systemImage="square.grid.2x2" description="File types appear when the scan finishes." />
    <% else %>
    <GroupBox id="kindsCard" maxWidth="infinity">
      <HStack maxWidth="infinity" padding="20" spacing="28" alignment="center">
        <SectorChart id="kindsChart" width="<%= CHART.size %>" height="<%= CHART.size %>" innerRadius="<%= CHART.hole %>" angularInset="<%= CHART.gap %>" depth="<%= CHART.depth %>" shadow="false" onSelect="chartSelect" onHover="chartHover" accessibilityLabel="<%= accessibilityLabel %>">
          <% for _, kind in ipairs(kinds) do %>
          <SectorMark id="<%= kind.id %>" value="<%= kind.bytes %>" color="<%= kind.color %>" label="<%= kind.name %>" />
          <% end %>
          <VStack spacing="0" alignment="center">
            <Label id="kindsTotal" text="<%= total %>" size="<%= CHART.total %>" minimumScaleFactor="<%= CHART.totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
            <Label text="in files" size="<%= CHART.caption %>" minimumScaleFactor="<%= CHART.captionScale %>" lines="1" color="secondary" />
          </VStack>
        </SectorChart>
        <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="8" alignment="leading">
          <Label text="<%= headline.title %>" size="15" weight="semibold" maxWidth="infinity" lines="0" />
          <Label text="<%= headline.advice %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
          <Button id="showHeadline" title="Show Largest Files" style="link" action="kind_<%= headline.id %>" />
        </VStack>
      </HStack>
    </GroupBox>
    <% end %>
    <VStack maxWidth="infinity" spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Kinds", detail = "Grouped by file extension, the way Finder's Kind column groups them. Open a kind to see its largest files."}) %>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "kinds", menu = "kindMenu", selectAction = "selectKind", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <VStack maxWidth="infinity" spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Top extensions", detail = extensionsDetail}) %>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "extensions", menu = "kindMenu", activate = "openKind", detailColumn = true}) %>
      </GroupBox>
    </VStack>
    <%- partial("Footnote.etlua", {text = "Totals cover every measured location, including files inside app bundles and libraries. Excluded media libraries are not counted."}) %>
  </VStack>
</ScrollView>
