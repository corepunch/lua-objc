<% --[[ Leftover Git worktrees: what Git can remove now, what needs a person,
  and which registrations only need pruning. Evidence and rules live in
  models/Worktrees.lua; this template carries structure only. ]] %>
<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
  <VStack id="pageContent" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {header = header, summary = "Looking for Git worktrees…", summaryId = "summary",
      buttons = {{id = "retry", title = "Retry", action = "retry", help = "Look for worktrees again"}}}) %>
    <HStack id="stats" fixedSize="vertical" spacing="12" alignment="top">
      <%- partial("StatTile.etlua", {id = "removeTile", icon = "trash.fill", color = "systemGreen", title = "Can be removed", value = "—", detail = "Clean, published and idle"}) %>
      <%- partial("StatTile.etlua", {id = "reviewTile", icon = "eye.fill", color = "systemOrange", title = "Needs review", value = "—", detail = "Changes or commits exist only here"}) %>
      <%- partial("StatTile.etlua", {id = "pruneTile", icon = "scissors", color = "systemGray", title = "Missing", value = "—", detail = "Registered, directory gone"}) %>
    </HStack>
    <VStack id="worktreesSection" spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Worktrees", detailId = "worktreesDetail",
        detail = "A clean status alone does not prove the work is finished. Candidates are clean, published and idle; ignored files go with a removed worktree."}) %>
      <ContentUnavailable id="worktreesEmpty" hidden="true" title="No Linked Worktrees" systemImage="arrow.triangle.branch" description="No repository in your project folders has a linked worktree." />
      <GroupBox id="worktreesPanel">
        <List id="worktrees" onSelect="select" scrollDisabled="true" drawsBackground="false" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="44">
          <Column id="name" title="Worktree" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" imageSize="28" minWidth="200" />
          <Column id="roleLabel" title="Plan" width="110" minWidth="90" />
          <Column id="lastUse" title="Last used" width="150" minWidth="120" />
          <Column id="size" title="On disk" width="110" minWidth="100" alignment="trailing" />
        </List>
      </GroupBox>
      <Label id="selectedDetail" text="Select a worktree to see why it is or is not offered." size="12" maxWidth="infinity" lines="0" />
      <HStack spacing="8" alignment="center">
        <Button id="reveal" title="Show in Finder" action="reveal" disabled="true" />
        <Button id="keep" title="Keep" action="keep" disabled="true" help="Protect this worktree from every cleanup suggestion" />
        <Button id="openOwner" title="Open Owner…" action="openOwner" disabled="true" help="Archive managed worktrees in the application that made them" />
        <Spacer />
        <Button id="prune" title="Prune Missing…" action="prune" disabled="true" help="Forget registrations whose directory is gone; existing worktrees are not touched" />
        <Button id="review" title="Review and Remove…" action="review" style="borderedProminent" disabled="true" />
      </HStack>
      <Label id="status" text="" size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
    <%- partial("Footnote.etlua", {text = "Diskmap reads each repository with git worktree list, status and rev-list, and removes only with git worktree remove, never with force. Worktrees with initialized submodules, local changes or commits that exist nowhere else are left for you. Session activity is not visible to Diskmap: a worktree touched in the last few days is treated as in use."}) %>
  </VStack>
</ScrollView>
