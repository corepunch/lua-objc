<% --[[ One list presentation for every page that ranks storage: icon, name and
  where it lives, an optional detail column, a meter (the size and share on a
  line above the share bar, one native cell), and a "More" button that opens
  the row's menu. Rows are StorageRow records (schemas/StorageRow.xml). Like
  SwiftUI's List it has no column headers: section titles say what the rows
  are, and detail values name themselves ("Used 3 days ago"). The list never
  scrolls on its own; the page scrolls as one surface. `status` turns the detail
  column into one colour-coded symbol per row; `detailColumn` a two-line text.
  Arguments: `id`; `rows`, the List field; `menu` and `activate`, the commands
  for a row's menu and its activation; `loading`, an optional Bool field that
  shows the list's own spinner. The fixed columns total at most 390 points so
  the name keeps 205 points in the narrowest window's 595-point list. ]] %>
<List id="<%= id %>" items="$<%= rows %>"<% if loading then %> loading="$<%= loading %>"<% end %> rowMenu="$<%= menu %>" dragKey="path"<% if activate then %> onActivate="$<%= activate %>"<% end %> scrollDisabled="true" drawsBackground="false" style="fullWidth" header="false" alternatingRows="false" gridLines="horizontal" rowHeight="@rowHeight">
  <Resources>
    <Number id="rowHeight" value="44" />
    <Number id="name" value="170" />
    <Number id="detail" value="150" />
    <Number id="status" value="48" />
    <Number id="share" value="200" />
    <Number id="more" value="40" />
    <Number id="statusSymbol" value="20" />
    <Number id="icon" value="28" />
  </Resources>
  <Column id="name" title="Name" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon"<% if fileIcons then %> fileIconKey="fileIcon"<% end %> imageSize="@icon" minWidth="@name" />
  <% if status then %>
  <Column id="detail" title="Status" width="@status" minWidth="@status" imageKey="statusIcon" imageColorKey="statusColor" imageSize="@statusSymbol" labelStyle="iconOnly" />
  <% elseif detailColumn then %>
  <Column id="detail" title="Detail" width="@detail" minWidth="@detail">
    <Label text="$detail" lines="2" truncation="tail" />
  </Column>
  <% end %>
  <Column id="size" title="On disk" width="@share" minWidth="@share">
    <%- partial("cells/Meter.etlua", {title = "On disk"}) %>
  </Column>
  <Column id="more" title="" width="@more" minWidth="@more" buttonSymbol="ellipsis.circle" buttonMenu="true" />
</List>
