<%
  -- The welcome tour (models/Tour.lua): every page is rendered once, stacked
  -- in a ZStack that clips, and one shows at a time. Continue and Back slide
  -- the pages (TourController), and the page dots below them follow. Each
  -- screenshot is cropped by tour/capture.lua to exactly this image box, at
  -- twice its size in pixels; keep its BOX in step.
  local TOUR = { width = 580, height = 540, imageWidth = 524, imageHeight = 290 }
%>
<Sheet width="<%= TOUR.width %>" height="<%= TOUR.height %>">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="28" spacing="16" alignment="leading">
    <ZStack id="pages" maxWidth="infinity" maxHeight="infinity" clipsToBounds="true">
      <% for _, page in ipairs(pages) do %>
      <VStack id="page_<%= page.index %>" maxWidth="infinity" maxHeight="infinity" spacing="12" alignment="leading" hidden="<%= page.index == 1 and "false" or "true" %>">
        <Image id="image_<%= page.index %>" path="<%= page.image %>" darkPath="<%= page.darkImage %>" width="<%= TOUR.imageWidth %>" height="<%= TOUR.imageHeight %>" accessibilityLabel="<%= page.title %>" />
        <Label text="<%= page.title %>" size="17" weight="semibold" maxWidth="infinity" lines="0" />
        <Label text="<%= page.text %>" size="13" maxWidth="infinity" lines="0" />
        <Spacer />
      </VStack>
      <% end %>
    </ZStack>
    <PageControl id="dots" numberOfPages="<%= #pages %>" currentPage="0" maxWidth="infinity" onChange="goTo" />
    <HStack maxWidth="infinity" spacing="8" alignment="center">
      <Toggle id="showOnStart" label="Show this window on start" value="<%= showOnStart and "true" or "false" %>" onChange="showOnStart" />
      <Spacer />
      <Button id="skip" title="Skip" action="skip" keyboardShortcut="cancelAction" />
      <Button id="back" title="Back" action="back" hidden="true" />
      <Button id="next" title="Continue" style="borderedProminent" action="next" keyboardShortcut="defaultAction" />
    </HStack>
  </VStack>
</Sheet>
