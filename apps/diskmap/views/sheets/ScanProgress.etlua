<% --[[ The scan's progress window. It is rendered once; the bar's value and
  the status text are set by controllers/ScanProgressController on each scan
  tick. ]]
  local PROGRESS = { width = 440, height = 168, padding = 20, spacing = 12, symbol = 22 } %>
<Sheet width="<%= PROGRESS.width %>" height="<%= PROGRESS.height %>">
  <VStack maxHeight="infinity" padding="<%= PROGRESS.padding %>" spacing="<%= PROGRESS.spacing %>" alignment="leading">
    <HStack spacing="<%= PROGRESS.spacing %>" alignment="center">
      <SystemImage name="internaldrive" size="<%= PROGRESS.symbol %>" badgeColor="systemBlue" />
      <Label text="Measuring storage" size="15" weight="semibold" flexGrow="1" />
    </HStack>
    <ProgressView id="scanBar" value="0" maxWidth="infinity" />
    <Label id="scanStatus" text="" size="12" color="secondary" maxWidth="infinity" lines="2" truncation="tail" />
    <HStack>
      <Spacer />
      <Button id="scanStop" title="Stop" action="stop" keyboardShortcut="cancelAction" />
    </HStack>
  </VStack>
</Sheet>
