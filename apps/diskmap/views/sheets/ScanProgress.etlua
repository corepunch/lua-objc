<% local PROGRESS = { padding = 20, spacing = 12, symbol = 22 } %>
<VStack maxHeight="infinity" padding="<%= PROGRESS.padding %>" spacing="<%= PROGRESS.spacing %>" alignment="leading">
  <HStack spacing="<%= PROGRESS.spacing %>" alignment="center">
    <SystemImage name="internaldrive" size="<%= PROGRESS.symbol %>" badgeColor="systemBlue" />
    <Label text="Measuring storage" size="15" weight="semibold" flexGrow="1" />
  </HStack>
  <ProgressView id="scanBar" value="<%= fraction %>" indeterminate="<%= indeterminate and "true" or "false" %>" maxWidth="infinity" />
  <Label id="scanStatus" text="<%= status %>" size="12" color="secondary" maxWidth="infinity" lines="2" truncation="tail" />
  <HStack>
    <Spacer />
    <Button id="scanStop" title="Stop" action="stop" keyboardShortcut="cancelAction" />
  </HStack>
</VStack>
