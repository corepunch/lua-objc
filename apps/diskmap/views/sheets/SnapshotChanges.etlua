<% --[[ Every location that changed since the saved snapshot, largest change
  first. Bars compare changes with the largest one: orange grew, green shrank. ]]
  local CHANGES = { change = 200, size = 90 } %>
<VStack maxHeight="infinity" padding="20" spacing="12">
  <SheetHeader icon="clock.arrow.circlepath" color="systemIndigo">
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
      <Label id="title" size="17" weight="semibold" />
      <Label id="detail" size="12" color="secondary" maxWidth="infinity" lines="2" />
    </VStack>
  </SheetHeader>
  <List id="changes" rowMenu="rowMenu" onActivate="reveal" dragKey="path" style="inset" header="true" alternatingRows="false" rowHeight="44" flexGrow="1" flexBasis="0" maxHeight="infinity">
    <Column id="name" title="Location" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon" imageSize="28" minWidth="220" />
    <Column id="shareText" title="Change" width="<%= CHANGES.change %>" minWidth="<%= CHANGES.change %>" levelKey="relative" levelColorKey="levelColor" valueKey="detail" loadingKey="calculating" imageKey="sizeIcon" imageColorKey="sizeColor" />
    <Column id="before" title="Before" width="<%= CHANGES.size %>" minWidth="<%= CHANGES.size %>" alignment="trailing" />
    <Column id="size" title="Now" width="<%= CHANGES.size %>" minWidth="<%= CHANGES.size %>" alignment="trailing" />
  </List>
  <SheetFooter />
</VStack>
