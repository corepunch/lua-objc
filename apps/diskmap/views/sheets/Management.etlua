<VStack maxHeight="infinity" padding="16" spacing="8">
  <SheetHeader>
    <Label id="categoryName" text="<%= title %>" size="15" weight="semibold" flexGrow="1" flexShrink="1" />
  </SheetHeader>
  <SearchField id="search" placeholder="Search" accessibilityLabel="Search names, owners or paths" onChange="search" defaultFocus="true" />
  <TabView id="tabs" onChange="tabChanged" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
    <% for index, title in ipairs(filters) do %>
    <Tab title="<%= title %>">
      <List id="rows<%= index %>" onSelect="select" onActivate="reviewRow" onColumnButton="reviewRow" onSort="sort" style="fullWidth" alternatingRows="true" rowHeight="38" flexGrow="1" maxHeight="infinity">
        <Column id="name" title="Resource" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon" fileIconKey="fileIcon" imageSize="24" minWidth="180" sortable="true" />
        <Column id="impact" title="Impact" width="140" minWidth="130" sortable="true" />
        <Column id="size" title="On disk" width="125" minWidth="125" alignment="trailing" sortable="true" />
        <% --[[ A row that lives on a page of its own opens it, as Clean Up rows do. ]] %>
        <Column id="info" title="" width="36" minWidth="36" buttonSymbol="arrow.right.circle" />
      </List>
    </Tab>
    <% end %>
  </TabView>
  <Label id="status" size="11" color="secondary" maxWidth="infinity" lines="1" />
  <SheetFooter>
    <% --[[ The selected row's actions: text buttons in one row before Done. ]] %>
    <Button id="manage" title="<%= manageTitle %>" action="manage" />
    <Button id="reveal" title="Show in Finder" action="reveal" />
    <Button id="keep" title="Keep" action="keep" />
  </SheetFooter>
</VStack>
