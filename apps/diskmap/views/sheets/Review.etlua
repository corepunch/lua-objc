<% local DETAILS = {maximumHeight = 144} %>
<VStack maxHeight="infinity" padding="20" spacing="12">
  <SheetHeader icon="tray.full.fill" color="systemBlue">
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
      <Label text="Marked for Cleanup" size="17" weight="semibold" />
      <Label id="reviewSummary" size="12" color="secondary" monospacedDigit="true" maxWidth="infinity" lines="0" />
    </VStack>
    <Button id="history" title="History…" action="history" help="Every action Diskmap has taken" />
  </SheetHeader>
  <List id="items" onSelect="select" style="inset" header="false" alternatingRows="false" rowHeight="44" flexGrow="1" flexBasis="0" maxHeight="infinity">
    <Column id="name" title="Item" subtitleKey="subtitle" minWidth="220" />
    <Column id="result" title="" width="120" minWidth="90" />
    <Column id="size" title="On disk" width="100" minWidth="90" alignment="trailing" />
  </List>
  <ScrollView id="selectedDetails" vertical="true" maxHeight="<%= DETAILS.maximumHeight %>">
    <VStack spacing="8" alignment="leading">
      <Label id="consequence" size="12" maxWidth="infinity" lines="0" />
      <Label id="selectedPath" size="11" color="secondary" maxWidth="infinity" lines="0" />
      <Label id="selectedResult" size="11" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
  </ScrollView>
  <Label id="revalidation" text="Sizes are measured again, and each item is checked just before it moves: one whose app is open, whose project file is gone or that was replaced is skipped. Nothing is deleted until you empty the Trash." size="11" color="secondary" maxWidth="infinity" lines="0" />
  <HStack spacing="8" alignment="center">
    <Button id="remove" title="Unmark Selected" action="remove" />
    <Button id="clear" title="Clear All" action="clear" />
    <Spacer />
    <Button id="emptyTrash" title="Empty Trash…" action="emptyTrash" />
    <Button id="cancel" title="Close" action="close" keyboardShortcut="cancelAction" />
    <Button id="trash" title="Move to Trash" style="borderedProminent" action="trash" keyboardShortcut="defaultAction" />
  </HStack>
</VStack>
