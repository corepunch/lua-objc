<VStack maxHeight="infinity" padding="16" spacing="8">
  <SheetHeader><Label id="title" size="15" weight="semibold" maxWidth="infinity" /></SheetHeader>
  <SearchField id="search" placeholder="Search" accessibilityLabel="Search SDKs" onChange="search" defaultFocus="true" />
  <List id="rows" rowMenu="rowMenu" style="inset" header="false" alternatingRows="false" rowHeight="44" flexGrow="1" flexBasis="0" flexShrink="1" maxHeight="infinity">
    <Column id="name" title="SDK" subtitleKey="platform" minWidth="180" />
    <Column id="size" title="On disk" width="120" minWidth="100" alignment="trailing" />
  </List>
  <Label id="status" size="11" color="secondary" maxWidth="infinity" lines="1" />
  <% if favoriteTitle then %><Button id="favorite" title="<%= favoriteTitle %>" systemImage="star" action="favorite" /><% end %>
  <SheetFooter />
</VStack>
