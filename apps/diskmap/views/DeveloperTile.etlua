<GroupBox id="tile_<%= tile.id %>" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity">
  <VStack maxWidth="infinity" padding="14" spacing="8" alignment="leading">
    <HStack maxWidth="infinity" spacing="8" alignment="center">
      <SystemImage name="<%= tile.icon %>" size="22" badgeColor="<%= tile.color %>" />
      <Label text="<%= tile.title %>" size="13" weight="semibold" flexGrow="1" flexBasis="0" flexShrink="1" lines="1" />
    </HStack>
    <Label text="<%= tile.calculating and "Calculating…" or tile.size %>" size="20" weight="semibold" design="rounded" monospacedDigit="true" lines="1" />
    <Gauge value="<%= tile.relative %>" tint="<%= tile.color %>" maxWidth="infinity" accessibilityLabel="<%= tile.title %> compared with the largest developer item" />
    <Label text="<%= tile.detail %>" size="11" color="secondary" maxWidth="infinity" lines="3" />
    <Button id="tileAction_<%= tile.id %>" title="<%= tile.actionTitle %>" action="tile_<%= tile.id %>" />
  </VStack>
</GroupBox>
