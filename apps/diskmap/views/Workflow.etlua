<% --[[ One kind of work's storage (knowledge/Workflows.lua): Developer,
  Music Production, Video Production and the rest share this page. The
  template carries only the section structure; rows, sizes and the summary
  are set in place, so scan progress does not rebuild the page under the
  reader. ]] %>
<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="24" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = workflow.icon, color = workflow.color, title = workflow.name, summary = "", buttons = buttons}) %>
    <% if #sections == 0 then %>
    <ContentUnavailable id="workflowEmpty" title="<%= workflow.emptyTitle %>" systemImage="<%= workflow.icon %>" description="<%= workflow.empty %>" />
    <% end %>
    <% for _, section in ipairs(sections) do %>
    <VStack id="section_<%= section.id %>" maxWidth="infinity" spacing="8" alignment="leading">
      <HStack maxWidth="infinity" spacing="12" alignment="bottom">
        <%- partial("SectionHeader.etlua", {title = section.title, detail = section.detail}) %>
        <Label id="size_<%= section.id %>" text="" size="13" weight="semibold" monospacedDigit="true" />
      </HStack>
      <GroupBox maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "list_" .. section.id, menu = "rowMenu", activate = "open", status = true}) %>
      </GroupBox>
    </VStack>
    <% end %>
    <%- partial("Footnote.etlua", {text = workflow.footnote}) %>
  </VStack>
</ScrollView>
