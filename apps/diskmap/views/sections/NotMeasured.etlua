<% --[[ What Diskmap could not measure, on the Overview: how much used space
  is in no category and each reason, with the one action that helps where
  there is one. Protected locations are named, never offered to Full Disk
  Access, which cannot open them. The macOS Folders page explains every
  location in full. One symbol column for the whole card: the card's symbol
  and every reason's symbol are centered in it, and the title, each reason's
  name, its explanation, its paths and its button start at one text edge. A
  symbol shares the center line of the text beside it. ]]
%>
<GroupBox id="notMeasuredCard">
  <%- partial("../components/GroupedRowMetrics.etlua") %>
  <Resources>
    <Number id="verticalInset" value="14" />
    <Number id="headerSymbol" value="20" />
    <Number id="reasonSymbol" value="15" />
  </Resources>
  <% -- The same image column and gap as the adjacent full-width list rows. %>
  <VStack paddingHorizontal="@groupedRowInset" paddingVertical="@verticalInset" spacing="12" alignment="leading">
    <HStack spacing="@groupedIconGap" alignment="center">
      <SystemImage name="questionmark.folder.fill" size="@headerSymbol" color="secondary" width="@groupedIconColumn" />
      <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
        <Label text="What Diskmap could not measure" size="13" weight="semibold" maxWidth="infinity" lines="1" />
        <Label id="notMeasuredSummary" text="<%= summary %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
      </VStack>
      <Button id="exploreFolders" title="macOS Folders…" action="exploreFolders" help="What every macOS folder holds, and why some cannot be measured" />
    </HStack>
    <% for _, item in ipairs(items) do %>
    <VStack id="unmeasured_<%= item.id %>" spacing="2" alignment="leading">
      <HStack spacing="@groupedIconGap" alignment="center">
        <SystemImage name="<%= item.icon %>" size="@reasonSymbol" color="<%= item.color %>" width="@groupedIconColumn" />
        <Label text="<%= item.title %>" size="12" weight="semibold" flexGrow="1" flexBasis="0" flexShrink="1" lines="1" />
        <Label text="<%= item.value %>" size="12" color="secondary" monospacedDigit="true" lines="1" />
      </HStack>
      <VStack paddingLeading="@groupedTextInset" spacing="2" alignment="leading">
        <Label text="<%= item.detail %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
        <% for _, path in ipairs(item.paths or {}) do %>
        <Label text="<%= path %>" size="11" design="monospaced" color="secondary" maxWidth="infinity" lines="1" truncation="middle" />
        <% end %>
        <% if item.more then %><Label text="<%= item.more %>" size="11" color="secondary" /><% end %>
        <% if item.grant then %>
        <Button id="grantAccess" title="<%= item.grantTitle %>" action="grantAccess" />
        <% end %>
      </VStack>
    </VStack>
    <% end %>
  </VStack>
</GroupBox>
