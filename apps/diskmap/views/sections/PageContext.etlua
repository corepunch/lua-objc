<% --[[ Scan accounting belongs beside totals or after the ranked rows, depending
  on the page. Its own disclosure never hides the actual cleanup decision. ]] %>
<% if layout.contextDisclosure then %>
<Disclosure id="scanDetails" label="<%= layout.contextDisclosure %>" expanded="false">
  <VStack spacing="12" alignment="leading">
<% end %>
<% if layout.scopeNote then %>
<%- partial("../components/Footnote.etlua", {id = "scopeNote", icon = "scope", text = layout.scopeNote}) %>
<% end %>
<% if layout.tiles and #layout.tiles > 0 then %>
<HStack id="stats" fixedSize="vertical" spacing="12" alignment="top">
  <% for _, tile in ipairs(layout.tiles) do %><%- partial("../components/StatTile.etlua", tile) %><% end %>
</HStack>
<% end %>
<% if layout.contextDisclosure then %>
  </VStack>
</Disclosure>
<% end %>
