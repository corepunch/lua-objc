<%
  -- The size of the ring is one number, `diameter`: its ideal square, about as
  -- tall as the legend column beside it, so neither leaves empty card above
  -- and below the other. It shrinks, down to `minChart`, only when the card
  -- cannot also give the legend `minText`; it never grows past `diameter`,
  -- since no page is wider than its frame (components/PageFrame). The center text is laid
  -- out in the same units, so ring and total shrink together, the text no
  -- smaller than the scale factors allow.
  local HERO = { diameter = 260, minChart = 120, hole = 0.618, inset = 1, corner = 3.5, total = 32, caption = 14, totalScale = 13 / 32, captionScale = 0.75 }
  local hiddenRows = hiddenSpace or {}
  -- The text column keeps this much width; the chart takes what is left.
  HERO.minText = 300
  -- One symbol column for the whole card: the warning, the legend dots, the
  -- hidden-space symbols and the cleanup symbol are each centered in it, so
  -- their centers share a line and every label starts at one edge.
  HERO.symbol = { column = 20, gap = 6 }
%>
<VStack spacing="14" alignment="leading">
      <% if reclaim then %>
      <HStack spacing="<%= HERO.symbol.gap %>" alignment="center">
        <SystemImage name="sparkles" size="18" color="accent" width="<%= HERO.symbol.column %>" />
        <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="1" alignment="leading">
          <Label id="reclaimTitle" text="<%= reclaim.title %>" size="13" weight="semibold" monospacedDigit="true" maxWidth="infinity" lines="1" />
          <Label id="reclaimDetail" text="<%= reclaim.detail %>" size="11" color="secondary" maxWidth="infinity" lines="2" />
        </VStack>
        <Button id="cleanUp" title="Review Cleanup" style="borderedProminent" controlSize="large" action="reclaim" help="Open Clean Up: suggestions grouped by impact" />
      </HStack>
      <% end %>
<GroupBox id="heroCard">
  <HStack padding="20" spacing="28" alignment="center">
    <SectorChart id="chart" scalable="true" diameter="<%= HERO.diameter %>" flexGrow="0" flexShrink="1" minWidth="<%= HERO.minChart %>" minHeight="<%= HERO.minChart %>" fixedSize="vertical" innerRadius="<%= HERO.hole %>" angularInset="<%= HERO.inset %>" onSelect="chartSelect" onHover="chartHover" onCenter="chartCenter" accessibilityLabel="<%= chart.accessibilityLabel %>">
      <% for _, mark in ipairs(chart.marks) do %>
      <SectorMark cornerRadius="<%= HERO.corner %>" id="<%= mark.id %>" value="<%= mark.value %>" color="<%= mark.color %>" label="<%= mark.label %>" />
      <% end %>
      <ChartCenter id="chartCenter" titleId="usedTotal" detailId="usedCaption" total="<%= center.title %>" caption="<%= center.detail %>" totalSize="<%= HERO.total %>" captionSize="<%= HERO.caption %>" totalScale="<%= HERO.totalScale %>" captionScale="<%= HERO.captionScale %>" />
    </SectorChart>
    <VStack id="heroLegendColumn" flexGrow="1" flexBasis="0" flexShrink="1" minWidth="<%= HERO.minText %>" spacing="14" alignment="leading">
      <VStack spacing="2" alignment="leading">
        <HStack spacing="10" alignment="center">
          <Label text="<%= volumeName %>" size="22" weight="semibold" />
        </HStack>
        <Label id="freeSpace" text="<%= summary.subtitle or summary.caption %>" size="13" color="secondary" monospacedDigit="true" />
        <% if summary.lowSpace then %>
        <HStack spacing="<%= HERO.symbol.gap %>" alignment="center">
          <SystemImage name="exclamationmark.triangle.fill" size="12" color="systemOrange" width="<%= HERO.symbol.column %>" />
          <Label id="lowSpace" text="<%= summary.lowSpaceMessage %>" size="12" color="systemOrange" lines="1" />
        </HStack>
        <% end %>
      </VStack>
      <% if #chart.legend > 0 then %>
      <VStack id="legend" spacing="4" alignment="leading">
        <% for _, item in ipairs(chart.legend) do %>
        <LegendRow key="legend-<%= item.id %>" label="<%= item.name %>" color="<%= item.color %>" sizeText="<%= item.size %>" share="<%= item.share %>" linked="<%= item.id ~= "#other" and "true" or "false" %>" action="category_<%= item.id %>" column="<%= HERO.symbol.column %>" gap="<%= HERO.symbol.gap %>" />
        <% end %>
      </VStack>
      <% else %>
      <Label id="legendExplanation" text="<%= chart.explanation %>" size="12" color="secondary" maxWidth="infinity" lines="3" />
      <% end %>
      <% if #hiddenRows > 0 then %>
      <VStack id="hiddenSpace" spacing="4" alignment="leading">
        <% for _, row in ipairs(hiddenRows) do %>
        <HStack spacing="<%= HERO.symbol.gap %>" alignment="center" help="<%= row.detail %>">
          <SystemImage name="<%= row.icon %>" size="11" color="tertiary" width="<%= HERO.symbol.column %>" />
          <Label text="<%= row.title %>" size="11" color="secondary" lines="1" />
          <Spacer />
          <Label text="<%= row.value %>" size="11" color="secondary" monospacedDigit="true" />
        </HStack>
        <% end %>
      </VStack>
      <% end %>

    </VStack>
  </HStack>
</GroupBox>

</VStack>
