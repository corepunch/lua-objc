<Sheet width="760" height="680">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="24" spacing="14">
    <Label text="Suggested cleanups" size="22" weight="semibold" maxWidth="infinity" />
    <Label text="Measured candidates grouped by impact. Amounts are not guaranteed free space." size="12" color="secondary" maxWidth="infinity" lines="2" />
    <SearchField id="search" placeholder="Search suggested cleanups" accessibilityLabel="Search suggested cleanups" onChange="search" maxWidth="infinity" />
    <ScrollView id="opportunitiesScroll" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
      <VStack maxWidth="infinity" spacing="16" alignment="leading">
        <VStack id="opportunities" maxWidth="infinity" spacing="0" />
        <VStack id="tips" maxWidth="infinity" spacing="0" />
      </VStack>
    </ScrollView>
    <HStack maxWidth="infinity">
      <Spacer />
      <Button id="done" title="Done" action="done" />
    </HStack>
  </VStack>
</Sheet>
