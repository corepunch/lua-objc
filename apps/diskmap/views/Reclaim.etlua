<Sheet width="620" height="600">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="16" spacing="8">
    <Label text="Suggested cleanups" size="15" weight="semibold" maxWidth="infinity" />
    <SearchField id="search" placeholder="Search" accessibilityLabel="Search suggested cleanups" onChange="search" maxWidth="infinity" />
    <ScrollView id="opportunitiesScroll" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
      <VStack maxWidth="infinity" spacing="16" alignment="leading">
        <VStack id="opportunities" maxWidth="infinity" spacing="0" />
        <VStack id="tips" maxWidth="infinity" spacing="0" />
      </VStack>
    </ScrollView>
    <HStack maxWidth="infinity">
      <Spacer />
      <Button id="done" title="Done" action="done" />
    </HStack>
  </VStack>
</Sheet>
