<Sheet width="620" height="560">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="16" spacing="8">
    <Label text="Simulator devices" size="15" weight="semibold" maxWidth="infinity" />
    <SearchField id="search" placeholder="Search" accessibilityLabel="Search simulators" onChange="search" maxWidth="infinity" />
    <TabView id="tabs" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
      <% for index, title in ipairs(filters) do %>
      <Tab title="<%= title %>">
        <List id="rows<%= index %>" style="fullWidth" alternatingRows="true" rowHeight="32" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
          <Column id="name" title="Device" minWidth="120" />
          <Column id="runtime" title="Runtime" width="96" minWidth="80" />
          <Column id="state" title="State" width="96" minWidth="80" />
          <Column id="size" title="Apps &amp; data" width="100" minWidth="90" alignment="trailing" />
          <Column id="lastUse" title="Last used" width="130" minWidth="110" />
        </List>
      </Tab>
      <% end %>
    </TabView>
    <Label id="status" text="Reading simulator inventory…" size="11" color="secondary" maxWidth="infinity" lines="1" />
    <HStack maxWidth="infinity" spacing="8">
      <Button id="reveal" title="Reveal in Finder" action="reveal" disabled="true" />
      <Button id="erase" title="Erase…" action="erase" disabled="true" />
      <Button id="delete" title="Delete…" action="delete" disabled="true" />
      <Button id="unavailable" title="Delete Unavailable…" action="unavailable" disabled="true" />
      <Spacer />
      <Button id="done" title="Done" action="done" />
    </HStack>
  </VStack>
</Sheet>
