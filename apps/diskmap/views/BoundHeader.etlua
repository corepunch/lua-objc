<% --[[ A section's heading: a static `title` over a `detail` that is either
  static text or, with `field`, the page's bound String field of that name. ]] %>
<VStack flexShrink="1" spacing="2" alignment="leading">
  <Label text="<%= title %>" size="15" weight="semibold" />
  <% if field then %>
  <Label id="<%= id %>" text="$<%= field %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
  <% else %>
  <Label text="<%= detail %>" size="11" color="secondary" maxWidth="infinity" lines="0" />
  <% end %>
</VStack>
