<ScrollView id="page" transition="opacity" vertical="true" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
  <VStack id="pageContent" maxWidth="infinity" spacing="20" padding="24" alignment="leading">
    <%- partial("PageHeader.etlua", {icon = "doc.on.doc.fill", color = "systemTeal", title = "Duplicates", summary = "Identical files in folders you choose.", summaryId = "duplicatesSummary",
      buttons = {{id = "addFolder", title = "Add Folder…", systemImage = "plus", action = "addFolder"}, {id = "search", title = "Find Duplicates", action = "search", disabled = true}}}) %>
    <VStack maxWidth="infinity" spacing="8" alignment="leading">
      <%- partial("SectionHeader.etlua", {title = "Identical files", detail = roots, detailId = "duplicateRoots"}) %>
      <ContentUnavailable id="duplicatesEmpty" title="No Duplicates Listed" systemImage="doc.on.doc" description="Add a folder such as Downloads or Documents, then choose Find Duplicates. Files are compared byte for byte; nothing is read outside the folders you add." maxWidth="infinity" />
      <GroupBox id="duplicatesList" maxWidth="infinity">
        <%- partial("ResourceList.etlua", {id = "duplicates", menu = "menu", activate = "reveal", header = true, nameTitle = "File", detailTitle = "Copies", sizeTitle = "Can free"}) %>
      </GroupBox>
    </VStack>
    <%- partial("Footnote.etlua", {text = "Copies that are APFS clones share their storage with the original: removing one frees only what it does not share, which is what Can free shows."}) %>
  </VStack>
</ScrollView>
