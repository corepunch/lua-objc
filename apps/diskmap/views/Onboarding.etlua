<%
  -- First launch without access (#52): one message, one way to grant it,
  -- and a way to continue without it. `stage` "disk" asks the sandboxed App
  -- Store build for the startup disk, which the sandbox requires before
  -- Full Disk Access can matter; "fullDisk" asks for Full Disk Access, and
  -- Diskmap checks it every second and continues by itself once granted.
  local ONBOARDING = { stepSymbol = 18, stepGap = 10, stepSpacing = 10 }
%>
<% if stage == "disk" then %>
<VStack maxHeight="infinity" padding="28" spacing="16" alignment="leading">
  <HStack spacing="14" alignment="center">
    <SystemImage name="internaldrive.fill" size="36" badgeColor="systemBlue" />
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
      <Label text="Allow Diskmap to Measure Your Disk" size="17" weight="semibold" maxWidth="infinity" lines="0" />
      <Label text="Diskmap measures everything and moves nothing without asking." size="13" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
  </HStack>
  <Label text="Apps from the App Store can see only the folders you choose. Choose your startup disk once, and Diskmap can measure all of it. It reads only names, sizes and dates, never what is in your files." size="13" maxWidth="infinity" lines="0" />
  <VStack spacing="<%= ONBOARDING.stepSpacing %>" alignment="leading">
    <HStack spacing="<%= ONBOARDING.stepGap %>" alignment="center">
      <SystemImage name="1.circle.fill" size="<%= ONBOARDING.stepSymbol %>" color="systemBlue" accessibilityLabel="Step 1" />
      <Label text="Click Choose Disk." size="13" flexGrow="1" flexBasis="0" flexShrink="1" lines="0" />
    </HStack>
    <HStack spacing="<%= ONBOARDING.stepGap %>" alignment="center">
      <SystemImage name="2.circle.fill" size="<%= ONBOARDING.stepSymbol %>" color="systemBlue" accessibilityLabel="Step 2" />
      <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
        <Label text="The panel opens at your startup disk. Click Allow." size="13" maxWidth="infinity" lines="0" />
        <Label text="Showing another folder? Select Macintosh HD under Locations first." size="12" color="secondary" maxWidth="infinity" lines="0" />
      </VStack>
    </HStack>
  </VStack>
  <Spacer />
  <HStack spacing="8" alignment="center">
    <Button id="skip" title="Continue Without Access" action="skip" keyboardShortcut="cancelAction" />
    <Spacer />
    <Button id="chooseDisk" title="Choose Disk…" style="borderedProminent" action="chooseDisk" keyboardShortcut="defaultAction" />
  </HStack>
</VStack>
<% else %>
<VStack maxHeight="infinity" padding="28" spacing="16" alignment="leading">
  <HStack spacing="14" alignment="center">
    <SystemImage name="lock.open.fill" size="36" badgeColor="systemBlue" />
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
      <Label text="Let Diskmap See Your Whole Disk" size="17" weight="semibold" maxWidth="infinity" lines="0" />
      <Label text="Diskmap measures everything and moves nothing without asking." size="13" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
  </HStack>
  <Label text="macOS protects Mail, Messages, Safari, Documents and other folders. With Full Disk Access, Diskmap can measure them too, so its totals match your disk. It reads only names, sizes and dates, never what is in your files." size="13" maxWidth="infinity" lines="0" />
  <VStack spacing="<%= ONBOARDING.stepSpacing %>" alignment="leading">
    <HStack spacing="<%= ONBOARDING.stepGap %>" alignment="center">
      <SystemImage name="1.circle.fill" size="<%= ONBOARDING.stepSymbol %>" color="systemBlue" accessibilityLabel="Step 1" />
      <Label text="Click Open System Settings." size="13" flexGrow="1" flexBasis="0" flexShrink="1" lines="0" />
    </HStack>
    <HStack spacing="<%= ONBOARDING.stepGap %>" alignment="center">
      <SystemImage name="2.circle.fill" size="<%= ONBOARDING.stepSymbol %>" color="systemBlue" accessibilityLabel="Step 2" />
      <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
        <Label text="Turn on Diskmap in the Full Disk Access list." size="13" maxWidth="infinity" lines="0" />
        <Label text="Not in the list? Click + below it, choose Diskmap and turn it on." size="12" color="secondary" maxWidth="infinity" lines="0" />
      </VStack>
    </HStack>
  </VStack>
  <% -- After Settings opens: what Diskmap is doing, and what to do if nothing happens (hidden until then). %>
  <HStack id="waiting" spacing="<%= ONBOARDING.stepGap %>" alignment="center">
    <ProgressView id="waitingSpinner" width="<%= ONBOARDING.stepSymbol %>" height="<%= ONBOARDING.stepSymbol %>" />
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="2" alignment="leading">
      <Label text="Waiting for access…" size="13" maxWidth="infinity" lines="0" />
      <Label text="Diskmap continues by itself once access is on. Already on? Restart Diskmap." size="12" color="secondary" maxWidth="infinity" lines="0" />
    </VStack>
  </HStack>
  <Spacer />
  <HStack spacing="8" alignment="center">
    <Button id="skip" title="Continue Without Access" action="skip" keyboardShortcut="cancelAction" />
    <Spacer />
    <Button id="restart" title="Restart Diskmap" action="restart" />
    <Button id="openSettings" title="Open System Settings" style="borderedProminent" action="openSettings" keyboardShortcut="defaultAction" />
  </HStack>
</VStack>
<% end %>
