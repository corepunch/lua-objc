<Sheet width="840" height="640">
  <VStack maxWidth="infinity" maxHeight="infinity" padding="20" spacing="12">
    <Label id="categoryName" text="<%= title %>" size="15" weight="semibold" maxWidth="infinity" />
    <% if category then %>
    <Label id="categoryText" text="<%= category.text %>" size="12" maxWidth="infinity" lines="0" />
    <Label id="categoryLocation" text="<%= category.location %>" size="11" color="secondary" maxWidth="infinity" lines="2" wrapping="character" />
    <HStack maxWidth="infinity" spacing="10">
      <Button id="categoryRefresh" title="Refresh measurements" action="categoryRefresh" />
      <Button id="categoryKeep" title="<%= category.keepTitle %>" action="categoryKeep" />
    </HStack>
    <% else %>
    <Label text="Review measured storage by impact. Installed runtimes and personal work are preserved." size="12" color="secondary" maxWidth="infinity" lines="2" />
    <% end %>
    <SearchField id="search" placeholder="Search" accessibilityLabel="Search names, owners or paths" onChange="search" maxWidth="infinity" />
    <TabView id="tabs" flexGrow="1" flexBasis="0" flexShrink="1" maxWidth="infinity" maxHeight="infinity">
      <% for index, title in ipairs(filters) do %>
      <Tab title="<%= title %>">
        <List id="rows<%= index %>" style="fullWidth" alternatingRows="true" rowHeight="38" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
          <Column id="name" title="Resource" subtitleKey="subtitle" imageKey="icon" badgeColorKey="color" appIconKey="appIcon" fileIconKey="fileIcon" imageSize="24" minWidth="250" sortable="true" />
          <Column id="impact" title="Impact" width="155" minWidth="155" sortable="true" />
          <Column id="size" title="On disk" width="125" minWidth="125" alignment="trailing" loadingKey="calculating" sortable="true" />
        </List>
      </Tab>
      <% end %>
    </TabView>
    <Label id="status" text="Select a resource to see its exact path and available action." size="12" color="secondary" maxWidth="infinity" lines="2" />
    <Label id="detail" text="Size is measured storage, not guaranteed free space." size="12" maxWidth="infinity" lines="3" />
    <Label id="path" text="" size="11" color="secondary" wrapping="character" maxWidth="infinity" lines="2" />
    <HStack maxWidth="infinity" spacing="10">
      <Button id="reveal" title="Show in Finder" action="reveal" disabled="true" />
      <Button id="manage" systemImage="info.circle" symbolSize="16" foregroundStyle="secondary" accessibilityLabel="Review" style="plain" action="manage" disabled="true" />
      <Button id="keep" title="Keep" action="keep" disabled="true" />
      <Spacer />
      <Button id="done" title="Done" action="done" />
    </HStack>
  </VStack>
</Sheet>
