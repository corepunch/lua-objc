<%
  local HERO = { chart = 144, hole = 0.7, gap = 3, corner = 3, total = 24, caption = 11, totalScale = 13 / 24, captionScale = 0.5 }
  -- The line under the ring naming the hovered sector: as wide as the column the
  -- ring leaves beside the legend, so a category, its size and share fit.
  HERO.detail = { size = 12, width = 240, height = 16, gap = 8 }
  -- The center text is set at its largest; the chart offers it the hole and
  -- it shrinks to fit, no smaller than the scale factors allow.
  local hiddenRows = hidden or {}
  -- One legend column, no wider than a name, a size and a share read well
  -- across: two columns ran into each other in the narrowest window.
  HERO.legend = 440
  -- One symbol column for the whole card: the warning, the legend dots, the
  -- hidden-space symbols and the cleanup symbol are each centered in it, so
  -- their centers share a line and every label starts at one edge.
  HERO.symbol = { column = 20, gap = 6 }
%>
<VStack spacing="14" alignment="leading">
      <% if not summary.calculating or summary.lowSpace then %>
      <% --[[ Low-space launches offer measured suggestions immediately;
        the explanation makes their incomplete coverage explicit. ]] %>
      <HStack spacing="<%= HERO.symbol.gap %>" alignment="center">
        <SystemImage name="sparkles" size="18" color="accent" width="<%= HERO.symbol.column %>" />
        <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="1" alignment="leading">
          <Label id="reclaimTitle" text="<%= reclaim.title %>" size="13" weight="semibold" monospacedDigit="true" maxWidth="infinity" lines="1" />
          <Label id="reclaimDetail" text="<%= summary.calculating and "Review measured items now; more suggestions may appear as the scan continues." or reclaim.detail %>" size="11" color="secondary" maxWidth="infinity" lines="2" />
        </VStack>
        <Button id="cleanUp" title="Review Cleanup" style="borderedProminent" controlSize="large" action="reclaim" help="Open Clean Up: suggestions grouped by impact" />
      </HStack>
      <% end %>
<GroupBox id="heroCard">
  <HStack padding="20" spacing="28" alignment="center">
    <% --[[ The ring and the line under it are one chart: the hovered sector
      is named there, and the line keeps its height while empty so the ring
      never moves. ]] %>
    <VStack id="chartColumn" spacing="<%= HERO.detail.gap %>" alignment="center">
      <SectorChart id="chart" transition="opacity" width="<%= HERO.chart %>" height="<%= HERO.chart %>" innerRadius="<%= HERO.hole %>" angularInset="<%= HERO.gap %>" onSelect="chartSelect" onHover="chartHover" onCenter="chartCenter" accessibilityLabel="<%= chart.accessibilityLabel %>">
        <% for _, mark in ipairs(chart.marks) do %>
        <SectorMark cornerRadius="<%= HERO.corner %>" id="<%= mark.id %>" value="<%= mark.value %>" color="<%= mark.color %>" label="<%= mark.label %>" />
        <% end %>
        <VStack spacing="0" alignment="center">
          <Label id="usedTotal" text="<%= summary.used %>" size="<%= HERO.total %>" minimumScaleFactor="<%= HERO.totalScale %>" lines="1" weight="semibold" design="rounded" monospacedDigit="true" />
          <Label id="usedCaption" text="<%= summary.available and (summary.total .. " total") or "Capacity unavailable" %>" size="<%= HERO.caption %>" minimumScaleFactor="<%= HERO.captionScale %>" lines="1" color="secondary" />
        </VStack>
      </SectorChart>
      <Label id="chartDetail" text="" size="<%= HERO.detail.size %>" color="secondary" monospacedDigit="true" width="<%= HERO.detail.width %>" height="<%= HERO.detail.height %>" alignment="center" lines="1" truncation="middle" />
    </VStack>
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="14" alignment="leading">
      <VStack spacing="2" alignment="leading">
        <HStack spacing="10" alignment="center">
          <Label text="<%= volumeName %>" size="22" weight="semibold" />
          <% if summary.calculating then %>
          <% --[[ Scan progress sits beside the title, the first line the eye
            reads, so no one scrolls to find a spinner row. ]] %>
          <HStack id="calculating" spacing="4" alignment="center">
            <ProgressView controlSize="small" />
            <Label text="Calculating…" size="12" color="secondary" lines="1" />
          </HStack>
          <% end %>
        </HStack>
        <% if summary.calculating then %>
        <Label id="scanProgress" text="<%= scanStatus or "Measuring storage…" %>" size="12" color="secondary" maxWidth="infinity" lines="0" />
        <% end %>
        <Label id="freeSpace" text="<%= summary.subtitle or summary.caption %>" size="13" color="secondary" monospacedDigit="true" />
        <% if summary.lowSpace then %>
        <HStack spacing="<%= HERO.symbol.gap %>" alignment="center">
          <SystemImage name="exclamationmark.triangle.fill" size="12" color="systemOrange" width="<%= HERO.symbol.column %>" />
          <Label id="lowSpace" text="Less than 10% of this disk is free" size="12" color="systemOrange" lines="1" />
        </HStack>
        <% end %>
      </VStack>
      <% if #chart.legend > 0 then %>
      <VStack id="legend" maxWidth="<%= HERO.legend %>" spacing="4" alignment="leading">
        <% for _, item in ipairs(chart.legend) do %>
        <%- partial("LegendRow.etlua", {item = item, symbol = HERO.symbol}) %>
        <% end %>
      </VStack>
      <% else %>
      <Label id="legendExplanation" text="<%= chart.explanation %>" size="12" color="secondary" maxWidth="infinity" lines="3" />
      <% end %>
      <% if #hiddenRows > 0 then %>
      <VStack id="hiddenSpace" maxWidth="<%= HERO.legend %>" spacing="4" alignment="leading">
        <% for _, row in ipairs(hiddenRows) do %>
        <HStack spacing="<%= HERO.symbol.gap %>" alignment="center" help="<%= row.detail %>">
          <SystemImage name="<%= row.icon %>" size="11" color="tertiary" width="<%= HERO.symbol.column %>" />
          <Label text="<%= row.title %>" size="11" color="secondary" lines="1" />
          <Spacer />
          <Label text="<%= row.value %>" size="11" color="secondary" monospacedDigit="true" />
        </HStack>
        <% end %>
      </VStack>
      <% end %>

    </VStack>
  </HStack>
</GroupBox>

</VStack>
