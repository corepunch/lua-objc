<VStack id="help_<%= topic.id %>" maxWidth="infinity" padding="12" spacing="6" alignment="leading">
  <HStack maxWidth="infinity" spacing="10" alignment="center">
    <% --[[ Symbols differ in width; a fixed column starts every title at one edge. ]] %>
  <SystemImage name="<%= topic.icon %>" size="18" color="accent" width="26" />
    <VStack flexGrow="1" flexBasis="0" flexShrink="1" spacing="1" alignment="leading">
      <Label text="<%= topic.title %>" size="13" weight="semibold" maxWidth="infinity" lines="1" />
      <Label text="<%= topic.summary %>" size="12" color="secondary" maxWidth="infinity" lines="2" />
    </VStack>
    <% if topic.link then %>
    <Button id="link_<%= topic.id %>" title="<%= topic.link %>" style="link" action="open_<%= topic.id %>" />
    <% end %>
  </HStack>
  <% if topic.steps ~= "" or topic.note then %>
  <DisclosureGroup id="steps_<%= topic.id %>" label="<%= topic.id == "shortcuts" and "Shortcuts" or "How to" %>" expanded="<%= expanded and "true" or "false" %>" spacing="8" paddingLeading="28" maxWidth="infinity">
    <% if topic.steps ~= "" then %>
    <Label text="<%= topic.steps %>" size="12" maxWidth="infinity" lines="0" />
    <% end %>
    <% if topic.note then %>
    <Label text="<%= topic.note %>" systemImage="info.circle" size="12" color="secondary" maxWidth="infinity" lines="0" />
    <% end %>
  </DisclosureGroup>
  <% end %>
</VStack>
