<Window title="Browser" width="900" height="640" minWidth="620" minHeight="420">
  <VStack spacing="0" fillWidth="true" fillHeight="true">
    <HStack spacing="8" padding="10">
      <Button title="Back" action="goBack" style="bordered" />
      <Button title="Forward" action="goForward" style="bordered" />
      <Button title="Reload" action="reload" style="bordered" />
      <TextField value="<%= page.url %>" placeholder="Enter a URL" flexGrow="1" />
    </HStack>
    <HStack spacing="8" padding="10">
      <SearchField placeholder="Find in page" onChange="setSearchQuery" flexGrow="1" />
      <Button title="Find Next" action="findNext" style="bordered" />
      <Button title="Zoom Out" action="zoomOut" style="bordered" />
      <Button title="Zoom In" action="zoomIn" style="bordered" />
    </HStack>
    <WebView page="page" fillWidth="true" fillHeight="true" />
  </VStack>
</Window>
