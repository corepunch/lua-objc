<!-- Trees, rocks, crates and ground cover. Each piece turns by an angle
    derived from its cell, so repeated props never line up like stamps. -->
<%
local MODELS = {
	tree = "tree.obj", pine = "tree-pine.obj", rocks = "rocks.obj", crate = "crate.obj",
	flowers = "flowers.obj", grass = "grass.obj", mushrooms = "mushrooms.obj",
}
local SCALES = {crate = 1.5, rocks = 1.4}
local turn = (x * 73 + z * 151) % 4 * 90 + (x + z) % 3 * 12
-%>
<Node model="<%= assets .. MODELS[kind] %>" position="<%= x %> 0 <%= z %>" rotation="0 <%= turn %> 0" scale="<%= SCALES[kind] or 1 %>" />
