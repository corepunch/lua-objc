<Window title="Coin Quest" width="1100" height="660" minWidth="720" minHeight="420" orientation="landscape">
	<Toolbar>
		<ToolbarItem id="restartItem" label="Restart" icon="arrow.counterclockwise" tooltip="Start again from the first level" action="restart" />
	</Toolbar>
	<ZStack maxWidth="infinity" maxHeight="infinity">
		<VStack id="stage" maxWidth="infinity" maxHeight="infinity" />
		<VStack id="hud" maxWidth="infinity" maxHeight="infinity" allowsHitTesting="false" />
	</ZStack>
</Window>
