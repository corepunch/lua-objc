<Window title="<%= title %>" appearance="dark" width="400" height="225" minWidth="288" minHeight="162" aspectRatio="1.7778" level="floating" transparentTitlebar="true" hideTitle="true" onClose="miniPlayerClosed">
	<ZStack maxWidth="infinity" maxHeight="infinity">
		<%- partial("Visualizer.etlua", {program = program}) %>
		<VStack padding="10" maxWidth="infinity" maxHeight="infinity">
			<Spacer />
			<GlassEffect cornerRadius="18" maxWidth="infinity">
				<HStack paddingLeading="14" paddingTrailing="8" paddingVertical="8" spacing="6" maxWidth="infinity">
					<VStack spacing="1" alignment="leading" maxWidth="infinity">
						<Label id="section" text="<%= nowPlaying.section %>" size="13" weight="bold" lineLimit="1" />
						<Label id="detail" text="<%= nowPlaying.detail %>" size="11" color="secondary" lineLimit="1" />
					</VStack>
					<Button id="play" style="plain" systemImage="play.fill" symbolSize="15" accessibilityLabel="Play" action="play" />
					<Button id="stop" style="plain" systemImage="stop.fill" symbolSize="15" accessibilityLabel="Stop" action="stop" />
					<Button id="nextTrack" style="plain" systemImage="forward.end.fill" symbolSize="15" accessibilityLabel="Next Track" action="nextTrack" />
					<Button id="restore" style="plain" systemImage="pip.exit" symbolSize="15" accessibilityLabel="Back to the full window" action="closeMiniPlayer" />
				</HStack>
			</GlassEffect>
		</VStack>
	</ZStack>
</Window>
