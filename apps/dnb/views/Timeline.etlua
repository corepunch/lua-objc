<%
-- The arrangement strip, after the song view of a tracker and the arrange
-- window of MTV Music Generator: eight channels, each named after the
-- instrument the playing track has on it, beside a Metal view that scrolls
-- the clips past a fixed playhead (shaders/Timeline.metal). A click plays
-- from the bar under it; the wheel or a swipe looks ahead or back. No apostrophes
-- here: etlua reads one inside a code block as the start of a string.
-%>
<GlassEffect cornerRadius="24" maxWidth="infinity" maxHeight="infinity">
	<VStack padding="18" spacing="8" alignment="leading" maxWidth="infinity" maxHeight="infinity">
		<HStack spacing="8" maxWidth="infinity">
			<Label text="ARRANGEMENT" size="11" weight="heavy" color="secondary" />
			<Spacer />
			<Label id="timelineNext" text="<%= headline %>" size="12" color="secondary" monospacedDigit="true" />
		</HStack>
		<HStack spacing="10" alignment="top" maxWidth="infinity">
			<VStack spacing="0" alignment="trailing" width="<%= labelWidth %>">
				<% for _, row in ipairs(rows) do -%>
				<VStack key="<%= row.index %>" spacing="0" alignment="trailing" height="<%= rowHeight %>">
					<Spacer />
					<Label id="channel<%= row.index %>" text="<%= row.name %>" size="10" weight="medium" color="secondary" lineLimit="1" accessibilityLabel="Channel <%= row.index %>" />
					<Spacer />
				</VStack>
				<% end -%>
			</VStack>
			<ShaderView id="timelineCanvas" function="timeline" layers="1" maxWidth="infinity" height="<%= #rows * rowHeight %>" onClick="seekTimeline" onScroll="scrollTimeline">
				<ShaderSource path="apps/dnb/shaders/Timeline.metal" />
			</ShaderView>
		</HStack>
	</VStack>
</GlassEffect>
