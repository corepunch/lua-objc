<%
-- The arrangement strip, after the arrange window of Cubase or MTV Music
-- Generator: track names beside a Metal view that scrolls the clips past a
-- fixed playhead (shaders/Timeline.metal). Names are presentation, so they
-- live here; the rows are the tracks of the arrangements in view.
local names = {
	kick = "Kick", snare = "Snare", hats = "Hats", percussion = "Perc", ["break"] = "Break", bass = "Bass",
	pads = "Pads", keys = "Keys", stabs = "Stabs", arp = "Arp", lead = "Lead", fills = "Fills", fx = "FX", filter = "Filter",
}
-%>
<GlassEffect cornerRadius="24" maxWidth="infinity" maxHeight="infinity">
	<VStack padding="18" spacing="8" alignment="leading" maxWidth="infinity" maxHeight="infinity">
		<HStack spacing="8" maxWidth="infinity">
			<Label text="ARRANGEMENT" size="11" weight="heavy" color="secondary" />
			<Spacer />
			<Label id="timelineNext" text="<%= headline %>" size="12" color="secondary" monospacedDigit="true" />
		</HStack>
		<HStack spacing="10" alignment="top" maxWidth="infinity">
			<VStack spacing="0" alignment="trailing" width="<%= labelWidth %>">
				<% for _, row in ipairs(rows) do -%>
				<Label key="<%= row.track %>" text="<%= names[row.track] %>" size="9" weight="medium" color="secondary" lineLimit="1" height="<%= rowHeight %>" />
				<% end -%>
			</VStack>
			<ShaderView id="timelineCanvas" function="timeline" layers="1" maxWidth="infinity" height="<%= #rows * rowHeight %>">
				<ShaderSource path="apps/dnb/shaders/Timeline.metal" />
			</ShaderView>
		</HStack>
	</VStack>
</GlassEffect>
