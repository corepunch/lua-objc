<%
-- Drum-machine pads, after the Logic Pro Drum Machine Designer: one lit pad
-- per part. Symbols and tints are presentation, so they live here.
local tints = {Drums = "systemPink", Music = "systemPurple", Structure = "systemTeal"}
local symbols = {
	kick = "circle.fill", snare = "burst.fill", ghosts = "sparkles", hats = "circle.dotted",
	ride = "circle.circle", percussion = "hands.clap.fill", sub = "speaker.wave.3.fill",
	amen = "opticaldisc.fill", reese = "waveform", pads = "cloud.fill", keys = "pianokeys",
	stabs = "bolt.fill", arp = "stairs", lead = "music.note",
	arrangement = "square.stack.3d.up.fill", fills = "wand.and.stars", risers = "arrow.up.right",
	halftime = "tortoise.fill", modulate = "arrow.up.arrow.down", throws = "dot.radiowaves.right",
	chops = "scissors",
}
-%>
<GlassEffect cornerRadius="20" maxHeight="infinity">
	<VStack padding="18" spacing="14" alignment="leading">
		<% for _, group in ipairs(groups) do local tint = tints[group.title] -%>
		<VStack spacing="8" alignment="leading">
			<Label text="<%= group.title:upper() %>" size="11" weight="heavy" color="secondary" />
			<HStack spacing="8">
				<% for _, part in ipairs(group.parts) do -%>
				<Toggle id="part_<%= part.id %>" style="button" label="<%= part.label %>" systemImage="<%= symbols[part.id] %>" symbolSize="16" tint="<%= tint %>" value="<%= part.on and "true" or "false" %>" width="84" height="62" onChange="part_<%= part.id %>" />
				<% end -%>
			</HStack>
		</VStack>
		<% end -%>
	</VStack>
</GlassEffect>
