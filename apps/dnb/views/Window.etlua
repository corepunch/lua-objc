<Window title="Drum &amp; Bass" appearance="dark" width="1120" height="820" minWidth="1060" minHeight="780">
	<Toolbar>
		<ToolbarItem id="playItem" label="Play" tooltip="Start generating music">
			<Button id="play" systemImage="play.fill" accessibilityLabel="Play" action="play" />
		</ToolbarItem>
		<ToolbarItem id="stopItem" label="Stop" tooltip="Pause playback">
			<Button id="stop" systemImage="stop.fill" accessibilityLabel="Stop" action="stop" />
		</ToolbarItem>
		<ToolbarSpacer />
		<ToolbarItem id="newTrack" label="New Track" icon="shuffle" tooltip="New key, progression, groove and bass line" action="newTrack" />
	</Toolbar>
	<ZStack maxWidth="infinity" maxHeight="infinity">
		<%- partial("Backdrop.etlua", {}) %>
		<VStack padding="20" spacing="16" alignment="leading" maxWidth="infinity" maxHeight="infinity">
			<%- partial("Stage.etlua", nowPlaying) %>
			<HStack spacing="16" alignment="top" maxWidth="infinity">
				<%- partial("Parts.etlua", {groups = partGroups}) %>
				<GlassEffect cornerRadius="20" maxWidth="infinity">
					<HStack padding="18" spacing="24" alignment="top" maxWidth="infinity">
						<% for _, group in ipairs(controlGroups) do -%>
						<%- partial("Controls.etlua", group) %>
						<% end -%>
					</HStack>
				</GlassEffect>
			</HStack>
		</VStack>
	</ZStack>
</Window>
