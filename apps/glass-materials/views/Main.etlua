<Window title="Glass Materials" width="620" height="520" toolbarLabels="false">
  <Toolbar>
    <ToolbarItem id="refresh" label="Refresh" icon="arrow.clockwise" visibilityPriority="10" />
    <ToolbarSpacer />
    <ToolbarItem id="settings" label="Settings" icon="gear" />
  </Toolbar>
  <VStack spacing="20" padding="24" fillWidth="true" fillHeight="true">
    <Title text="System glass" />
    <Label text="Use the platform glass effect. The control and its tint remain native." />
    <GlassEffect style="regular" cornerRadius="18" fillWidth="true">
      <VStack spacing="12" padding="20">
        <Label text="Regular glass" weight="bold" />
        <Label text="AppKit uses NSGlassEffectView. UIKit uses UIGlassEffect." />
        <Button title="Glass button" style="glass" systemImage="sparkles" />
      </VStack>
    </GlassEffect>
    <GlassEffect style="clear" cornerRadius="18" fillWidth="true">
      <VStack spacing="8" padding="20">
        <Label text="Clear glass" weight="bold" />
        <Label text="System material appearance adapts to the active appearance." />
      </VStack>
    </GlassEffect>
    <Spacer />
  </VStack>
</Window>
