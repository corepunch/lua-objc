<%
  -- The turns of a conversation: the request of the user is a bubble of
  -- the brand gradient, the agent answers beside its mark with its edits in
  -- one card. The iPad card and the phone sheet lay out the same turns;
  -- `metrics` carries the sizes of the surface they are on.
%>
<% for _, message in ipairs(messages) do %>
<% if message.role == "user" then %>
<HStack id="message/<%= message.id %>" spacing="0" maxWidth="infinity">
	<Spacer minWidth="<%= metrics.bubbleIndent %>" />
	<% -- The gradient fills whatever the text measures: the bubble
	   -- declines to grow and takes the height of its text. %>
	<ZStack id="bubble/<%= message.id %>" flexGrow="0" flexShrink="1" fixedSize="vertical">
		<LinearGradient colors="<%= brand %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= metrics.bubbleRadius %>" />
		<VStack padding="<%= metrics.bubbleInset %>">
			<Label text="<%= message.text %>" size="<%= metrics.bodySize %>" color="white" lines="0" />
		</VStack>
	</ZStack>
</HStack>
<% else %>
<HStack id="message/<%= message.id %>" spacing="<%= metrics.turnSpacing %>" maxWidth="infinity" alignment="top">
	<%- partial("Avatar.etlua", { size = metrics.turnAvatar, colors = brand, icon = agent.icon, label = agent.name }) %>
	<VStack spacing="<%= metrics.turnSpacing %>" flexGrow="1" flexShrink="1" alignment="leading">
		<Label text="<%= message.text %>" size="<%= metrics.bodySize %>" lines="0" maxWidth="infinity" />
		<% if message.changes then %>
		<%- partial("ChangeCard.etlua", { changes = message.changes, summary = message.summary }) %>
		<% end %>
		<% if message.conclusion then %>
		<Label text="<%= message.conclusion %>" size="<%= metrics.bodySize %>" lines="0" maxWidth="infinity" />
		<% end %>
		<% if message.previewState == "ready" then %>
		<Label text="Preview updated" systemImage="checkmark.circle.fill" iconSize="<%= metrics.captionSize %>" size="<%= metrics.captionSize %>" color="secondary" />
		<% elseif message.previewState == "error" then %>
		<Label text="Preview failed. Last working version kept." systemImage="exclamationmark.triangle.fill" iconSize="<%= metrics.captionSize %>" size="<%= metrics.captionSize %>" color="systemOrange" lines="0" maxWidth="infinity" />
		<% end %>
	</VStack>
</HStack>
<% end %>
<% end %>
