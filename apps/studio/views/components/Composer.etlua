<%
  -- Suggestions sit directly above the field they fill; the field and its
  -- actions share one glass capsule so the composer reads as a single control.
  -- Return sends; while the agent works the send button becomes Stop.
  local COMPOSER = { spacing = 10, chipSpacing = 8, radius = 24, fieldInset = 6, fieldSize = 15 }
%>
<VStack padding="<%= inset %>" spacing="<%= COMPOSER.spacing %>" maxWidth="<%= column %>" alignment="leading">
	<FlowStack spacing="<%= COMPOSER.chipSpacing %>" maxWidth="infinity">
		<% for _, suggestion in ipairs(suggestions) do %>
		<Button title="<%= suggestion.title %>" systemImage="<%= suggestion.icon %>" action="suggest_<%= suggestion.id %>" controlSize="small" style="glass" />
		<% end %>
	</FlowStack>
	<GlassEffect cornerRadius="<%= COMPOSER.radius %>" maxWidth="infinity">
		<HStack padding="<%= COMPOSER.fieldInset %>" spacing="<%= COMPOSER.fieldInset %>" maxWidth="infinity" alignment="center">
			<Button systemImage="plus" accessibilityLabel="Attach" style="plain" />
			<TextField id="composer" text="<%= draft or "" %>" placeholder="Describe a change…" onChange="editDraft" onCommand="composerCommand" size="<%= COMPOSER.fieldSize %>" style="plain" flexGrow="1" maxWidth="infinity" />
			<Button systemImage="<%= listening and "waveform" or "mic" %>" accessibilityLabel="Dictate" style="plain" />
			<% if busy then %>
			<Button id="stopButton" systemImage="stop.fill" accessibilityLabel="Stop" action="stopAgent" style="glassProminent" />
			<% else %>
			<Button id="sendButton" systemImage="arrow.up" accessibilityLabel="Send" action="send" style="glassProminent" />
			<% end %>
		</HStack>
	</GlassEffect>
</VStack>
