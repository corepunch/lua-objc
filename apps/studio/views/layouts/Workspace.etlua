<%
  -- Rail, toolbar, stage and agent card, drawn from the workspace state:
  -- the mode the rail selected, whether the chat or the project tree is
  -- hidden, the file open in the code pane and the status line. The rail
  -- runs the full height; the toolbar spans the stage and the card, as a
  -- window toolbar spans the content beside a sidebar. An action changes
  -- the state and the workspace is drawn again.
%>
<HStack id="columns" spacing="0" maxWidth="infinity" maxHeight="infinity" alignment="top">
	<%- partial("../sections/Rail.etlua", rail) %>
	<VStack id="content" spacing="0" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity">
		<%- partial("../sections/Toolbar.etlua", toolbar) %>
		<HStack id="panes" spacing="0" flexGrow="1" maxWidth="infinity" maxHeight="infinity" alignment="top">
			<%- partial("../sections/PreviewPane.etlua", preview) %>
			<%- partial("../sections/ChatPane.etlua", chat) %>
		</HStack>
	</VStack>
</HStack>
