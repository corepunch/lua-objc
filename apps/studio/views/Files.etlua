<VStack padding="20" spacing="10" flexGrow="1" alignment="leading">
	<Label text="Project files" size="24" weight="bold" />
	<% for _, file in ipairs(paths) do %>
	<Label text="<%= file %>" size="12" color="secondary" />
	<% end %>
	<HStack padding="0" spacing="10" fillWidth="true">
		<TextField ref="path" value="<%= path %>" flexGrow="1" />
		<Button title="Open" action="open" />
	</HStack>
	<TextEditor ref="editor" text="<%= source %>" size="14" flexGrow="1" fillWidth="true" />
	<Label ref="status" text="Edit, then save to update the preview." size="13" lines="3" />
	<Button title="Save and preview" action="save" style="borderedProminent" />
</VStack>
