<Window title="Lua Studio" width="1366" height="900" minWidth="980" minHeight="640">
	<HStack padding="0" spacing="0" flexGrow="1" fillWidth="true" fillHeight="true" alignment="top">
		<%- partial("Sidebar.etlua", sidebar) %>
		<Divider orientation="vertical" />
		<%- partial("PreviewPane.etlua", preview) %>
		<Divider orientation="vertical" />
		<%- partial("ChatPane.etlua", chat) %>
	</HStack>
</Window>
