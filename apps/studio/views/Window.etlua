<%
  -- Two panes: the running app on its stage, the agent beside it. The stage
  -- owns every workspace action, so no separate toolbar strip crowds the
  -- preview; the chat keeps a steady reading width while the stage flexes.
%>
<Window title="Lua Studio" width="1366" height="900" minWidth="980" minHeight="640">
	<HStack id="workspace" spacing="0" maxWidth="infinity" maxHeight="infinity" alignment="top" background="background">
		<%- partial("PreviewPane.etlua", preview) %>
		<Divider orientation="vertical" />
		<%- partial("ChatPane.etlua", chat) %>
	</HStack>
</Window>
