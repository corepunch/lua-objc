<%
  -- Rail, side column and agent card, drawn from the workspace state: the
  -- view the rail chose for the side column, and whether the card shows the
  -- conversation or the open file. An action changes the state and the
  -- workspace is drawn again.
%>
<% if empty then %>
<%- partial("EmptyWorkspace.etlua", {status = status}) %>
<% else %>
<HStack id="columns" spacing="0" maxWidth="infinity" maxHeight="infinity" alignment="top">
	<%- partial("../components/Rail.etlua", rail) %>
	<%- partial("SidePane.etlua", side) %>
	<%- partial("ChatPane.etlua", chat) %>
</HStack>
<% end %>
