<%
  -- The activity rail: icon-only, as in an editor. The project menu sits at
  -- the top, the modes of the agent card beneath it, then the project
  -- actions (Run, Commit) after a rule, workspace destinations after
  -- another, and settings at the foot. The rail has no background of its own;
  -- it rests on the workspace gradient.
  local RAIL = { width = 68, inset = 12, spacing = 6, item = 44, itemRadius = 14, symbol = 19, mark = 40, markRadius = 12, markSymbol = 19, rule = 24, badge = 18, badgeSize = 10 }
%>
<VStack id="rail" tint="<%= tint %>" width="<%= RAIL.width %>" paddingVertical="<%= RAIL.inset %>" spacing="<%= RAIL.spacing %>" maxHeight="infinity" alignment="center">
	<% -- The project heads the rail: its artwork fills a tile the shape of
	   -- every other rail item, and the menu lists the projects, the icon
	   -- choices and New Project. %>
	<Menu id="projectMenu" title="" systemImage="<%= menu.project.icon %>" imagePath="<%= menu.project.imagePath or "" %>" cornerRadius="<%= RAIL.itemRadius %>" style="plain" accessibilityLabel="Project: <%= menu.project.title %>" width="<%= RAIL.item %>" height="<%= RAIL.item %>">
		<% for _, item in ipairs(menu.projects) do %>
		<MenuItem title="<%= item.title %>" systemImage="<%= item.icon %>" imagePath="<%= item.imagePath or "" %>" checked="<%= tostring(item.selected == true) %>"<% if item.action then %> action="<%= item.action %>"<% end %> />
		<% end %>
		<Separator />
		<% for _, choice in ipairs(menu.iconChoices) do %>
		<MenuItem title="Use <%= choice.title %> Icon" systemImage="<%= choice.symbol %>" imagePath="<%= choice.imagePath %>" checked="<%= tostring(choice.selected) %>" action="<%= choice.action %>" />
		<% end %>
		<Separator />
		<% for _, destination in ipairs(menu.destinations) do %>
		<MenuItem title="<%= destination.title %>" systemImage="<%= destination.icon %>" action="<%= destination.action %>" />
		<% end %>
	</Menu>
	<Spacer height="<%= RAIL.spacing %>" />
	<% for _, mode in ipairs(modes) do %>
	<% if mode.selected then %>
	<ZStack id="rail/<%= mode.id %>/on" width="<%= RAIL.item %>" height="<%= RAIL.item %>" accessibilityLabel="<%= mode.title %>, selected">
		<LinearGradient colors="<%= brand.colors %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= RAIL.itemRadius %>" />
		<SystemImage name="<%= mode.icon %>" size="<%= RAIL.symbol %>" weight="semibold" color="white" label="<%= mode.title %>, selected" />
	</ZStack>
	<% else %>
	<Button id="rail/<%= mode.id %>/off" systemImage="<%= mode.icon %>" symbolSize="<%= RAIL.symbol %>" foregroundStyle="secondary" accessibilityLabel="<%= mode.title %>" action="<%= mode.action %>" style="plain" width="<%= RAIL.item %>" height="<%= RAIL.item %>" />
	<% end %>
	<% end %>
	<Divider width="<%= RAIL.rule %>" />
	<% for _, item in ipairs(actions) do %>
	<% if item.badge then %>
	<% -- A count sits on the corner of the item, as the change count sits on
	   -- Source Control in the activity bar. %>
	<Button id="rail/<%= item.id %>" accessibilityLabel="<%= item.label %>" action="<%= item.action %>" style="plain" width="<%= RAIL.item %>" height="<%= RAIL.item %>">
		<ZStack width="<%= RAIL.item %>" height="<%= RAIL.item %>">
			<SystemImage name="<%= item.icon %>" size="<%= RAIL.symbol %>" color="secondary" label="" />
			<VStack spacing="0" maxWidth="infinity" maxHeight="infinity" alignment="trailing">
				<ZStack id="rail/<%= item.id %>/badge" width="<%= RAIL.badge %>" height="<%= RAIL.badge %>">
					<LinearGradient colors="<%= brand.colors %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= RAIL.badge // 2 %>" />
					<Label text="<%= item.badge %>" size="<%= RAIL.badgeSize %>" weight="bold" color="white" lines="1" />
				</ZStack>
				<Spacer />
			</VStack>
		</ZStack>
	</Button>
	<% else %>
	<Button id="rail/<%= item.id %>" systemImage="<%= item.icon %>" symbolSize="<%= RAIL.symbol %>" foregroundStyle="secondary" accessibilityLabel="<%= item.label %>" action="<%= item.action %>" style="plain" width="<%= RAIL.item %>" height="<%= RAIL.item %>" />
	<% end %>
	<% end %>
	<Divider width="<%= RAIL.rule %>" />
	<% for _, item in ipairs(destinations) do %>
	<Button id="rail/<%= item.id %>" systemImage="<%= item.icon %>" symbolSize="<%= RAIL.symbol %>" foregroundStyle="secondary" accessibilityLabel="<%= item.title %>" action="<%= item.action %>" style="plain" width="<%= RAIL.item %>" height="<%= RAIL.item %>" />
	<% end %>
	<Spacer />
	<% for _, item in ipairs(footer) do %>
	<Button id="rail/<%= item.id %>" systemImage="<%= item.icon %>" symbolSize="<%= RAIL.symbol %>" foregroundStyle="secondary" accessibilityLabel="<%= item.title %>" action="<%= item.action %>" style="plain" width="<%= RAIL.item %>" height="<%= RAIL.item %>" />
	<% end %>
</VStack>
