<%
	local CODE = { inset = 14, sidebarWidth = 160, titleSize = 15, captionSize = 11, rowHeight = 42 }
%>
<HStack id="codePane" hidden="<%= tostring(not shown) %>" spacing="0" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" background="background">
	<VStack id="treePane" hidden="<%= tostring(treeHidden == true) %>" width="<%= CODE.sidebarWidth %>" maxHeight="infinity" alignment="leading" background="secondaryBackground">
		<HStack paddingHorizontal="<%= CODE.inset %>" paddingVertical="12" spacing="8" maxWidth="infinity" alignment="center">
			<SystemImage name="folder.fill" size="15" color="secondary" />
			<Label text="<%= projectTitle or "Project" %>" size="<%= CODE.captionSize %>" weight="semibold" color="secondary" lines="1" />
			<Spacer />
		</HStack>
		<Divider />
		<List id="codeFiles" data="codeFiles" onSelect="selectFile" style="plain" header="false" alternatingRows="false" rowHeight="<%= CODE.rowHeight %>" maxWidth="infinity" maxHeight="infinity">
			<Column id="display" title="" minWidth="160" />
		</List>
	</VStack>
	<Divider id="treeDivider" hidden="<%= tostring(treeHidden == true) %>" orientation="vertical" />
	<VStack spacing="0" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" alignment="leading">
		<HStack paddingHorizontal="<%= CODE.inset %>" paddingVertical="12" spacing="10" maxWidth="infinity" alignment="center">
			<SystemImage name="doc.text" size="16" color="accent" />
			<Label id="codeFileTitle" text="<%= code.name %>" size="<%= CODE.titleSize %>" weight="semibold" lines="1" flexShrink="1" />
			<Spacer />
			<Button id="treeToggle" accessibilityLabel="<%= treeHidden and "Show project tree" or "Hide project tree" %>" systemImage="sidebar.left" action="toggleTree" style="plain" controlSize="small" />
			<Button accessibilityLabel="Save" systemImage="square.and.arrow.down" action="saveSource" disabled="<%= tostring(busy == true) %>" style="glass" />
			<Label id="codeLanguage" text="<%= code.language:upper() %>" size="<%= CODE.captionSize %>" weight="semibold" color="secondary" />
		</HStack>
		<Divider />
		<CodeView id="sourceCode" text="<%= code.text %>" language="<%= code.language %>" editable="<%= tostring(not busy) %>" onChange="editSource" syntaxRules="syntaxRules" wrapMode="true" flexGrow="1" maxWidth="infinity" maxHeight="infinity" />
	</VStack>
</HStack>
