<%
  -- The open file, in place of the conversation. The Files view beside the
  -- card chooses the file; the leading button returns to the conversation.
	local CODE = { inset = 14, titleSize = 15, captionSize = 11 }
%>
<VStack id="codePane" hidden="<%= tostring(not shown) %>" spacing="0" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity" alignment="leading" background="background">
	<HStack paddingHorizontal="<%= CODE.inset %>" paddingVertical="12" spacing="10" maxWidth="infinity" alignment="center">
		<Button id="closeCode" accessibilityLabel="Show Conversation" systemImage="chevron.backward" action="showChat" style="glass" />
		<SystemImage name="doc.text" size="16" color="accent" />
		<Label id="codeFileTitle" text="<%= code.name %>" size="<%= CODE.titleSize %>" weight="semibold" lines="1" flexShrink="1" />
		<Spacer />
		<Label id="codeLanguage" text="<%= code.language:upper() %>" size="<%= CODE.captionSize %>" weight="semibold" color="secondary" />
		<Button accessibilityLabel="Save" systemImage="square.and.arrow.down" action="saveSource" disabled="<%= tostring(busy == true) %>" style="glass" />
	</HStack>
	<Divider />
	<CodeView id="sourceCode" text="<%= code.text %>" language="<%= code.language %>" editable="<%= tostring(not busy) %>" onChange="editSource" syntaxRules="syntaxRules" wrapMode="true" flexGrow="1" maxWidth="infinity" maxHeight="infinity" />
</VStack>
