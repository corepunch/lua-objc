<%
  -- A conversation, not a log: the request reads as a bubble from the user, the
  -- agent answers beside its avatar, and file edits collect in one card the
  -- user can review or undo. The composer floats on glass at the foot.
  -- The agent lives in a card floating on the workspace canvas. The card
  -- takes the width the stage leaves; the conversation keeps a readable
  -- measure centred in it, and the header names the agent answering. The
  -- rail switches the card between the conversation and the code; project
  -- actions belong to the window toolbar.
  local CHAT = {
    column = 720, inset = 16, spacing = 18, headerSpacing = 10,
    margin = 12, radius = 28, avatar = 36, turnAvatar = 26, nameSize = 16, modelSize = 12,
    bodySize = 15, bubbleInset = 12, bubbleRadius = 18, bubbleIndent = 56,
    turnSpacing = 10, captionSize = 12,
    welcomeInset = 48, welcomeMark = 72, welcomeRadius = 20, welcomeTitle = 22, welcomeMeasure = 440,
  }
%>
<VStack id="chatPane" tint="<%= tint %>" paddingVertical="<%= CHAT.margin %>" paddingTrailing="<%= CHAT.margin %>" spacing="0" flexGrow="1" flexBasis="0" minWidth="380" maxWidth="infinity" maxHeight="infinity">
	<VStack id="chatCard" spacing="0" flexGrow="1" maxWidth="infinity" maxHeight="infinity" alignment="leading" background="background" cornerRadius="<%= CHAT.radius %>" clipsToBounds="true">
		<HStack paddingHorizontal="<%= CHAT.inset %>" paddingVertical="<%= CHAT.inset - 4 %>" spacing="<%= CHAT.headerSpacing %>" maxWidth="infinity" alignment="center">
			<% -- The agent names itself and opens Settings when tapped, as the
			   -- model picker in a chat view does. %>
			<Button id="agentChooser" style="plain" action="openSettings" accessibilityLabel="Agent: <%= agent.name %>, <%= agent.model %>. Change provider or model" flexShrink="1">
				<HStack spacing="<%= CHAT.headerSpacing %>" alignment="center">
					<%- partial("../components/Avatar.etlua", { size = CHAT.avatar, colors = brand, icon = agent.icon, label = "" }) %>
					<VStack spacing="1" alignment="leading" flexShrink="1">
						<Label text="<%= agent.name %>" size="<%= CHAT.nameSize %>" weight="semibold" lines="1" />
						<Label text="<%= agent.model %>" size="<%= CHAT.modelSize %>" color="secondary" lines="1" truncation="middle" />
					</VStack>
				</HStack>
			</Button>
			<Spacer />
			<% -- The activity viewer, as Xcode centres one in its toolbar: the
			   -- status, a warning symbol for a problem, a spinner while the
			   -- agent thinks. %>
			<HStack id="activity" spacing="6" alignment="center" flexShrink="1" accessibilityLabel="Status: <%= status.text %>">
				<% if status.busy then %>
				<ProgressView id="activitySpinner" indeterminate="true" controlSize="small" />
				<% else %>
				<SystemImage id="activitySymbol" name="<%= status.tone == "problem" and "exclamationmark.triangle.fill" or "checkmark.circle.fill" %>" size="<%= CHAT.captionSize + 1 %>" color="<%= status.tone == "problem" and "systemOrange" or "secondary" %>" width="<%= CHAT.captionSize + 5 %>" label="" />
				<% end %>
				<Label id="previewStatus" text="<%= status.text %>" size="<%= CHAT.captionSize + 1 %>" color="<%= status.tone == "problem" and "label" or "secondary" %>" lines="1" truncation="tail" flexShrink="1" />
			</HStack>
			<Menu id="conversationMenu" systemImage="ellipsis" style="glass" accessibilityLabel="Conversation Options">
				<MenuItem title="New Conversation" systemImage="square.and.pencil" action="newConversation" />
				<MenuItem title="Choose Model…" systemImage="cpu" action="openSettings" />
				<Separator />
				<MenuItem title="Undo Last Change" systemImage="arrow.uturn.backward" action="undoChange" />
			</Menu>
		</HStack>
		<Divider />
		<ScrollView id="transcriptScroll" hidden="<%= tostring(mode == "code") %>" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
			<VStack spacing="0" maxWidth="infinity" alignment="center">
			<VStack padding="<%= CHAT.inset %>" spacing="<%= CHAT.spacing %>" maxWidth="<%= CHAT.column %>" alignment="leading">
				<% if welcome then %>
				<% -- Nothing said yet: the mark of the project, its name and what the
				   -- agent does, centred where the transcript will grow. %>
				<VStack id="welcome" paddingVertical="<%= CHAT.welcomeInset %>" spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="center">
					<ZStack width="<%= CHAT.welcomeMark %>" height="<%= CHAT.welcomeMark %>">
						<LinearGradient colors="<%= brand %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= CHAT.welcomeRadius %>" />
						<SystemImage name="<%= welcome.icon %>" size="<%= CHAT.welcomeMark // 2 %>" weight="semibold" color="white" label="" />
					</ZStack>
					<Label id="welcomeTitle" text="<%= welcome.title %>" size="<%= CHAT.welcomeTitle %>" weight="bold" lines="1" />
					<Label text="<%= welcome.text %>" size="<%= CHAT.bodySize %>" color="secondary" lines="0" alignment="center" maxWidth="<%= CHAT.welcomeMeasure %>" />
				</VStack>
				<% end %>
				<% for _, message in ipairs(messages) do %>
				<% if message.role == "user" then %>
				<HStack id="message/<%= message.id %>" spacing="0" maxWidth="infinity">
					<Spacer minWidth="<%= CHAT.bubbleIndent %>" />
					<% -- The gradient fills whatever the text measures: the bubble
					   -- declines to grow and takes the height of its text. %>
					<ZStack id="bubble/<%= message.id %>" flexGrow="0" flexShrink="1" fixedSize="vertical">
						<LinearGradient colors="<%= brand %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= CHAT.bubbleRadius %>" />
						<VStack padding="<%= CHAT.bubbleInset %>">
							<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" color="white" lines="0" />
						</VStack>
					</ZStack>
				</HStack>
				<% elseif message.role == "error" then %>
				<HStack id="message/<%= message.id %>" spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="center">
					<SystemImage name="exclamationmark.triangle.fill" size="<%= CHAT.captionSize + 2 %>" color="systemOrange" width="<%= CHAT.turnAvatar %>" label="Error" />
					<Label text="<%= message.text %>" size="<%= CHAT.captionSize + 1 %>" color="secondary" lines="0" flexShrink="1" maxWidth="infinity" />
				</HStack>
				<% else %>
				<HStack id="message/<%= message.id %>" spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="top">
					<%- partial("../components/Avatar.etlua", { size = CHAT.turnAvatar, colors = brand, icon = agent.icon, label = agent.name }) %>
					<VStack spacing="<%= CHAT.turnSpacing %>" flexGrow="1" flexShrink="1" alignment="leading">
						<% if message.text ~= "" then %>
						<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
						<% end %>
						<% if message.changes then %>
						<%- partial("../components/ChangeCard.etlua", { changes = message.changes, summary = message.summary }) %>
						<% end %>
						<% if message.conclusion then %>
						<Label text="<%= message.conclusion %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
						<% end %>
						<% if message.changes then %>
						<Label text="Preview updated" systemImage="checkmark.circle.fill" iconSize="<%= CHAT.captionSize %>" size="<%= CHAT.captionSize %>" color="secondary" />
						<% end %>
					</VStack>
				</HStack>
				<% end %>
				<% end %>
			</VStack>
			</VStack>
		</ScrollView>
		<%- partial("CodePane.etlua", { code = code, syntaxRules = syntaxRules, shown = mode == "code", treeHidden = treeHidden }) %>
		<VStack id="composerPane" hidden="<%= tostring(mode == "code") %>" spacing="0" maxWidth="infinity" alignment="center">
			<%- partial("../components/Composer.etlua", { suggestions = suggestions, draft = draft, busy = busy, inset = CHAT.inset, column = CHAT.column }) %>
		</VStack>
	</VStack>
</VStack>
