<%
  -- A conversation, not a log: the request reads as a bubble from the user, the
  -- agent answers beside its avatar, and file edits collect in one card the
  -- user can review or undo. The composer floats on glass at the foot.
  -- The agent lives in a card floating on the workspace canvas. The card
  -- takes the width the stage leaves; the conversation keeps a readable
  -- measure centred in it, and project actions sit in the header. The rail
  -- switches the card between the conversation and the code.
  local CHAT = {
    column = 720, inset = 16, spacing = 18, headerSpacing = 10,
    margin = 12, radius = 28, avatar = 36, turnAvatar = 26, nameSize = 16, modelSize = 12,
    bodySize = 15, bubbleInset = 12, bubbleRadius = 18, bubbleIndent = 56,
    turnSpacing = 10, captionSize = 12,
  }
%>
<VStack id="chatPane" hidden="<%= tostring(hidden == true) %>" tint="<%= tint %>" paddingVertical="<%= CHAT.margin %>" paddingTrailing="<%= CHAT.margin %>" spacing="0" flexGrow="1" flexBasis="0" maxWidth="infinity" maxHeight="infinity">
	<VStack id="chatCard" spacing="0" flexGrow="1" maxWidth="infinity" maxHeight="infinity" alignment="leading" background="background" cornerRadius="<%= CHAT.radius %>" clipsToBounds="true">
		<HStack paddingHorizontal="<%= CHAT.inset %>" paddingVertical="<%= CHAT.inset - 4 %>" spacing="<%= CHAT.headerSpacing %>" maxWidth="infinity" alignment="center">
			<%- partial("../components/Avatar.etlua", { size = CHAT.avatar, colors = brand, icon = agent.icon, label = agent.name }) %>
			<VStack spacing="1" alignment="leading" flexShrink="1">
				<Label text="<%= agent.name %>" size="<%= CHAT.nameSize %>" weight="semibold" lines="1" />
				<Label text="<%= agent.model %>" size="<%= CHAT.modelSize %>" color="secondary" lines="1" truncation="middle" />
			</VStack>
			<Spacer />
			<Button accessibilityLabel="Commit" systemImage="point.3.connected.trianglepath.dotted" action="commitProject" disabled="<%= tostring(busy == true) %>" style="glass" />
			<Button accessibilityLabel="Share" action="shareProject" disabled="<%= tostring(busy == true) %>" systemImage="square.and.arrow.up" style="glass" />
			<Button accessibilityLabel="Export" action="showExport" disabled="<%= tostring(busy == true) %>" systemImage="paperplane.fill" style="glassProminent" />
			<Menu systemImage="ellipsis" style="glass" accessibilityLabel="Conversation Options">
				<MenuItem title="New Conversation" action="newConversation" systemImage="square.and.pencil" />
				<MenuItem title="Choose Model…" action="showSettings" systemImage="cpu" />
				<Separator />
				<MenuItem title="Undo Last Change" action="undoChange" disabled="<%= tostring(busy == true) %>" systemImage="arrow.uturn.backward" />
			</Menu>
		</HStack>
		<Divider />
		<ScrollView id="transcriptScroll" hidden="<%= tostring(mode == "code") %>" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
			<VStack spacing="0" maxWidth="infinity" alignment="center">
			<VStack padding="<%= CHAT.inset %>" spacing="<%= CHAT.spacing %>" maxWidth="<%= CHAT.column %>" alignment="leading">
				<% if #messages == 0 then %>
				<Label text="Build your iPhone app here" size="20" weight="semibold" />
				<Label text="Describe a change, edit the source, or start from a template. Add your OpenRouter key in Settings to use the agent." lines="0" color="secondary" maxWidth="infinity" />
				<% end %>
				<% for _, message in ipairs(messages) do %>
				<% if message.role == "user" then %>
				<HStack id="message/<%= message.id %>" spacing="0" maxWidth="infinity">
					<Spacer minWidth="<%= CHAT.bubbleIndent %>" />
					<% -- The gradient fills whatever the text measures: the bubble
					   -- declines to grow and takes the height of its text. %>
					<ZStack id="bubble/<%= message.id %>" flexGrow="0" flexShrink="1" fixedSize="vertical">
						<LinearGradient colors="<%= brand %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= CHAT.bubbleRadius %>" />
						<VStack padding="<%= CHAT.bubbleInset %>">
							<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" color="white" lines="0" />
						</VStack>
					</ZStack>
				</HStack>
				<% else %>
				<HStack id="message/<%= message.id %>" spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="top">
					<%- partial("../components/Avatar.etlua", { size = CHAT.turnAvatar, colors = brand, icon = agent.icon, label = agent.name }) %>
					<VStack spacing="<%= CHAT.turnSpacing %>" flexGrow="1" flexShrink="1" alignment="leading">
						<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
						<% if message.changes then %>
						<%- partial("../components/ChangeCard.etlua", { changes = message.changes, summary = message.summary }) %>
						<% end %>
						<% if message.conclusion then %>
						<Label text="<%= message.conclusion %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
						<% end %>
						<% if message.previewState == "ready" then %>
						<Label text="Preview updated" systemImage="checkmark.circle.fill" iconSize="<%= CHAT.captionSize %>" size="<%= CHAT.captionSize %>" color="secondary" />
						<% elseif message.previewState == "error" then %>
						<Label text="Preview failed. Last working version kept." systemImage="exclamationmark.triangle.fill" iconSize="<%= CHAT.captionSize %>" size="<%= CHAT.captionSize %>" color="systemOrange" lines="0" maxWidth="infinity" />
						<% end %>
					</VStack>
				</HStack>
				<% end %>
				<% end %>
			</VStack>
			</VStack>
		</ScrollView>
		<%- partial("CodePane.etlua", { code = code, syntaxRules = syntaxRules, shown = mode == "code", treeHidden = treeHidden, projectTitle = projectTitle, busy = busy }) %>
		<VStack id="composerPane" hidden="<%= tostring(mode == "code") %>" spacing="0" maxWidth="infinity" alignment="center">
			<%- partial("../components/Composer.etlua", { suggestions = suggestions, draft = draft, listening = listening, inset = CHAT.inset, column = CHAT.column, busy = busy, attachments = attachments }) %>
		</VStack>
	</VStack>
</VStack>
