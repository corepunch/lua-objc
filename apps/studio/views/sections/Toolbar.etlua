<%
  -- The window toolbar on Liquid Glass, laid out as Xcode lays out its own:
  -- the project chooser leads, an activity viewer sits in the centre with
  -- the status and a spinner while the agent works, and the inspector-like
  -- chat toggle trails. Run and Commit are on the rail, as in an activity
  -- bar. The bar spans the stage and the agent card, so nothing project-wide
  -- crowds either of them.
  local BAR = { inset = 16, spacing = 10, statusSize = 13, activityInset = 14, activityRadius = 18, activitySpacing = 8, symbol = 13 }
  local problem = tone == "problem"
%>
<HStack id="toolbar" tint="<%= tint %>" paddingHorizontal="<%= BAR.inset %>" paddingTop="<%= BAR.inset %>" spacing="0" maxWidth="infinity">
	<GlassEffectContainer spacing="<%= BAR.spacing %>" maxWidth="infinity" tint="<%= tint %>">
		<HStack id="toolbarItems" spacing="<%= BAR.spacing %>" maxWidth="infinity" alignment="center">
			<Menu id="projectMenu" title="<%= project.title %>" systemImage="<%= project.icon %>" imagePath="<%= project.imagePath or "" %>" style="glass" accessibilityLabel="Project: <%= project.title %>">
				<% for _, item in ipairs(projects) do %>
				<MenuItem title="<%= item.title %>" systemImage="<%= item.icon %>" imagePath="<%= item.imagePath or "" %>" checked="<%= tostring(item.selected == true) %>"<% if item.action then %> action="<%= item.action %>"<% end %> />
				<% end %>
				<Separator />
				<% for _, choice in ipairs(iconChoices) do %>
				<MenuItem title="Use <%= choice.title %> Icon" systemImage="<%= choice.symbol %>" imagePath="<%= choice.imagePath %>" checked="<%= tostring(choice.selected) %>" action="<%= choice.action %>" />
				<% end %>
				<Separator />
				<% for _, destination in ipairs(destinations) do %>
				<MenuItem title="<%= destination.title %>" systemImage="<%= destination.icon %>" action="<%= destination.action %>" />
				<% end %>
			</Menu>
			<Spacer />
			<GlassEffect id="activity" cornerRadius="<%= BAR.activityRadius %>" flexShrink="1">
				<HStack paddingHorizontal="<%= BAR.activityInset %>" paddingVertical="<%= BAR.activitySpacing %>" spacing="<%= BAR.activitySpacing %>" alignment="center" accessibilityLabel="Status: <%= status %>">
					<% if busy then %>
					<ProgressView id="activitySpinner" indeterminate="true" controlSize="small" />
					<% else %>
					<SystemImage id="activitySymbol" name="<%= problem and "exclamationmark.triangle.fill" or "checkmark.circle.fill" %>" size="<%= BAR.symbol %>" color="<%= problem and "systemOrange" or "secondary" %>" width="<%= BAR.symbol + 4 %>" label="" />
					<% end %>
					<Label id="previewStatus" text="<%= status %>" size="<%= BAR.statusSize %>" color="<%= problem and "label" or "secondary" %>" lines="1" truncation="tail" flexShrink="1" />
				</HStack>
			</GlassEffect>
			<Spacer />
			<Button id="chatVisibility" systemImage="sidebar.trailing" accessibilityLabel="<%= chatHidden and "Show Chat" or "Focus Preview" %>" action="toggleChat" style="glass" />
		</HStack>
	</GlassEffectContainer>
</HStack>
