<%
  -- The window toolbar on Liquid Glass: the project menu and the status
  -- line lead, the chat toggle trails. Run and Commit are on the rail, as
  -- in an activity bar. It spans the stage and the agent card, so nothing
  -- project-wide crowds either of them.
  local BAR = { inset = 16, spacing = 10, statusSize = 13 }
%>
<HStack id="toolbar" tint="<%= tint %>" paddingHorizontal="<%= BAR.inset %>" paddingTop="<%= BAR.inset %>" spacing="0" maxWidth="infinity">
	<GlassEffectContainer spacing="<%= BAR.spacing %>" maxWidth="infinity" tint="<%= tint %>">
		<HStack id="toolbarItems" spacing="<%= BAR.spacing %>" maxWidth="infinity" alignment="center">
			<Menu id="projectMenu" title="<%= project.title %>" systemImage="<%= project.icon %>" imagePath="<%= project.imagePath or "" %>" style="glass" accessibilityLabel="Project: <%= project.title %>">
				<% for _, item in ipairs(projects) do %>
				<MenuItem title="<%= item.title %>" systemImage="<%= item.icon %>" imagePath="<%= item.imagePath or "" %>" checked="<%= tostring(item.selected == true) %>"<% if item.action then %> action="<%= item.action %>"<% end %> />
				<% end %>
				<Separator />
				<% for _, choice in ipairs(iconChoices) do %>
				<MenuItem title="Use <%= choice.title %> Icon" systemImage="<%= choice.symbol %>" imagePath="<%= choice.imagePath %>" checked="<%= tostring(choice.selected) %>" action="<%= choice.action %>" />
				<% end %>
				<Separator />
				<% for _, destination in ipairs(destinations) do %>
				<MenuItem title="<%= destination.title %>" systemImage="<%= destination.icon %>" action="<%= destination.action %>" />
				<% end %>
			</Menu>
			<HStack spacing="6" alignment="center" flexShrink="1">
				<SystemImage name="<%= busy and "ellipsis.circle" or "checkmark.circle.fill" %>" size="<%= BAR.statusSize %>" color="secondary" />
				<Label id="previewStatus" text="<%= status %>" size="<%= BAR.statusSize %>" color="secondary" lines="1" truncation="tail" />
			</HStack>
			<Spacer />
			<Button id="chatVisibility" systemImage="sidebar.trailing" accessibilityLabel="<%= chatHidden and "Show Chat" or "Focus Preview" %>" action="toggleChat" style="glass" />
		</HStack>
	</GlassEffectContainer>
</HStack>
