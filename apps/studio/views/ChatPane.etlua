<%
  -- A conversation, not a log: the request reads as a bubble from the user, the
  -- agent answers beside its symbol, and file edits collect in one card the
  -- user can review or undo. The composer floats on glass at the foot.
  -- The pane takes the width the stage leaves; the conversation keeps a
  -- readable measure centred in it, and project actions sit in the header.
  local CHAT = {
    column = 720, inset = 16, spacing = 18, headerSpacing = 10,
    agentSymbol = 22, nameSize = 16, modelSize = 12,
    bodySize = 15, bubbleInset = 12, bubbleRadius = 18, bubbleIndent = 56,
    turnSpacing = 10, captionSize = 12,
  }
%>
<VStack id="chatPane" spacing="0" flexGrow="1" flexBasis="0" minWidth="380" maxWidth="infinity" maxHeight="infinity" alignment="leading" background="background">
	<HStack paddingHorizontal="<%= CHAT.inset %>" paddingVertical="<%= CHAT.inset - 4 %>" spacing="<%= CHAT.headerSpacing %>" maxWidth="infinity" alignment="center">
		<SystemImage name="sparkles" size="<%= CHAT.agentSymbol %>" color="accent" label="<%= agent.name %>" />
		<VStack spacing="1" alignment="leading" flexShrink="1">
			<Label text="<%= agent.name %>" size="<%= CHAT.nameSize %>" weight="semibold" lines="1" />
			<Label text="<%= agent.model %>" size="<%= CHAT.modelSize %>" color="secondary" lines="1" truncation="middle" />
		</VStack>
		<Spacer />
		<Picker id="chatMode" style="segmented" value="0">
			<% for _, mode in ipairs(modes) do %>
			<Option title="<%= mode %>" />
			<% end %>
		</Picker>
		<Button title="Commit" systemImage="point.3.connected.trianglepath.dotted" action="commitProject" style="glass" />
		<Button title="Share" systemImage="square.and.arrow.up" style="glass" />
		<Button title="Deploy" systemImage="paperplane" style="glassProminent" />
		<Menu systemImage="ellipsis" style="glass" accessibilityLabel="Conversation Options">
			<MenuItem title="New Conversation" systemImage="square.and.pencil" />
			<MenuItem title="Choose Model…" systemImage="cpu" />
			<Separator />
			<MenuItem title="Undo Last Change" systemImage="arrow.uturn.backward" />
		</Menu>
	</HStack>
	<Divider />
	<ScrollView id="transcriptScroll" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
		<VStack spacing="0" maxWidth="infinity" alignment="center">
		<VStack padding="<%= CHAT.inset %>" spacing="<%= CHAT.spacing %>" maxWidth="<%= CHAT.column %>" alignment="leading">
			<HStack spacing="0" maxWidth="infinity">
				<Spacer minWidth="<%= CHAT.bubbleIndent %>" />
				<VStack padding="<%= CHAT.bubbleInset %>" flexShrink="1" background="accent" cornerRadius="<%= CHAT.bubbleRadius %>">
					<Label text="<%= prompt %>" size="<%= CHAT.bodySize %>" color="white" lines="0" />
				</VStack>
			</HStack>
			<HStack spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="top">
				<SystemImage name="sparkles" size="<%= CHAT.bodySize %>" color="accent" label="<%= agent.name %>" />
				<VStack spacing="<%= CHAT.turnSpacing %>" flexGrow="1" flexShrink="1" alignment="leading">
					<Label text="<%= response %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
					<%- partial("ChangeCard.etlua", { changes = changes, summary = changeSummary }) %>
					<Label text="<%= conclusion %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
					<Label text="Preview updated" systemImage="checkmark.circle.fill" iconSize="<%= CHAT.captionSize %>" size="<%= CHAT.captionSize %>" color="secondary" />
				</VStack>
			</HStack>
		</VStack>
		</VStack>
	</ScrollView>
	<VStack spacing="0" maxWidth="infinity" alignment="center">
		<%- partial("Composer.etlua", { suggestions = suggestions, inset = CHAT.inset, column = CHAT.column }) %>
	</VStack>
</VStack>
