<VStack ref="chatPane" padding="12" spacing="8" flexGrow="1" flexBasis="0" minWidth="330" fillWidth="true" fillHeight="true" alignment="leading" background="background" cornerRadius="16">
	<HStack padding="0" spacing="8" fillWidth="true">
		<Label text="Chat" size="17" weight="semibold" />
		<Label text="Code" size="17" color="secondary" />
		<Spacer />
		<Button title="Git" systemImage="point.3.connected.trianglepath.dotted" style="bordered" />
		<Button title="Share" systemImage="square.and.arrow.up" style="bordered" />
		<Button title="Deploy" systemImage="paperplane" style="borderedProminent" />
	</HStack>
	<HStack padding="0" spacing="18" fillWidth="true">
		<% for _, tab in ipairs(tabs) do %>
		<Label text="<%= tab %>" size="13" color="secondary" />
		<% end %>
		<Spacer />
		<Label text="<%= status %>" size="11" color="secondary" />
	</HStack>
	<Divider />
	<GroupBox padding="14" background="secondaryBackground" cornerRadius="16" fillWidth="true">
		<Label text="<%= prompt %>" size="14" fillWidth="true" lines="5" />
	</GroupBox>
	<HStack padding="0" spacing="10" fillWidth="true" alignment="top">
		<SystemImage name="sparkles" size="24" color="accent" />
		<Label text="<%= response %>" size="14" fillWidth="true" lines="5" />
	</HStack>
	<GroupBox padding="10" background="secondaryBackground" cornerRadius="12" fillWidth="true">
		<VStack padding="0" spacing="0" fillWidth="true" alignment="leading">
			<HStack padding="4" spacing="8" fillWidth="true">
				<SystemImage name="chevron.down" size="11" color="secondary" />
				<Label text="Created 6 files" size="13" weight="semibold" fillWidth="true" />
			</HStack>
			<% for _, file in ipairs(files) do %>
			<HStack padding="4" spacing="8" fillWidth="true">
				<SystemImage name="<%= file:find('/') and 'folder.fill' or 'doc.text' %>" size="14" color="accent" />
				<Label text="<%= file %>" size="13" fillWidth="true" />
				<% if file:find('/') or file == 'App.lua' or file == 'Info.plist' then %>
				<SystemImage name="plus" size="12" color="secondary" />
				<% end %>
			</HStack>
			<% end %>
		</VStack>
	</GroupBox>
	<Label text="The app is ready. Run it in the preview to try it out. It uses local storage to save your habits and progress." size="14" fillWidth="true" lines="3" />
	<Label text="SUGGESTIONS" size="10" weight="semibold" color="secondary" />
	<HStack padding="0" spacing="6" fillWidth="true">
		<% for _, suggestion in ipairs(suggestions) do %>
			<Button title="<%= suggestion %>" size="12" style="bordered" />
		<% end %>
	</HStack>
	<GroupBox padding="4" background="secondaryBackground" cornerRadius="14" fillWidth="true">
		<TextEditor ref="composer" text="" size="15" fixedHeight="90" fillWidth="true" />
	</GroupBox>
	<HStack padding="0" spacing="8" fillWidth="true">
		<Button title="Dictate" systemImage="mic" />
		<Spacer />
		<Button title="Stop" />
		<Button title="Send" systemImage="arrow.up" style="borderedProminent" />
	</HStack>
</VStack>
