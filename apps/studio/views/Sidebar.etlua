<VStack ref="sidebar" padding="<%= collapsed and metrics.collapsedPadding or metrics.expandedPadding %>" spacing="10" fixedWidth="<%= collapsed and metrics.collapsedWidth or metrics.expandedWidth %>" fillHeight="true" alignment="leading" background="secondaryBackground">
	<% if not collapsed then %>
	<Button title="New Project" systemImage="plus" style="borderedProminent" fillWidth="true" />
	<Label text="RECENT PROJECTS" size="10" weight="semibold" color="secondary" />
	<% end %>
	<VStack padding="0" spacing="5" fillWidth="true" alignment="leading">
		<% for _, project in ipairs(projects) do %>
		<%- partial("SidebarItem.etlua", {item = project, collapsed = collapsed, metrics = metrics}) %>
		<% end %>
	</VStack>
	<Spacer />
	<Divider />
	<% for _, item in ipairs(links) do %>
	<%- partial("SidebarItem.etlua", {item = item, collapsed = collapsed, metrics = metrics}) %>
	<% end %>
	<% if not collapsed then %>
	<Label text="Documents · local workspace" size="10" color="secondary" lines="2" />
	<% end %>
</VStack>
