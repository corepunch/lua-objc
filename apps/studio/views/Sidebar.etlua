<VStack padding="18" spacing="16" fixedWidth="238" fillHeight="true" alignment="leading">
	<HStack padding="0" spacing="10" fillWidth="true">
		<SystemImage name="hammer.fill" size="26" />
		<VStack padding="0" spacing="1" alignment="leading">
			<Label text="Lua Studio" size="20" weight="bold" />
			<Label text="IDEA → APP → PREVIEW" size="10" color="secondary" />
		</VStack>
	</HStack>
	<Button title="New Project" systemImage="plus" style="borderedProminent" fillWidth="true" />
	<Label text="RECENT PROJECTS" size="11" weight="semibold" color="secondary" />
	<VStack padding="0" spacing="5" fillWidth="true" alignment="leading">
		<% for index, project in ipairs(projects) do %>
		<% if index == 1 then %>
		<Button title="<%= project.name %>" subtitle="<%= project.detail %>" systemImage="<%= project.icon %>" style="borderedProminent" fillWidth="true" />
		<% else %>
		<Button title="<%= project.name %>" subtitle="<%= project.detail %>" systemImage="<%= project.icon %>" fillWidth="true" />
		<% end %>
		<% end %>
	</VStack>
	<Spacer />
	<Divider />
	<% for _, item in ipairs(links) do %>
	<Button title="<%= item.name %>" systemImage="<%= item.icon %>" fillWidth="true" />
	<% end %>
	<Label text="Documents · local workspace" size="11" color="secondary" lines="2" />
</VStack>
