<Window title="Native Motion Feedback" width="520" height="400">
  <VStack spacing="12" padding="16" fillWidth="true" fillHeight="true">
    <Button title="Add item" action="addItem" />
    <List ref="items" data="items" style="plain" flexGrow="1" fillWidth="true">
      <Column id="title" title="Items" />
    </List>
  </VStack>
</Window>
