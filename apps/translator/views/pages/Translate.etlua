<% --[[
  English in, Russian out as the person types: the window split in two
  equal halves that never change size, so typing moves nothing. The top
  half is the editor on the window's own background; the bottom half is
  the translation on the secondary background, in a read-only editor so it
  can be selected and its text starts on the same edge as the English. The
  languages are the title bar's title and subtitle, and Clear and Copy its
  items (app.xml). The editor hands every keystroke to `edit` and is never
  rebuilt, so it keeps its caret. ]] %>
<VStack spacing="0" maxWidth="infinity" maxHeight="infinity">
  <VStack padding="@pagePadding" alignment="leading" maxWidth="infinity" maxHeight="infinity" flexGrow="1" flexBasis="0">
    <TextEditor id="english" text="<%= text %>" onChange="edit" placeholder="@placeholder" size="@textSize" design="default" wrapMode="true" drawsBackground="false" maxWidth="infinity" maxHeight="infinity" accessibilityLabel="English text" />
  </VStack>
  <Divider />
  <VStack padding="@pagePadding" alignment="leading" maxWidth="infinity" maxHeight="infinity" flexGrow="1" flexBasis="0" background="secondaryBackground" ignoresSafeArea="bottom">
    <% if failure then %>
    <Label id="failure" text="<%= failure %>" color="systemRed" lines="0" maxWidth="infinity" />
    <% else %>
    <TextEditor id="russian" text="<%= russian %>" editable="false" size="@textSize" design="default" wrapMode="true" drawsBackground="false" maxWidth="infinity" maxHeight="infinity" accessibilityLabel="Russian translation" />
    <% end %>
  </VStack>
</VStack>
