<GroupBox>
  <VStack spacing="@cardSpacing" alignment="leading" maxWidth="infinity">
    <HStack alignment="center" maxWidth="infinity">
      <Label text="@targetLanguage" size="@captionSize" weight="semibold" color="secondary" />
      <Spacer />
      <Button id="copy" systemImage="doc.on.doc" style="plain" accessibilityLabel="Copy" action="copy" />
    </HStack>
    <% if failure then %>
    <Label id="failure" text="<%= failure %>" color="systemRed" lines="0" />
    <% else %>
    <Label id="russian" text="<%= russian %>" size="@resultSize" lines="0" />
    <% end %>
  </VStack>
</GroupBox>
