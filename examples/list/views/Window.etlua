<% extends("views/AppWindow.etlua", {
    title = "Employee Directory",
    width = 640,
    height = 420,
}) %>
<% block("content", [[
    <%= partial("views/partials/SimpleList.etlua", {
        ref = "employeeList",
        columns = {
            { id = "name", title = "Name" },
            { id = "role", title = "Role" },
            { id = "dept", title = "Department" },
        },
    }) %>
]]) %>
