<Window title="Mail" width="940" height="520" minWidth="640" minHeight="400">
    <Toolbar>
        <ToolbarItem id="compose" label="Compose" icon="square.and.pencil" tooltip="New Message" />
    </Toolbar>
    <HSplit>
        <List ref="mailboxList" fixedWidth="180" flexGrow="0"
              style="sourceList" header="false" alternatingRows="false">
            <Column id="name" title="Mailbox" />
        </List>
        <List ref="messageList" fixedWidth="280" flexGrow="0"
              style="plain" header="false" alternatingRows="false">
            <Column id="from" title="From" />
        </List>
        <VStack ref="detailPane" flexGrow="1" />
    </HSplit>
</Window>
