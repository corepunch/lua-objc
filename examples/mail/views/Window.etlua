<Window title="Mail" width="1040" height="620" minWidth="760" minHeight="460"
    sidebarWidth="220" toolbarContentDividerAfter="toggleSidebar">
    <Toolbar>
        <ToolbarItem id="toggleSidebar" />
        <ToolbarItem id="compose" label="Compose" icon="square.and.pencil" tooltip="New Message" />
    </Toolbar>
</Window>
