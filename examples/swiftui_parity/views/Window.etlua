<Window title="SwiftUI parity" width="480" height="160" minWidth="320" minHeight="120">
	<% if caseId == "text.single.default" then %>
	<VStack padding="24" spacing="12" fillWidth="true">
		<Label text="<%= body %>" size="24" ref="text" />
	</VStack>
	<% elseif caseId == "stack.h.spacing.default-text-spacer" then %>
	<HStack padding="24" spacing="12" fillWidth="true" alignment="center">
		<Label text="<%= left %>" ref="left" />
		<Spacer />
		<Label text="<%= right %>" ref="right" />
	</HStack>
	<% elseif caseId == "button.standard.action-counter" then %>
	<VStack padding="24" spacing="12" alignment="center">
		<Button title="<%= buttonTitle %>" action="activate" ref="button" />
		<Label text="Count: 0" ref="counter" />
	</VStack>
	<% elseif caseId == "surface.background-rounded" then %>
	<VStack padding="24" spacing="12" fillWidth="true" background="systemGreen" cornerRadius="16" clipsToBounds="true">
		<Label text="<%= body %>" size="20" ref="surface" />
	</VStack>
	<% elseif caseId == "grid.two-by-two" then %>
	<Grid padding="24" spacing="12" alignment="center" fillWidth="true">
		<GridRow spacing="24"><Label text="<%= cells[1] %>" /><Label text="<%= cells[2] %>" /></GridRow>
		<GridRow spacing="24"><Label text="<%= cells[3] %>" /><Label text="<%= cells[4] %>" /></GridRow>
	</Grid>
	<% elseif caseId == "text.long-ellipsis-italic" then %>
	<VStack padding="24" fillWidth="true" alignment="center">
		<Label text="<%= body %>" size="18" italic="true" alignment="center" lines="1" truncation="tail" ref="styled" />
	</VStack>
	<% elseif caseId == "image.system-icon" then %>
	<VStack padding="24" spacing="12" fillWidth="true" alignment="center">
		<SystemImage name="<%= name %>" size="32" color="accent" label="<%= label %>" ref="icon" />
		<Label text="<%= label %>" />
	</VStack>
	<% elseif caseId == "padding.vertical-edges" then %>
	<VStack paddingTop="8" paddingBottom="40" fillWidth="true" alignment="center" background="systemGreen" cornerRadius="12">
		<Label text="<%= body %>" />
	</VStack>
	<% elseif caseId == "container.section-groupbox" then %>
	<VStack padding="16" spacing="12" fillWidth="true">
		<Section header="Overview">
			<Label text="<%= body %>" />
		</Section>
		<GroupBox header="Details" background="systemGreen" cornerRadius="12">
			<Label text="Grouped native content" />
		</GroupBox>
	</VStack>
	<% elseif caseId == "container.disclosure-expanded" then %>
	<VStack padding="16" fillWidth="true">
		<DisclosureGroup label="Advanced" expanded="true">
			<Label text="<%= body %>" />
		</DisclosureGroup>
	</VStack>
	<% elseif caseId == "container.form-labeled-control-group" then %>
	<Form padding="16" spacing="12" fillWidth="true">
		<LabeledContent label="Name" spacing="12">
			<Label text="<%= body %>" />
		</LabeledContent>
		<ControlGroup spacing="8">
			<Button title="Cancel" />
			<Button title="Save" />
		</ControlGroup>
	</Form>
	<% else %>
	<Label text="Unknown parity case" />
	<% end %>
</Window>
