<% --[[ The speed run: devices line a corridor the camera flies down, and on
  every beat one of them takes the next agent edit (its before capture
  gives way to its after). "SAY IT. CHANGE IT. SEE IT." hang in the air as
  planes the camera flies through. At the end, the hero composition: the
  Mac, the iPad and the iPhone at different depths and angles. ]]
  local S = C.SHOT
  local X = C.CORRIDOR
  local on = 'from="' .. S.speed - 0.05 .. '"'
  local function img(name, density, extra) return string.format('<Image src="%s%s.png" density="%s" %s />', cap, name, density, extra or "") end
  local function beat(a, b) return string.format('from="%s" to="%s"', a, b) end
  local function flash(at) return string.format('<Rect width="2000" height="2000" color="#FFFFFF" alpha="0.55 * exp(-max(0, t - %f) / 0.09) * step(t - %f)" />', at, at - 1e-5) end
  local WORDS = { { "SAY IT.", -5.6 }, { "CHANGE IT.", -9.4 }, { "SEE IT.", -13.2 } }
%>
<%- partial("devices/Display.etlua", {id = "runDisplay", position = X - 2.6 .. " 0.5 -3.6", rotation = "0 32 0", extra = on,
	screen = partial("screens/Desktop.etlua", {window = "todo-v0"})
		.. '<Window capture="todo-v1" x="800" y="450" radius="16" ' .. beat(25.0, 25.5) .. ' />'
		.. '<Window capture="todo-v2" x="800" y="450" radius="16" ' .. beat(25.5, 26.0) .. ' />'
		.. '<Window capture="todo-v3" x="800" y="450" radius="16" from="26.0" />'
		.. flash(25.0) .. flash(25.5) .. flash(26.0)}) %>
<%- partial("devices/Pad.etlua", {id = "runPad", position = X + 2.3 .. " 0.25 -7.4", rotation = "-3 -34 0", extra = on,
	screen = img("studio-v1", 2, 'to="25.5"') .. img("studio-v2", 2, beat(25.5, 26.0)) .. img("studio-v3", 2, 'from="26.0"')
		.. flash(25.5) .. flash(26.0)}) %>
<%- partial("devices/Phone.etlua", {id = "runPhone", position = X - 1.4 .. " 0.15 -11.0", rotation = "-4 36 -3", extra = on, density = 3,
	screen = img("todo-iphone-v2", 3, 'to="26.0"') .. img("todo-iphone-v3", 3, 'from="26.0"') .. flash(26.0)}) %>
<%- partial("devices/Window.etlua", {id = "runLedger", position = X + 2.0 .. " 0.45 -14.4", rotation = "0 -32 0", extra = on,
	screen = '<Window capture="ledger-v0" x="600" y="380" to="26.5" /><Window capture="ledger-v1" x="600" y="380" from="26.5" />' .. flash(26.5)}) %>
<%- partial("devices/Window.etlua", {id = "runNotes", position = X - 2.1 .. " 0.55 -17.2", rotation = "0 30 0", extra = on,
	screen = '<Window capture="notes-v0" x="600" y="380" to="27.0" /><Window capture="notes-v1" x="600" y="380" from="27.0" />' .. flash(27.0)}) %>

<% for index, word in ipairs(WORDS) do -%>
<Node id="word<%= index %>" geometry="plane" width="5.2" height="1.3" position="<%= X %> 0.3 <%= word[2] %>" lighting="constant" doubleSided="true" writesDepth="false" order="10" <%- on %>>
	<Surface width="1040" height="260" density="1" slot="diffuse" background="#00000000">
		<Text style="wall" text="<%= word[1] %>" x="520" y="200" at="0" />
	</Surface>
</Node>
<% end -%>

<!-- The hero composition. -->
<%- partial("devices/Display.etlua", {id = "heroDisplay", position = X + 0.6 .. " 1.05 -35.2", rotation = "0 16 0", extra = on,
	screen = partial("screens/Desktop.etlua", {window = "ledger-v1"})}) %>
<%- partial("devices/Pad.etlua", {id = "heroPad", position = X + 2.5 .. " -0.05 -31.0", rotation = "-4 -9 0", extra = on,
	screen = img("studio-v3", 2)}) %>
<%- partial("devices/Phone.etlua", {id = "heroPhone", position = X + 4.35 .. " -0.5 -28.4", rotation = "-8 -30 -2", extra = on, density = 3,
	screen = img("todo-iphone-v3", 3)}) %>
