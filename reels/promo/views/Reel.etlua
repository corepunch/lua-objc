<Reel width="1920" height="1080" fps="30" duration="30" bpm="120" subframes="<%= subframes or '5 + 5 * step(t - 12.95) * step(14.3 - t) + 4 * step(t - 20.8) * step(21.85 - t) + 5 * step(t - 24.95) * step(27.9 - t)' %>" shutter="0.5" background="#07070A">
  <Palette name="brand" colors="#7B8CFF #B86BFF #FF7AB8" />
  <Palette name="code" colors="#5EE08A #3CC6FF" />
  <Style name="giant" size="136" weight="bold" color="#F5F5F7" tracking="-0.03" />
  <Style name="giantBrand" size="136" weight="bold" gradient="brand" tracking="-0.03" />
  <Style name="huge" size="118" weight="bold" color="#F5F5F7" tracking="-0.03" />
  <Style name="hugeBrand" size="118" weight="bold" gradient="brand" tracking="-0.03" />
  <Style name="big" size="100" weight="bold" color="#F5F5F7" tracking="-0.03" />
  <Style name="bigBrand" size="100" weight="bold" gradient="brand" tracking="-0.03" />
  <Style name="wall" size="200" weight="heavy" color="#FFFFFF" tracking="-0.03" />
  <Style name="label" size="30" weight="semibold" color="#F5F5F7" tracking="-0.01" />
  <Style name="kicker" size="22" weight="semibold" color="#A1A1A6" tracking="0.18" />
  <Style name="code" size="24" weight="regular" color="#8FE3B0" design="mono" />
  <Style name="codeGreen" size="26" weight="medium" color="#6EE7A0" design="mono" />
  <Style name="sub" size="34" weight="regular" color="#C7C7CC" tracking="-0.01" />
  <Style name="chip" size="44" weight="semibold" color="#F5F5F7" tracking="-0.02" />
  <Style name="logo" size="150" weight="bold" color="#F5F5F7" tracking="-0.035" />
  <Style name="tagline" size="54" weight="semibold" color="#F5F5F7" tracking="-0.02" />
  <Style name="taglineBrand" size="54" weight="semibold" gradient="brand" tracking="-0.02" />
  <Style name="small" size="30" weight="regular" color="#A1A1A6" tracking="-0.01" />
  <Style name="url" size="30" weight="medium" color="#7B8CFF" tracking="-0.01" />

  <!-- The stage: a dark studio with a cool light behind the subject. -->
  <Glow x="960 + 120 * sin(t * 0.21)" y="470" radius="1250" colors="{rgb(0x262A40, 1), rgb(0x131420, 0.7), rgb(0, 0)}" locations="0, 0.55, 1" resolution="0.25" />
  <%- partial("World.etlua", reel) %>
  <%- partial("Quest.etlua", reel) %>
  <Vignette inner="620" outer="1350" />
  <%- partial("Type.etlua", reel) %>
  <!-- The cut into the game: a flash of the glass. -->
  <Rect width="1920" height="1080" color="#FFFFFF" alpha="0.35 * exp(-max(0, t - <%= C.SHOT.cut %>) / 0.08) * step(t - <%= C.SHOT.cut - 1e-4 %>)" />
  <Rect width="1920" height="1080" color="#000000" alpha="progress(t, 29.7, 30)" />
</Reel>
