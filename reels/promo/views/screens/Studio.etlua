<% --[[ The iPad's screen, 1376 × 1032 pt. Ledger first (the composition),
  then Lua Studio opening on the Tasks project: the first prompt is typed
  into the composer and sent, the agent's edit and the new preview appear
  (the next capture), and again. Typing reveals the capture's own draft
  from behind a patch of the field's own colour; nothing is drawn that the
  capture does not show. When the phone lifts off, the preview's place is
  covered with the pane's own colour. ]]
  local S = C.SHOT
  local P = C.PREVIEW
  -- The draft in the composer spans x 600…763 in every capture, on the
  -- glass of the field.
  local FIELD = { x = 599, y = 984, right = 770, h = 22, text = 166, color = "#FDFDFD" }
  local function img(name, extra) return string.format('<Image src="%s%s.png" density="2" %s />', cap, name, extra or "") end
  local send1, send2 = S.send1, S.send2
%>
<%- img("ledger-ipad", 'to="6.5"') %>
<Group x="688" y="516" anchor="688, 516" from="6.25" alpha="outCubic(progress(t, 6.25, 6.5))" scale="0.93 + 0.07 * outCubic(progress(t, 6.25, 6.55))">
	<%- img("studio-v0", 'to="' .. send1 + 0.15 .. '"') %>
	<Let name="typed1" value="<%= FIELD.x %> + <%= FIELD.text %> * progress(t, 7.0, 7.55)" />
	<Rect x="typed1" y="<%= FIELD.y %>" width="max(0, <%= FIELD.right %> - typed1)" height="<%= FIELD.h %>" color="<%= FIELD.color %>" to="<%= send1 %>" />
	<%- img("studio-v1", 'from="' .. send1 .. '" alpha="progress(t, ' .. send1 .. ', ' .. send1 + 0.12 .. ')" to="' .. send2 + 0.15 .. '"') %>
	<Let name="typed2" value="<%= FIELD.x %> + <%= FIELD.text + 4 %> * progress(t, 9.5, 10.05)" />
	<Rect x="typed2" y="<%= FIELD.y %>" width="max(0, <%= FIELD.right %> - typed2)" height="<%= FIELD.h %>" color="<%= FIELD.color %>" from="<%= send1 %>" to="<%= send2 %>" />
	<%- img("studio-v2", 'from="' .. send2 .. '" alpha="progress(t, ' .. send2 .. ', ' .. send2 + 0.12 .. ')"') %>
	<!-- The next prompt is spoken on the phone, not typed here. -->
	<Rect x="<%= FIELD.x %>" y="<%= FIELD.y %>" width="<%= FIELD.right - FIELD.x %>" height="<%= FIELD.h %>" color="<%= FIELD.color %>" from="<%= send2 %>" />
	<!-- A glint across what changed: the agent's diff, then the preview. -->
	<Group from="<%= send1 %>" to="<%= send1 + 1 %>"><Sweep at="<%= send1 + 0.1 %>" duration="0.6" opacity="0.22" /></Group>
	<Rect x="<%= P.x %>" y="<%= P.y %>" width="<%= P.w %>" height="<%= P.h %>" radius="56" color="#F2F2F7" from="<%= S.lift %>" />
</Group>
