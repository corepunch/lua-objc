<% --[[
  The world: one SceneKit scene the camera travels through, except the time
  inside the game. Every device is a prefab (devices/*.etlua) placed by
  Choreography.lua; its screen is a <Surface> whose components move
  (Motion.lua, through shots.lua). The Mac appears only in the closing
  composition.
]]
  local S = C.SHOT
  local cap = capturesDir
%>
<SceneView id="world" environment="environment" environmentIntensity="1.6" alpha="1 - step(t - <%= S.cut %>) * step(<%= S.hero %> - t)">
	<Camera id="eye" position="C.eye(t)" lookAt="C.target(t)" fieldOfView="C.lens(t)" roll="C.roll(t)" zNear="0.05" zFar="220"
		focusDistance="(C.focus(t))" fStop="C.fStop(t)" />
	<Light type="directional" rotation="-38 -28 0" intensity="650" />
	<Light type="spot" position="{C.eye(t)[1] - 6, 5, C.eye(t)[3] - 9}" lookAt="C.target(t)" intensity="2600" spotOuter="70" color="#DCE6FF" />
	<Light type="spot" position="{C.eye(t)[1] + 7, 2.5, C.eye(t)[3] - 8}" lookAt="C.target(t)" intensity="2100" spotOuter="70" color="#FFE7D2" />
	<Light type="ambient" intensity="60" />

	<!-- The iPhone: the app assembles on it, it shows each edit live beside
	     the iPad and is tapped, is talked to, and turns on its side. -->
	<%- partial("devices/Phone.etlua", {id = "phone", position = "C.at('phone', t)", rotation = "C.turn('phone', t)",
		extra = 'to="' .. S.swap .. '"', density = 3,
		screen = '<Draw with="phone" timeline="pair" />'
			.. string.format('<Rect width="402" height="874" color="#000000" alpha="progress(t, %f, %f)" />', S.swap - 0.3, S.swap)}) %>

	<!-- The iPad: Lua Studio, where the agent edits the app. -->
	<%- partial("devices/Pad.etlua", {id = "pad", position = "C.at('pad', t)", rotation = "C.turn('pad', t)",
		extra = 'opacity="1 - progress(t, ' .. S.alone .. ', ' .. S.alone + 0.8 .. ')" from="' .. S.pair .. '" to="' .. S.alone + 0.85 .. '"',
		screen = '<Draw with="studio" session="pair" />'}) %>

	<!-- The same phone on its side, now running Coin Quest: the game's own
	     Stage.etlua, posed by the game's own replay. -->
	<%
	  local stage = partial(root .. "apps/coin-quest/views/Stage.etlua", quest:view())
	  stage = stage:gsub("<SceneView ", '<SceneView states="questStates(t)" ', 1)
	%>
	<%- partial("devices/Phone.etlua", {id = "game", position = "C.at('game', t)", rotation = "C.turn('game', t)", landscape = true,
		extra = 'from="' .. S.swap .. '" to="' .. S.cut + 0.1 .. '"',
		screen = stage .. string.format('<Rect width="874" height="402" color="#000000" alpha="1 - progress(t, %f, %f)" />', S.swap, S.swap + 0.35)}) %>

	<!-- The closing composition, the only time the Mac is seen. -->
	<%- partial("devices/Display.etlua", {id = "heroDisplay", position = "C.at('heroDisplay', t)", rotation = "C.turn('heroDisplay', t)",
		extra = 'from="' .. S.hero .. '"', screen = partial("screens/Desktop.etlua", {window = "ledger-v1"})}) %>
	<%- partial("devices/Pad.etlua", {id = "heroPad", position = "C.at('heroPad', t)", rotation = "C.turn('heroPad', t)",
		extra = 'from="' .. S.hero .. '"', screen = '<Draw with="studio" session="hero" />'}) %>
	<%- partial("devices/Phone.etlua", {id = "heroPhone", position = "C.at('heroPhone', t)", rotation = "C.turn('heroPhone', t)",
		extra = 'from="' .. S.hero .. '"', density = 3, screen = '<Draw with="phone" timeline="hero" />'}) %>
</SceneView>
