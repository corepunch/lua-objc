<% --[[ Everything written on the film, drawn crisp over the 3-D render, on
  the beat. Words sit in clear space; labels follow their device through
  project(). ]]
  local S = C.SHOT
%>
<!-- Open: the app assembles on the phone. -->
<Group to="<%= S.pair + 0.4 %>" motion="leave{at = <%= S.pair %>, duration = 0.35, x = -140, fade = true, curve = 'inCubic'}">
	<Text style="big" text="Build native apps" x="110" y="505" align="leading" at="0.5" />
	<Slam style="bigBrand" text="on iPad and iPhone." x="110" y="625" align="leading" at="1.5, 1.75, 2.0, 2.25" />
</Group>

<!-- The pair: which device is which. -->
<Let name="padSpot" value="project('world', C.label('pad', t))" />
<Let name="phoneSpot" value="project('world', C.label('phone', t))" />
<Group from="3.7" to="4.7" motion="fadeOut(4.45, 0.25)">
	<Text style="label" text="Lua Studio · code with your agent on iPad" x="padSpot[1]" y="padSpot[2]" align="leading" at="3.75" />
	<Text style="label" text="Live preview · iPhone" x="phoneSpot[1]" y="phoneSpot[2]" align="leading" at="4.0" />
</Group>

<!-- The loop, one caption per beat that matters. -->
<% for _, word in ipairs({ { S.send1, S.change1 - 0.2, "Ask." }, { S.change1, S.send2 - 0.2, "See it change." },
	{ S.send2, S.change2 - 0.2, "Ask again." }, { S.change2, S.tap - 0.2, "Live, on the phone." }, { S.tap, S.noBuild - 0.3, "Tap it." } }) do %>
<Draw with="caption" text="<%= word[3] %>" at="<%= word[1] %>" exit="<%= word[2] %>" />
<% end %>

<!-- No build. -->
<Rect width="1920" height="1080" color="#000000" alpha="0.6 * progress(t, <%= S.noBuild - 0.1 %>, <%= S.noBuild + 0.15 %>) * (1 - progress(t, 12.75, 13.05))" />
<Group from="<%= S.noBuild %>" to="13.05" motion="leave{at = 12.75, duration = 0.3, scale = 1.2, fade = true, curve = 'inCubic'}" x="960" y="560">
	<Slam style="giant" style2="giant" text="No build." x="0" y="-40" at="<%= S.noBuild %>, <%= S.noBuild + 0.25 %>" />
	<Slam style="giantBrand" style2="giantBrand" text="No restart." x="0" y="110" at="12.25, 12.5" />
</Group>

<!-- Made for agents: one request lands in the Model, the Controller and
     the View, each in its place, and the phone shows it. -->
<Text style="title" text="Made for coding agents." x="130" y="190" align="leading" at="<%= S.alone + 0.5 %>" exit="<%= S.turn - 0.2 %>" />
<Draw with="request" text="Add a filter." x="130" y="292" at="<%= S.send3 %>" exit="<%= S.change3 - 0.3 %>" />
<Text style="taglineBrand" text="Strict MVC. No spaghetti." x="132" y="310" align="leading" at="<%= S.change3 %>" exit="<%= S.turn - 0.2 %>" />

<!-- Inside the game. -->
<Group from="20.4" to="23.0" motion="fadeOut(22.7, 0.3)">
	<Glow x="960" y="880" radius="760" colors="{rgb(0x000000, 0.42), rgb(0x000000, 0)}" />
	<Text style="huge" text="And native 3D." x="960" y="900" at="20.45" />
	<Text style="sub" text="Coin Quest: SceneKit, in Lua" x="960" y="970" at="20.9" />
</Group>

<!-- The end card. -->
<Group from="<%= S.logo %>">
	<Text style="logo" text="lua-objc" x="130" y="455" align="leading" at="<%= S.logo %>" />
	<Text style="tagline" text="Native apps, built with agents." x="134" y="548" align="leading" at="<%= S.logo + 0.5 %>" />
	<Text style="taglineBrand" text="Strict MVC keeps the code clean." x="134" y="614" align="leading" at="<%= S.logo + 0.62 %>" />
	<Text style="small" text="Lua models and controllers · etlua views · AppKit and UIKit" x="136" y="690" align="leading" at="<%= S.logo + 1.0 %>" />
	<Text style="small" text="Build right on the iPad with Lua Studio." x="136" y="734" align="leading" at="<%= S.logo + 1.2 %>" />
	<Text style="url" text="github.com/corepunch/lua-objc" x="136" y="810" align="leading" at="<%= S.logo + 1.6 %>" />
</Group>
