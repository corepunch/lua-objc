<!-- 16–18 s: "Made for developers." slams in inside an orbit of tool
     chips, zooms through the camera, and the Developer page swings in. -->
<%
local function chips(front)
	local out = {}
	for i, chip in ipairs(orbit) do
		local angle = "orbit" .. i
		table.insert(out, string.format([[
    <Chip symbol="%s" color="%s" x="960 + cos(%s) * 700" y="560 + sin(%s) * 300"
          size="104 * (0.78 + 0.3 * (sin(%s) + 1) / 2)" alpha="(0.55 + 0.45 * (sin(%s) + 1) / 2) * step(%ssin(%s))"
          motion="pop(%g, {response = 1 / 2.2, damping = 0.45, turn = 0.3, fade = 0.0001, sound = %s})" />]],
			chip[1], chip[2], angle, angle, angle, angle, front and "" or "-", angle, 16 + (i - 1) * 0.125, front and "'pop'" or "false"))
	end
	return table.concat(out, "\n")
end
%>
<Scene from="15.98" to="17.1">
  <% for i = 1, #orbit do %>
  <Let name="orbit<%= i %>" value="<%= (i - 1) / 6 * 2 * math.pi %> + (t - 16) * 0.9" />
  <% end %>
  <Let name="through" value="inQuart(progress(t, 16.85, 17.05))" />
  <!-- The title and its chips zoom through the camera at full strength;
       the cut at 17.1 s ends them. -->
  <Group x="960" y="540" anchor="960, 540" scale="1 + through * 2.2">
<%- chips(false) %>
    <Slam style="title" style3="titleBrand" text="Made for developers." x="960" y="590" at="16, 16.25, 16.5" />
<%- chips(true) %>
  </Group>
  <Cue sound="whoosh" at="16.8" until="17.05" />
</Scene>

<Scene from="17" to="18.05">
  <Text style="head" text="Xcode, packages, containers." x="960" y="150" at="17.05" exit="17.82" />
  <Let name="swing" value="spring(t - 17, 1 / 1.6, 0.72)" />
  <Let name="push" value="inOutCubic(progress(t, 17.35, 17.95))" />
  <Let name="devOut" value="inQuart(progress(t, 17.88, 18.02))" />
  <Window capture="developer-dark" radius="24" shadow="1"
          x="mix(2460, 960, swing)" y="mix(640, 560, push)" anchorX="mix(720, 760, push)" anchorY="mix(450, 330, push)"
          scale="mixScale(0.74, 1.35, push) * (1 + devOut * 0.6)" alpha="1 - devOut" rotation="0.14 * (1 - swing)">
    <Sweep at="17.3" duration="0.55" />
  </Window>
  <Cue sound="whoosh" at="17.8" until="18.02" />
</Scene>
