<!-- 16–21 s: Clean Up. Rebuildable rows rise under the title and get
     checked, fly together into one figure, and the payoff counter lands
     and holds. -->
<%
local cleanup = captures:get("cleanup-dark")
local width = cleanup:row("list_rebuildable", 1).w
-- Slot 1 is iPhone software updates, carried in from Largest.
local rows = { 2, 1, 3, 4, 5, 6, 7 }
local menu = { x = 959, y = 23 } -- where the check lands: the action menu of a row
%>
<Scene from="16" to="21.2">
  <Text style="head" text="Clean up with confidence." x="960" y="176" at="16.1" exit="18.6" />
  <Text style="sub" text="Diskmap knows what’s safe to clear — and what’s yours." x="960" y="236" at="16.3" stagger="0.03" exit="18.55" />
  <% for i, row in ipairs(rows) do
       local check = 17.8 + (i - 1) * 0.125
       local fly = "fly" .. i %>
  <Let name="<%= fly %>" value="inCubic(progress(t, <%= 18.7 + (i - 1) * 0.04 %>, <%= 19.05 + (i - 1) * 0.04 %>))" />
  <Group x="960" y="mix(<%= 492 + (i - 1) * 62 %>, 540, <%= fly %>)" scale="mix(1.18, 0.1, <%= fly %>)"
         alpha="1 - <%= fly %> ^ 2" anchor="<%= width / 2 %>, 23"
         <% if i == 1 then %>from="16.05"<% else %>motion="enter{at = <%= 16.8 + (i - 2) * 0.125 %>, y = 160, response = 1 / 1.9, damping = 0.6, fade = 0.08, sound = 'pop'}"<% end %>>
    <Piece capture="cleanup-dark" rect="#list_rebuildable/row/<%= row %>" x="<%= width / 2 %>" y="23" radius="9" shadow="0.55" />
    <Group from="<%= check %>">
      <Circle x="<%= menu.x %>" y="<%= menu.y %>" radius="13" color="#2C2C2E" />
      <Symbol name="checkmark.circle.fill" x="<%= menu.x %>" y="<%= menu.y %>" size="22" color="#34C759"
              motion="pop(<%= check %>, {response = 1 / 2.6, damping = 0.4, fade = 0.0001})" />
      <Rect width="<%= width %>" height="46" color="#34C759" alpha="0.18 * pulse(t, {<%= check %>}, 0.15)" />
    </Group>
  </Group>
  <% end %>
  <Cue sound="whoosh" at="18.7" until="19.15" />

  <!-- The payoff: digits tick in fixed slots; the unit holds still. -->
  <Cue sound="slam" at="19.3" />
  <Cue sound="counter" at="19.3" />
  <Group from="19.25" x="960" y="520" scale="mix(1.8, 1, spring(t - 19.3, 1 / 2.2, 0.45))"
         alpha="clamp01((t - 19.25) / 0.08) * (1 - progress(t, 21.05, 21.12))">
    <Counter y="80" style="counter" unitStyle="counterUnit" format="%.1f" final="19.8" unit=" GB"
             value="floor(19.8 * outQuart(progress(t, 19.25, 19.65)) * 10 + 0.5) / 10" />
  </Group>
  <Text style="caption" text="safe to clear, any time." x="960" y="690" at="19.36" stagger="0.04" exit="21.05" />
  <Burst at="19.3" x="960" y="500" colors="#34C759 #30D5C8 #FFFFFF #64D2FF" count="110" speed="1700" seed="7" />
</Scene>
