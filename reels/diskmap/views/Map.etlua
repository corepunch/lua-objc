<!-- 6–10.5 s: the sunburst builds ring by ring. Each ring blooms out from
     the centre on a spring, sweeps on clockwise from twelve o'clock and
     unwinds into place, turning the other way from its neighbour like the
     rings of a combination lock; a glint marks it landing. The total counts
     up in the hole. Categories fly out as callouts, then the window grows
     around the chart and the callouts home to their rows. -->
<%
local map = captures:get("map-dark")
local bx, by, bw, bh = map:rect("#sunburst")
local sunX, sunY = bx + bw / 2, by + bh / 2
local ww, wh = map:size()
local window = { x = 960, y = 612, scale = 0.78 }
local chart = { x = 1280, y = 548, scale = 1.55 }
-- The rings, in window points from the centre of the chart (measured on the
-- capture); the sweep clip works in piece points, which add the 12pt outset.
local outset = 12
local cx, cy = bw / 2 + outset, bh / 2 + outset
local rings = { { 0, 80, 153.5 }, { 0.18, 153.5, 220 }, { 0.36, 220, 300 } }
local build = 6
local lx, ly, lw, lh = map:rect("#mapCenterDetail")
local _, ty, _, th = map:rect("#mapCenterTitle")
-- Where each callout leaves the chart: the middle of the inner
-- segment. Photos, Developer, Games and Documents: rows 1, 2, 3 and 5.
local callouts = { { row = 1, from = { -120, -10 } }, { row = 2, from = { 89, -80 } },
	{ row = 3, from = { -83, 86 } }, { row = 5, from = { 120, 8 } } }
%>
<Scene from="5.98" to="10.7">
  <Let name="sunS" value="<%= chart.scale %> * (1 + 0.014 * pulse(t, kicks, 0.14))" />
  <Let name="q" value="inOutQuint(progress(t, 9.95, 10.5))" />
  <Let name="ws" value="mixScale(sunS, <%= window.scale %>, q)" />
  <Let name="ax" value="mix(<%= chart.x %>, <%= window.x + (sunX - ww / 2) * window.scale %>, q)" />
  <Let name="ay" value="mix(<%= chart.y %>, <%= window.y + (sunY - wh / 2) * window.scale %>, q)" />
  <Let name="glowA" value="(0.45 + 0.2 * pulse(t, kicks, 0.2)) * clamp01((t - 6) / 0.3) * (1 - q)" />
  <Glow x="<%= chart.x %>" y="<%= chart.y %>" radius="680" locations="0, 0.45, 1"
        colors="{rgb(0x8E44E8, glowA), rgb(0x2F6BFF, glowA * 0.4), rgb(0, 0)}" />

  <Let name="reveal" value="outQuart(progress(t, 10.0, 10.48))" />
  <Window capture="map-dark" from="9.95" to="10.48" x="ax" y="ay" anchor="<%= sunX %>, <%= sunY %>" scale="ws"
          radius="24" shadow="reveal" clip="circle(<%= sunX %>, <%= sunY %>, mix(290, 1300, reveal))" />

  <Group x="ax" y="ay" scale="t &lt; 9.95 and sunS or ws" alpha="1 - progress(t, 10.35, 10.48)">
    <% for k, ring in ipairs(rings) do
         local s = build + ring[1]
         local turn = (k % 2 == 1 and -1 or 1) * 0.9 %>
    <Let name="glint<%= k %>" value="outCubic(progress(t, <%= s + 0.55 %>, <%= s + 1.05 %>))" />
    <Group scale="mix(0.55, 1, spring(t - <%= s %>, 1 / 1.6, 0.55))"
           rotation="<%= turn %> * (1 - outQuint(progress(t, <%= s %>, <%= s + 1.2 %>)))">
      <Piece capture="map-dark" rect="#sunburst" outset="<%= outset %>" key="620, 200" x="0" y="0"
             clip="sector(<%= cx %>, <%= cy %>, <%= ring[2] %>, <%= ring[3] %>, -0.5 * pi, outQuart(progress(t, <%= s %>, <%= s + 0.8 %>)) * 2 * pi)" />
    </Group>
    <Circle from="<%= s + 0.55 %>" to="<%= s + 1.05 %>" radius="<%= ring[3] - 6 %> + glint<%= k %> * 26" stroke="2"
            color="rgb(0xFFFFFF, 0.5 * (1 - glint<%= k %>))" />
    <Cue sound="pop" at="<%= s + 0.55 %>" />
    <% end %>
    <!-- The total counts up in the hole while the rings build. -->
    <Group from="6.3" scale="mix(0.4, 1, spring(t - 6.3, 1 / 2, 0.5))" alpha="clamp01((t - 6.3) / 0.1)">
      <Counter y="<%= ty + th * 0.72 - sunY %>" style="ringValue" format="%.1f" final="355.8" unit=" GB"
               value="floor(355.8 * outQuart(progress(t, 6.3, 7.4)) * 10 + 0.5) / 10" />
      <Piece capture="map-dark" rect="#mapCenterDetail" key="620, 200" x="<%= lx + lw / 2 - sunX %>" y="<%= ly + lh / 2 - sunY %>" />
    </Group>
  </Group>

  <Text style="big" text="Every byte," x="140" y="432" align="leading" at="6.5" exit="9.5" />
  <Text style="bigBrand" text="mapped." x="140" y="552" align="leading" at="6.9" exit="9.54" />
  <Text style="lede" text="Every category. Every folder. At a glance." x="142" y="626" align="leading" at="7.2" stagger="0.035" exit="9.45" />

  <!-- Callouts: real list rows fly out of their own segment, rest, then
       home to their place in the growing window. -->
  <% for i, callout in ipairs(callouts) do
       local from = callout.from
       local row = map:row("mapList", callout.row)
       local pop = 7.5 + (i - 1) * 0.5
       local restX, restY = 140 + row.w * 1.55 / 2, 704 + (i - 1) * 78
       local homeX, homeY = row.x + row.w / 2 - sunX, row.y + row.h / 2 - sunY %>
  <Cue sound="pop" at="<%= pop %>" />
  <Let name="call<%= i %>" value="spring(t - <%= pop %>, 1 / 1.8, 0.62)" />
  <Let name="home<%= i %>" value="inOutCubic(progress(t, <%= 9.95 + (i - 1) * 0.03 %>, <%= 10.45 + (i - 1) * 0.03 %>))" />
  <Piece capture="map-dark" rect="#mapList/row/<%= callout.row %>" from="<%= pop %>"
         x="home<%= i %> == 0 and mix(<%= chart.x %> + <%= from[1] %> * sunS, <%= restX %>, call<%= i %>) or mix(<%= restX %>, ax + <%= homeX %> * ws, home<%= i %>)"
         y="home<%= i %> == 0 and mix(<%= chart.y %> + <%= from[2] %> * sunS, <%= restY %>, call<%= i %>) or mix(<%= restY %>, ay + <%= homeY %> * ws, home<%= i %>)"
         scale="home<%= i %> == 0 and mix(0.25, 1.55, call<%= i %>) or mixScale(1.55, ws, home<%= i %>)"
         alpha="clamp01((t - <%= pop %>) / 0.08) * (1 - progress(t, 10.45, 10.55))"
         radius="8 * (1 - home<%= i %>)" shadow="0.7 * (1 - home<%= i %>)" />
  <% end %>
  <Cue sound="whoosh" at="9.95" until="10.45" />
</Scene>
