<?xml version="1.0" encoding="UTF-8"?>
<!--
  UIKit.xml — declarative source for the UIKit Lua bridge.

  Run tools/gen_bridge.py to regenerate:
    src/uikit/generated/bridge_funcs.m    — bridge_xxx() C functions
    src/uikit/generated/bridge_props.m    — nsview_index / nsview_newindex bodies
    src/uikit/generated/bridge_lib.inc    — luaL_Reg entries for bridge_lib[]
    src/uikit/generated/bridge_class_methods.m — typed class wrappers

  key_style="direct"  — keys are bare static char vars (&kFooKey),
                         not an enum array (&kKeys[kFooKey]) as in AppKit.
  callback_style="addTarget" — UIKit uses addTarget:action:forControlEvents:
                                instead of NSControl's .target/.action properties.
-->
<bridge module="UIKit" key_style="direct" callback_style="addTarget">

  <!-- ================================================================
       LAYOUT PROPERTIES — written to bridge_props.m
       UIKit only exposes the subset of properties its simpler layout
       engine actually reads (padding, alignment, fixedWidth/Height).
       ================================================================ -->
  <class name="UIView" lua_name="LayoutView" detect_class="UIView">
    <properties>
      <property name="padding"     key="kPaddingKey"     type="number"  default="12.0"/>
      <property name="alignment"   key="kAlignmentKey"   type="string"  default="center"/>
      <property name="fixedWidth"  key="kFixedWidthKey"  type="number"  default="0"/>
      <property name="fixedHeight" key="kFixedHeightKey" type="number"  default="0"/>
    </properties>
  </class>

  <!-- ================================================================
       STACK CONTAINER CONSTRUCTORS
       UIKit uses NSString values for the axis key, not an enum int.
       ================================================================ -->
  <class name="UIKitControls" static="true">
    <method name="vstack" lua_name="_vstack" returns="uiview" impl="constructor">
      <alloc class="UIView" frame="CGRectZero"/>
      <assoc key="kAxisKey"     value='@"vstack"'/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="hstack" lua_name="_hstack" returns="uiview" impl="constructor">
      <alloc class="UIView" frame="CGRectZero"/>
      <assoc key="kAxisKey"     value='@"hstack"'/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="hsplit" lua_name="_hsplit" returns="uiview" impl="constructor">
      <alloc class="UIView" frame="CGRectZero"/>
      <assoc key="kAxisKey"     value='@"hsplit"'/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="spacer" lua_name="_spacer" returns="uiview" impl="constructor">
      <alloc class="UIView" frame="CGRectMake(0, 0, 10, 10)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <!-- ================================================================
         BUTTON / TOGGLE
         UIKit button uses a factory method; toggle is UISwitch.
         ================================================================ -->

    <!--
      bridge_button(title: string, callback?: function) -> uiview
      UIButtonTypeSystem factory; addTarget for UIControlEventTouchUpInside.
    -->
    <method name="button" lua_name="_button" returns="uiview" impl="constructor">
      <arg name="title"    type="string"/>
      <arg name="callback" type="function?"/>
      <alloc_factory class="UIButton"
        method="buttonWithType:"
        args="UIButtonTypeSystem"/>
      <call_method method="setTitle:[NSString stringWithUTF8String:title] forState:UIControlStateNormal"/>
      <call_method method="sizeToFit"/>
      <callback arg="callback" key="kCallbackKey"
                target="[LuaButtonTarget shared]" action="onAction:"
                event="UIControlEventTouchUpInside"/>
    </method>

    <!--
      bridge_toggle(label: string, is_on: bool, callback?: function) -> uiview
      UISwitch; addTarget for UIControlEventValueChanged.
    -->
    <method name="toggle" lua_name="_toggle" returns="uiview" impl="constructor">
      <arg name="label"    type="string"/>
      <arg name="is_on"    type="bool"  />
      <arg name="callback" type="function?"/>
      <alloc class="UISwitch" frame="CGRectZero"/>
      <set_prop property="on"                 value="is_on"/>
      <set_prop property="accessibilityLabel" from_arg="label"/>
      <call_method method="sizeToFit"/>
      <callback arg="callback" key="kCallbackKey"
                target="[LuaButtonTarget shared]" action="onAction:"
                event="UIControlEventValueChanged"/>
    </method>
  </class>

  <!-- ================================================================
       MODULE CLASS — native functions exposed as static UIKit methods.
       bridge_lib.inc remains the sole source of truth for registration.
       ================================================================ -->
  <class name="UIKit" static="true">
    <!-- Native module functions use generated UIKit + method wrapper names. -->

    <!-- views.m -->
    <method name="window" lua_name="_window" impl="stack"/>
    <method name="image" lua_name="_image" impl="stack"/>
    <method name="add" lua_name="_add" impl="stack"/>
    <method name="layout" lua_name="_layout" impl="stack"/>
    <method name="set_content_size" lua_name="_setContentSize" impl="stack"/>

    <!-- tables.m -->
    <method name="tableview" lua_name="_tableview" impl="stack"/>

    <!-- platform.m -->
    <method name="show" lua_name="_show" impl="stack"/>
    <method name="create" lua_name="_create" impl="stack"/>
    <method name="font" lua_name="_font" impl="stack"/>
    <method name="perform" lua_name="_perform" impl="stack"/>
    <method name="callback" lua_name="_callback" impl="stack"/>

    <!-- shared async -->
    <method name="timer_after" lua_name="_timerAfter" impl="stack"/>
    <method name="http_get" lua_name="_httpGet" impl="stack"/>
    <method name="json_parse" lua_name="_jsonParse" impl="stack"/>
  </class>

</bridge>
