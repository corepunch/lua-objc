<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppKit.xml — declarative source for the AppKit Lua bridge.

  Run tools/gen_bridge.py to regenerate:
    src/appkit/generated/bridge_funcs.m    — bridge_xxx() C functions
    src/appkit/generated/bridge_props.m    — nsview_index / nsview_newindex bodies
    src/appkit/generated/bridge_lib.inc    — luaL_Reg entries for bridge_lib[]
    src/appkit/generated/bridge_class_methods.m — typed class dispatch

  Types for <arg>:
    string   → luaL_checkstring / luaL_optstring
    number   → luaL_checknumber / luaL_optnumber
    integer  → luaL_checkinteger / luaL_optinteger
    bool     → lua_toboolean  (always optional, defaults to NO)
    function → luaL_checktype(LUA_TFUNCTION) + luaL_ref
    function? → optional function (no error if nil)
    object   → check_objc
    view     → check_view
    table    → luaL_checktype(LUA_TTABLE)

  Native value types are declared as <struct> nodes below. Struct properties
  use native= for an Objective-C property or getter= for a computed value.

  Property types for <property>:
    number   → NSNumber double, INDEX_NUMBER / NEWINDEX_NUMBER
    number?  → INDEX_NUMBER_OR_NIL / NEWINDEX_NILABLE_NUMBER
    bool     → NSNumber bool,   INDEX_BOOL  / NEWINDEX_BOOL
    string   → NSString,        INDEX_STRING / NEWINDEX_STRING
-->
<bridge module="AppKit">

  <struct name="NSSize">
    <field name="width" type="number"/>
    <field name="height" type="number"/>
  </struct>

  <struct name="NSPoint">
    <field name="x" type="number"/>
    <field name="y" type="number"/>
  </struct>

  <struct name="NSRect">
    <field name="origin" type="NSPoint"/>
    <field name="size" type="NSSize"/>
  </struct>

  <!-- ================================================================
       LAYOUT PROPERTIES — written to bridge_props.m
       These expand into the INDEX_xxx / NEWINDEX_xxx macro calls
       inside nsview_index and nsview_newindex.
       ================================================================ -->
  <class name="NSView" lua_name="LayoutView" detect_class="NSView">
    <properties>
      <property name="padding"           key="kPaddingKey"           type="number"  default="0"/>
      <property name="paddingHorizontal" key="kPaddingHorizontalKey" type="number"  default="0"/>
      <property name="paddingVertical"   key="kPaddingVerticalKey"   type="number"  default="0"/>
      <property name="spacing"           key="kSpacingKey"           type="number"  default="kStackSpacing"  clamp="MAX(0, val)"/>
      <property name="alignment"         key="kAlignmentKey"         type="string"  default="center"/>
      <property name="fixedWidth"        key="kFixedWidthKey"        type="number"  default="0"/>
      <property name="fixedHeight"       key="kFixedHeightKey"       type="number"  default="0"/>
      <property name="minWidth"          key="kMinWidthKey"          type="number"  default="0"/>
      <property name="minHeight"         key="kMinHeightKey"         type="number"  default="0"/>
      <property name="maxWidth"          key="kMaxWidthKey"          type="number?"/>
      <property name="maxHeight"         key="kMaxHeightKey"         type="number?"/>
      <property name="flexGrow"          key="kFlexGrowKey"          type="number"  default="0"  clamp="MAX(0, val)"/>
      <property name="flexShrink"        key="kFlexShrinkKey"        type="number"  default="1"  clamp="MAX(0, val)"/>
      <property name="flexBasis"         key="kFlexBasisKey"         type="number?" clamp="MAX(0, val)"/>
      <property name="fillWidth"         key="kFillWidthKey"         type="bool"/>
      <property name="fillHeight"        key="kFillHeightKey"        type="bool"/>
    </properties>
  </class>

  <!-- ================================================================
       STACK / SPLIT CONTAINER CONSTRUCTORS
       Each allocates a view, stamps associated-object tags, returns nsview.
       ================================================================ -->
  <class name="AppKitControls" static="true">
    <method name="vstack" lua_name="_vstack" returns="nsview" impl="constructor">
      <alloc class="NSView" frame="NSZeroRect"/>
      <assoc key="kAxisKey"     value="@(LayoutAxisVStack)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="hstack" lua_name="_hstack" returns="nsview" impl="constructor">
      <alloc class="NSView" frame="NSZeroRect"/>
      <assoc key="kAxisKey"     value="@(LayoutAxisHStack)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="hsplit" lua_name="_hsplit" returns="nsview" impl="constructor">
      <alloc class="NSSplitView" frame="NSZeroRect"/>
      <set_prop property="vertical"      value="YES"/>
      <set_prop property="dividerStyle"  value="NSSplitViewDividerStyleThin"/>
      <assoc key="kAxisKey"     value="@(LayoutAxisHSplit)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="vsplit" lua_name="_vsplit" returns="nsview" impl="constructor">
      <alloc class="NSSplitView" frame="NSZeroRect"/>
      <set_prop property="vertical"      value="NO"/>
      <set_prop property="dividerStyle"  value="NSSplitViewDividerStyleThin"/>
      <assoc key="kAxisKey"     value="@(LayoutAxisVSplit)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
    </method>

    <method name="separator" lua_name="_separator" returns="nsview" impl="constructor">
      <!-- NSBox separator line. Fixed height = kSeparatorSize, fills width. -->
      <alloc class="NSBox" frame="NSMakeRect(0, 0, kSeparatorSize, kSeparatorSize)"/>
      <set_prop property="boxType" value="NSBoxSeparator"/>
      <assoc key="kFixedHeightKey" value="@(kSeparatorSize)"/>
      <assoc key="kFillWidthKey"   value="@YES"/>
    </method>

    <method name="spacer" lua_name="_spacer" returns="nsview" impl="constructor">
      <alloc class="NSView" frame="NSMakeRect(0, 0, kSpacerSize, kSpacerSize)"/>
      <assoc key="kFlexibleKey" value="@YES"/>
      <assoc key="kFlexBasisKey" value="@0"/>
    </method>

    <!-- ================================================================
         BUTTON / TOGGLE
         ================================================================ -->

    <!--
      bridge_button(title: string, callback?: function) -> nsview
      Creates an NSButton with rounded bezel and optional Lua action callback.
    -->
    <method name="button" lua_name="_button" returns="nsview" impl="constructor">
      <arg name="title"    type="string"/>
      <arg name="callback" type="function?"/>
      <alloc class="NSButton" frame="NSZeroRect"/>
      <set_prop property="title"      from_arg="title"/>
      <set_prop property="bezelStyle" value="NSBezelStyleRounded"/>
      <call_method method="sizeToFit"/>
      <callback arg="callback" key="kCallbackKey"
                target="[LuaButtonTarget shared]" action="onAction:"/>
    </method>

    <!--
      bridge_toggle(label: string, is_on: bool, callback?: function) -> nsview
      Creates an NSButton checkbox with optional Lua action callback.
    -->
    <method name="toggle" lua_name="_toggle" returns="nsview" impl="constructor">
      <arg name="label"    type="string"/>
      <arg name="is_on"    type="bool"  />
      <arg name="callback" type="function?"/>
      <alloc_factory class="NSButton"
        method="checkboxWithTitle:target:action:"
        args="[NSString stringWithUTF8String:label], nil, nil"/>
      <set_prop property="state"
                value="is_on ? NSControlStateValueOn : NSControlStateValueOff"/>
      <call_method method="sizeToFit"/>
      <callback arg="callback" key="kCallbackKey"
                target="[LuaButtonTarget shared]" action="onAction:"/>
    </method>
  </class>

  <!-- ================================================================
       CALLBACK-ONLY SETTERS
       Each function:  (obj, fn?) → void
         1. Validates the guard associated-object exists on obj
         2. If fn is nil/none — clears the stored ref
         3. Otherwise stores a new luaL_ref in the given key
       The optional <side_effect> block is emitted after storing the ref.
       ================================================================ -->
  <class name="NSScrollView" lua_name="Table" detect="kTableSourceKey">
    <method name="setRefresh" impl="callback">
      <guard type="LuaTableViewSource" key="kTableSourceKey" msg="not a table view"/>
      <store key="kTableRefreshKey" on="obj"/>
    </method>

    <method name="onRowSelect" impl="callback">
      <guard type="LuaTableViewSource" key="kTableSourceKey" msg="not a table view"/>
      <!-- Selection ref lives on the scroll view, not on obj directly -->
      <store key="kTableSelectionKey" on="table_scrollview(obj)"/>
    </method>

    <method name="onRowActivate" impl="callback">
      <guard type="id" key="kTableSourceKey" msg="not a table or outline view"/>
      <store key="kTableActivationKey" on="table_scrollview(obj)"/>
      <!-- When setting: wire the double-click action; when clearing: unwire -->
      <side_effect_set>
  NSScrollView *_sv = table_scrollview(obj);
  NSTableView *_table = (NSTableView *)_sv.documentView;
  _table.target = src;
  _table.doubleAction = @selector(activateSelectedRow:);
  </side_effect_set>
      <side_effect_clear>
  NSScrollView *_sv = table_scrollview(obj);
  NSTableView *_table = (NSTableView *)_sv.documentView;
  _table.target = nil;
  _table.doubleAction = nil;
  </side_effect_clear>
    </method>
  </class>

  <class name="AppKit" static="true">
    <!-- Native module functions use the class + method wrapper name generated
         here. Their implementation name follows bridge_<method>, so neither a
         C symbol nor a source-file path belongs in this schema. -->

    <!-- text_view_on_change has non-trivial NSNotificationCenter wiring — kept in editor.m -->

    <!-- ================================================================
         SIMPLE FORWARDING FUNCTIONS (obj + args → void or value)
         These are thin wrappers that look up a typed associated object
         and call a single ObjC method.  Keeping them in the XML
         documents the full dispatch table even where the body is trivial.
         ================================================================ -->

    <!--
      bridge_table_show_loading(obj) — starts spinner overlay on table scroll view.
      bridge_table_hide_loading(obj) — stops and removes spinner overlay.
      These have non-trivial bodies (spinner alloc/layout) — kept in controls.m.
      Listed here only so the bridge_lib[] entry is generated.
    -->
    <method name="table_column_widths" lua_name="_tableColumnWidths" impl="stack"/>
    <method name="table_cell_frames" lua_name="_tableCellFrames" impl="stack"/>
    <method name="toolbar_item" lua_name="_toolbar_item" impl="stack"/>
    <method name="canvas_toolbar_items" lua_name="_canvas_toolbar_items" impl="stack"/>

    <!-- Views -->
    <method name="window" lua_name="_window" impl="stack"/>
    <method name="set_window_workspace" lua_name="_setWindowWorkspace" impl="stack"/>
    <method name="image" lua_name="_image" impl="stack"/>
    <method name="image_viewer" lua_name="_imageViewer" impl="stack"/>
    <method name="system_image" lua_name="_systemImage" impl="stack"/>
    <method name="system_color" lua_name="_systemColor" impl="stack"/>
    <method name="tableview" lua_name="_tableview" impl="stack"/>
    <method name="action_button" lua_name="_actionButton" impl="stack"/>

    <!-- Layout -->

    <!-- Presentation -->
    <method name="panel" lua_name="_panel" impl="stack"/>
    <method name="panel_style_state" lua_name="_panelStyleState" impl="stack"/>
    <method name="menu_item" lua_name="_menuItem" impl="stack"/>

    <!-- Text field -->
    <method name="text_field_callbacks" lua_name="_textFieldCallbacks" impl="stack"/>
    <method name="text_field_test_input" lua_name="_textFieldTestInput" impl="stack"/>
    <method name="text_field_test_command" lua_name="_textFieldTestCommand" impl="stack"/>

    <!-- Editor -->
    <method name="text_view" lua_name="_textView" impl="stack"/>
    <method name="symbol_toggle" lua_name="_symbolToggle" impl="stack"/>
    <method name="symbol_button" lua_name="_symbolButton" impl="stack"/>
    <method name="eval" lua_name="_eval" impl="stack"/>

    <!-- Tab view -->
    <method name="tabview" lua_name="_tabview" impl="stack"/>
    <method name="segmented_control" lua_name="_segmentedControl" impl="stack"/>

    <!-- Platform -->
    <method name="watch_file" lua_name="_watchFile" impl="stack"/>
    <method name="pick_folder" lua_name="_pickFolder" impl="stack"/>
    <method name="pick_file" lua_name="_pickFile" impl="stack"/>
    <method name="outlineview" lua_name="_outlineview" impl="stack"/>
    <method name="list_directory" lua_name="_listDirectory" impl="stack"/>

    <!-- Async / shared -->
    <method name="timer_after" lua_name="_timerAfter" impl="stack"/>
    <method name="http_get" lua_name="_httpGet" impl="stack"/>
    <method name="json_parse" lua_name="_jsonParse" impl="stack"/>

    <!-- Generic runtime -->
    <method name="create" lua_name="_create" impl="stack"/>
    <method name="font" lua_name="_font" impl="stack"/>
  </class>

  <!-- ================================================================
       CLASSES — typed obj:method(args) dispatch via nsview_index.
       ================================================================ -->

  <!--
    Text views: NSScrollView wrapping NSTextView, sentinel = kTextViewSourceKey.
    All five functions already exist in editor.m.
  -->
  <class name="NSScrollView" lua_name="TextView" detect="kTextViewSourceKey">
    <method name="setText" impl="class_stack">
      <arg name="text" type="string"/>
    </method>
    <method name="getText" impl="class_stack"/>
    <method name="setLanguage" impl="class_stack">
      <arg name="language" type="string"/>
    </method>
    <method name="setWrapMode" impl="class_stack">
      <arg name="wrapped" type="bool"/>
    </method>
    <method name="onChange" impl="class_stack">
      <arg name="callback" type="function?"/>
    </method>
  </class>

  <!--
    Tab views: detected by isKindOfClass:[NSTabView class].
    All methods are auto-generated wrappers that validate Lua args and delegate
    to hand-written bridge_NSTabView_xxx_impl() functions in tabview.m.
  -->
  <class name="NSTabView" lua_name="TabView" detect_class="NSTabView">
    <method name="addTab" impl="true">
      <arg name="title"   type="string"/>
      <arg name="content" type="nsview"/>
    </method>
    <method name="removeTab" impl="true">
      <arg name="index" type="integer"/>
    </method>
    <method name="selectTab" impl="true">
      <arg name="index" type="integer"/>
    </method>
    <method name="tabCount" impl="true"/>
    <method name="onChange" impl="true">
      <arg name="callback" type="function?"/>
    </method>
  </class>

  <!--
    Windows: detected by isKindOfClass:[NSWindow class].
    Functions exist in views.m / main.m.
  -->
  <class name="NSWindow" lua_name="Window" detect_class="NSWindow">
    <properties>
      <property name="size" type="NSSize" native="contentSize"
                getter="((NSWindow *)obj).contentView.frame.size"/>
    </properties>
    <method name="addTabbedWindow" impl="stack">
      <arg name="window" type="nswindow"/>
      <arg name="order" type="string?" default="above"/>
    </method>
    <method name="setTabbing">
      <arg name="mode" type="NSWindowTabbingMode"/>
      <arg name="identifier" type="string?"/>
      <objc>
self.tabbingMode = mode;
if (identifier) {
	self.tabbingIdentifier = [NSString stringWithUTF8String:identifier];
}
      </objc>
    </method>
    <method name="tabCount">
      <objc>
lua_pushinteger(L, (lua_Integer)self.tabbedWindows.count);
return 1;
      </objc>
    </method>
    <method name="toggleSidebar" impl="stack"/>
    <method name="dismiss">
      <objc>
[self orderOut:nil];
[self.parentWindow removeChildWindow:self];
      </objc>
    </method>
    <method name="setContentSize">
      <arg name="width" type="number"/>
      <arg name="height" type="number"/>
      <arg name="anchor" type="string?" default=""/>
      <objc>return bridge_object_set_content_size_impl(L);</objc>
    </method>
    <method name="setMinSize">
      <arg name="width" type="number"/>
      <arg name="height" type="number"/>
      <objc>self.contentMinSize = NSMakeSize(width, height);</objc>
    </method>
    <method name="setAppearance" impl="stack">
      <arg name="appearance" type="string"/>
    </method>
    <method name="focus" impl="stack">
      <arg name="view" type="nsview"/>
    </method>
    <method name="isFirstResponder" impl="stack">
      <arg name="view" type="nsview"/>
    </method>
    <method name="selectTab">
      <objc>
if (self.tabGroup) {
	self.tabGroup.selectedWindow = self;
}
if (self.isVisible) {
	[self makeKeyAndOrderFront:nil];
}
      </objc>
    </method>
    <method name="workspaceState" impl="stack"/>
    <method name="show" impl="stack"/>
    <method name="add">
      <arg name="view" type="nsview"/>
      <objc>return bridge_object_add_impl(L);</objc>
    </method>
    <method name="layout">
      <arg name="width" type="number?" default="400"/>
      <objc>return bridge_object_layout_impl(L);</objc>
    </method>
    <method name="perform">
      <arg name="selector" type="string"/>
      <arg name="value" type="any?"/>
      <objc>return bridge_object_perform_impl(L);</objc>
    </method>
    <method name="presentPanel" impl="stack">
      <arg name="parent" type="nswindow"/>
      <arg name="offsetY" type="number?" default="0"/>
    </method>
  </class>

  <!--
    Generic views: NSView (non-window, non-specialised).
    Detected last so more specific groups above take priority.
    layout, size, frameInWindow, add, setAppearance apply to any view.
  -->
  <class name="NSView" lua_name="View" detect_class="NSView">
    <properties>
      <property name="size" type="NSSize" native="frameSize"
                getter="((NSView *)obj).frame.size"/>
      <property name="frameInWindow" type="NSRect"
                getter="[((NSView *)obj) convertRect:((NSView *)obj).bounds toView:nil]"
                readonly="true"/>
    </properties>
    <method name="setHidden">
      <arg name="hidden" type="bool"/>
    </method>
    <method name="addSubview">
      <arg name="view" type="nsview"/>
      <arg name="positioned" type="integer"/>
      <arg name="relativeTo" type="nsview?"/>
    </method>
    <method name="layout">
      <arg name="width" type="number?" default="400"/>
      <objc>return bridge_object_layout_impl(L);</objc>
    </method>
    <method name="add">
      <arg name="view" type="nsview"/>
      <objc>return bridge_object_add_impl(L);</objc>
    </method>
    <method name="renderToPNG" impl="stack">
      <arg name="path" type="string"/>
      <arg name="width" type="number?"/>
      <arg name="height" type="number?"/>
    </method>
    <method name="clearContainer" impl="stack"/>
    <method name="splitProportions" impl="stack">
      <arg name="proportions" type="table"/>
    </method>
    <method name="setContentSize">
      <arg name="width" type="number"/>
      <arg name="height" type="number"/>
      <objc>return bridge_object_set_content_size_impl(L);</objc>
    </method>
    <method name="perform">
      <arg name="selector" type="string"/>
      <arg name="value" type="any?"/>
      <objc>return bridge_object_perform_impl(L);</objc>
    </method>
    <method name="setCallback" impl="stack">
      <arg name="callback" type="function"/>
    </method>
  </class>


</bridge>
