<%
  -- The conversation, as on the iPad: the request of the user is a bubble of
  -- the brand gradient, the agent answers beside its mark with its edits
  -- in one card. On a phone the measure is the sheet; the composer sits
  -- in the bottom safe-area inset so it rises with the keyboard, and the
  -- suggestions scroll sideways above the field instead of wrapping.
  local CHAT = {
    inset = 16, spacing = 18, bodySize = 15, bubbleInset = 12, bubbleRadius = 18, bubbleIndent = 48,
    turnAvatar = 26, turnSpacing = 10, captionSize = 12,
    chipSpacing = 8, composerSpacing = 10, composerRadius = 24, fieldInset = 6, fieldSize = 15,
  }
%>
<SafeAreaInset edge="bottom" keyboardBottomInset="0" tint="<%= tint %>" maxWidth="infinity" maxHeight="infinity">
	<ScrollView id="transcriptScroll" scrollDismissesKeyboard="interactively" flexGrow="1" maxWidth="infinity" maxHeight="infinity">
		<VStack padding="<%= CHAT.inset %>" spacing="<%= CHAT.spacing %>" maxWidth="infinity" alignment="leading">
			<% for _, message in ipairs(messages) do %>
			<% if message.role == "user" then %>
			<HStack id="message/<%= message.id %>" spacing="0" maxWidth="infinity">
				<Spacer minWidth="<%= CHAT.bubbleIndent %>" />
				<ZStack id="bubble/<%= message.id %>" flexGrow="0" flexShrink="1" fixedSize="vertical">
					<LinearGradient colors="<%= brand %>" startPoint="topLeading" endPoint="bottomTrailing" cornerRadius="<%= CHAT.bubbleRadius %>" />
					<VStack padding="<%= CHAT.bubbleInset %>">
						<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" color="white" lines="0" />
					</VStack>
				</ZStack>
			</HStack>
			<% else %>
			<HStack id="message/<%= message.id %>" spacing="<%= CHAT.turnSpacing %>" maxWidth="infinity" alignment="top">
				<%- partial("../../../../apps/studio/views/components/Avatar.etlua", { size = CHAT.turnAvatar, colors = brand, icon = agent.icon, label = agent.name }) %>
				<VStack spacing="<%= CHAT.turnSpacing %>" flexGrow="1" flexShrink="1" alignment="leading">
					<Label text="<%= message.text %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
					<% if message.changes then %>
					<%- partial("../../../../apps/studio/views/components/ChangeCard.etlua", { changes = message.changes, summary = message.summary }) %>
					<% end %>
					<% if message.conclusion then %>
					<Label text="<%= message.conclusion %>" size="<%= CHAT.bodySize %>" lines="0" maxWidth="infinity" />
					<% end %>
					<% if message.previewState == "ready" then %>
					<Label text="Preview updated" systemImage="checkmark.circle.fill" iconSize="<%= CHAT.captionSize %>" size="<%= CHAT.captionSize %>" color="secondary" />
					<% end %>
				</VStack>
			</HStack>
			<% end %>
			<% end %>
		</VStack>
	</ScrollView>
	<VStack id="composer" paddingHorizontal="<%= CHAT.inset %>" paddingBottom="<%= CHAT.inset %>" paddingTop="<%= CHAT.composerSpacing %>" spacing="<%= CHAT.composerSpacing %>" maxWidth="infinity" alignment="leading">
		<ScrollView horizontal="true" vertical="false" maxWidth="infinity">
			<HStack spacing="<%= CHAT.chipSpacing %>">
				<% for _, suggestion in ipairs(suggestions) do %>
				<Button title="<%= suggestion.title %>" systemImage="<%= suggestion.icon %>" action="<%= suggestion.action %>" controlSize="small" style="glass" />
				<% end %>
			</HStack>
		</ScrollView>
		<GlassEffect cornerRadius="<%= CHAT.composerRadius %>" maxWidth="infinity">
			<HStack padding="<%= CHAT.fieldInset %>" spacing="<%= CHAT.fieldInset %>" maxWidth="infinity" alignment="center">
				<Button systemImage="plus" accessibilityLabel="Attach" style="plain" />
				<TextField id="draft" text="<%= draft or "" %>" placeholder="Describe a change…" size="<%= CHAT.fieldSize %>" style="plain" onChange="editDraft" flexGrow="1" maxWidth="infinity" />
				<Button systemImage="mic" accessibilityLabel="Dictate" style="plain" />
				<Button id="send" systemImage="arrow.up" accessibilityLabel="Send" action="sendMessage" style="glassProminent" />
			</HStack>
		</GlassEffect>
	</VStack>
</SafeAreaInset>
