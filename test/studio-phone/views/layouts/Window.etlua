<%
  -- The project is the window: Habit Garden runs in its own tab bar, as it
  -- ships. Studio takes the one slot iOS 26 reserves above a tab bar, the
  -- bottom accessory where Music keeps its player, so the project keeps
  -- every point of its screen and every touch. The Today tab and the
  -- accessory are retained templates; the other tabs render once.
%>
<Window title="Lua Studio" width="402" height="874">
	<TabView id="app" selected="0" maxWidth="infinity" maxHeight="infinity">
		<Tab title="Today" systemImage="sun.max.fill">
			<VStack id="stage" maxWidth="infinity" maxHeight="infinity" />
		</Tab>
		<Tab title="Stats" systemImage="chart.bar.fill">
			<%- partial("../sections/Stats.etlua", app) %>
		</Tab>
		<Tab title="Settings" systemImage="gearshape.fill">
			<%- partial("../sections/Settings.etlua", app) %>
		</Tab>
		<TabAccessory>
			<VStack id="chrome" maxWidth="infinity" maxHeight="infinity" />
		</TabAccessory>
	</TabView>
</Window>
