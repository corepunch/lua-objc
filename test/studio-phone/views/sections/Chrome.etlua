<%
  -- The Studio capsule, in the tab bar accessory: the conversation folded
  -- to one line, as Music folds the player. The mark of the agent, what it
  -- last did, a microphone and Send; a tap anywhere on it unfolds the
  -- conversation as a sheet. The accessory supplies the glass, so the
  -- capsule draws nothing of its own.
  local CAPSULE = { insetLeading = 6, insetTrailing = 8, spacing = 10, avatar = 34, titleSize = 15, detailSize = 12 }
%>
<HStack id="capsule" tint="<%= tint %>" paddingLeading="<%= CAPSULE.insetLeading %>" paddingTrailing="<%= CAPSULE.insetTrailing %>" spacing="<%= CAPSULE.spacing %>" maxWidth="infinity" maxHeight="infinity" alignment="center" onTap="openChat" accessibilityLabel="<%= status.title %>. <%= status.detail %>">
	<%- partial("../../../../apps/studio/views/components/Avatar.etlua", { size = CAPSULE.avatar, colors = brand, icon = "sparkles", label = "Assistant" }) %>
	<VStack spacing="1" alignment="leading" flexGrow="1" flexShrink="1">
		<Label id="capsuleTitle" text="<%= status.title %>" size="<%= CAPSULE.titleSize %>" weight="semibold" lines="1" />
		<Label id="capsuleDetail" text="<%= status.detail %>" size="<%= CAPSULE.detailSize %>" color="secondary" lines="1" truncation="tail" />
	</VStack>
	<Button systemImage="mic" accessibilityLabel="Dictate" action="openChat" style="plain" />
	<Button id="openChat" systemImage="arrow.up" accessibilityLabel="Open conversation" action="openChat" style="glassProminent" />
</HStack>
