<%
  -- The source, pushed over the conversation: the file is the page title
  -- and the project tree is a menu in the bar, since a phone has no room
  -- for a sidebar beside the code.
%>
<Page title="<%= code.name %>" titleDisplayMode="inline">
	<Toolbar>
		<ToolbarItem id="files" placement="primaryAction">
			<Menu id="fileMenu" systemImage="folder" style="plain" accessibilityLabel="Project files">
				<% for _, file in ipairs(code.files) do %>
				<MenuItem title="<%= file %>" systemImage="<%= file:match("%.etlua$") and "chevron.left.forwardslash.chevron.right" or "doc.text" %>" checked="<%= tostring(file == code.name) %>" action="selectFile_<%= file %>" />
				<% end %>
			</Menu>
		</ToolbarItem>
	</Toolbar>
	<CodeView id="sourceCode" text="<%= code.text %>" language="<%= code.language %>" editable="true" syntaxRules="syntaxRules" wrapMode="true" maxWidth="infinity" maxHeight="infinity" />
</Page>
